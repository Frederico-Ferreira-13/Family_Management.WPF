<Application x:Class="Family_Management.WPF.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

             xmlns:views="clr-namespace:Family_Management.WPF.Views"

             xmlns:authentication="clr-namespace:Family_Management.WPF.ViewModel.Authentication"
             xmlns:accounts="clr-namespace:Family_Management.WPF.ViewModel.Accounts"
             xmlns:budgets="clr-namespace:Family_Management.WPF.ViewModel.Budgets"
             xmlns:categories="clr-namespace:Family_Management.WPF.ViewModel.Categories"
             xmlns:currencies="clr-namespace:Family_Management.WPF.ViewModel.Currencies"
             xmlns:dashboard="clr-namespace:Family_Management.WPF.ViewModel.Dashboard"
             xmlns:families="clr-namespace:Family_Management.WPF.ViewModel.Families"
             xmlns:goals="clr-namespace:Family_Management.WPF.ViewModel.Goals"
             xmlns:investments="clr-namespace:Family_Management.WPF.ViewModel.Investments"
             xmlns:recurringTransactions="clr-namespace:Family_Management.WPF.ViewModel.RecurringTransactions"
             xmlns:shell="clr-namespace:Family_Management.WPF.ViewModel.Shell"
             xmlns:transactions="clr-namespace:Family_Management.WPF.ViewModel.Transactions"
             xmlns:users="clr-namespace:Family_Management.WPF.ViewModel.Users"

             xmlns:converters="clr-namespace:Family_Management.WPF.Converters">

    <Application.Resources>
        <ResourceDictionary>

            <ResourceDictionary.MergedDictionaries>

                <!-- Material Design -->
                <ResourceDictionary
                    Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Light.xaml" />

                <ResourceDictionary
                    Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign2.Defaults.xaml" />

                <ResourceDictionary
                    Source="pack://application:,,,/MaterialDesignColors;component/Themes/MaterialDesignColor.Teal.xaml" />

                <ResourceDictionary
                    Source="pack://application:,,,/MaterialDesignColors;component/Themes/MaterialDesignColor.Lime.xaml" />

                <!-- Application styles -->
                <ResourceDictionary
                    Source="/Family_Management.WPF;component/Styles/Converters.xaml" />

                <ResourceDictionary
                    Source="/Family_Management.WPF;component/Styles/DesignResources.xaml" />

                <ResourceDictionary
                    Source="/Family_Management.WPF;component/Styles/Styles.ButtonsAndValidation.xaml" />

                <ResourceDictionary
                    Source="/Family_Management.WPF;component/Styles/Styles.TextAndValidation.xaml" />

                <ResourceDictionary
                    Source="/Family_Management.WPF;component/Styles/Styles.InteractiveControls.xaml" />

            </ResourceDictionary.MergedDictionaries>

            <!-- =================================================
                 CONVERTERS
                 ================================================= -->

            <converters:ValueToHeightConverter
                x:Key="ValueToHeightConverter" />

            <!-- =================================================
                 AUTHENTICATION
                 ================================================= -->

            <DataTemplate
                DataType="{x:Type authentication:LoginViewModel}">
                <views:LoginView />
            </DataTemplate>

            <DataTemplate
                DataType="{x:Type authentication:RegisterViewModel}">
                <views:RegisterView />
            </DataTemplate>

            <!-- =================================================
                 DASHBOARD
                 ================================================= -->

            <DataTemplate
                DataType="{x:Type dashboard:DashboardViewModel}">
                <views:DashboardView />
            </DataTemplate>

            <!-- =================================================
                 ACCOUNTS
                 ================================================= -->

            <DataTemplate
                DataType="{x:Type accounts:AccountViewModel}">
                <views:AccountView />
            </DataTemplate>

            <!-- =================================================
                 TRANSACTIONS
                 ================================================= -->

            <DataTemplate
                DataType="{x:Type transactions:TransactionViewModel}">
                <views:TransactionView />
            </DataTemplate>

            <DataTemplate
                DataType="{x:Type transactions:TransactionFormViewModel}">
                <views:TransactionFormView />
            </DataTemplate>

            <!-- =================================================
                 BUDGETS
                 ================================================= -->

            <DataTemplate
                DataType="{x:Type budgets:BudgetViewModel}">
                <views:BudgetView />
            </DataTemplate>

            <DataTemplate
                DataType="{x:Type budgets:BudgetFormViewModel}">
                <views:BudgetFormView />
            </DataTemplate>

            <!-- =================================================
                 GOALS
                 ================================================= -->

            <DataTemplate
                DataType="{x:Type goals:GoalViewModel}">
                <views:GoalView />
            </DataTemplate>            

            <!-- =================================================
                 CATEGORIES
                 ================================================= -->

            <DataTemplate
                DataType="{x:Type categories:CategoryViewModel}">
                <views:CategoryView />
            </DataTemplate>

            <!-- =================================================
                 FAMILIES
                 ================================================= -->

            <DataTemplate
                DataType="{x:Type families:FamilyViewModel}">
                <views:FamilyView />
            </DataTemplate>

            <DataTemplate
                DataType="{x:Type families:FamilySetupViewModel}">
                <views:FamilySetupView />
            </DataTemplate>

            <!-- =================================================
                 INVESTMENTS
                 ================================================= -->

            <DataTemplate
                DataType="{x:Type investments:InvestmentViewModel}">
                <views:InvestmentView />
            </DataTemplate>

            <DataTemplate
                DataType="{x:Type investments:InvestmentFormViewModel}">
                <views:InvestmentFormView />
            </DataTemplate>

            <!-- =================================================
                 RECURRING TRANSACTIONS
                 ================================================= -->

            <DataTemplate
                DataType="{x:Type recurringTransactions:RecurringTransactionViewModel}">
                <views:RecurringTransactionView />
            </DataTemplate>

            <!-- =================================================
                 USERS
                 ================================================= -->

            <DataTemplate
                DataType="{x:Type users:UserManagementViewModel}">
                <views:UserManagementView />
            </DataTemplate>

            <DataTemplate
                DataType="{x:Type users:UserEditViewModel}">
                <views:UserEditView />
            </DataTemplate>
            
            <!-- =================================================
                 CURRENCIES
                 ================================================= -->

            <DataTemplate
                DataType="{x:Type currencies:CurrencyViewModel}">
                <views:CurrencyView />
            </DataTemplate>

            <!-- =================================================
                 SHELL / GENERIC NAVIGATION
                 ================================================= -->

            <DataTemplate
                DataType="{x:Type shell:AddNewSelectionViewModel}">
                <views:AddNewSelectionView />
            </DataTemplate>

        </ResourceDictionary>
    </Application.Resources>

</Application>