
<Window
    x:Class="Family_Management.WPF.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:navigation="clr-namespace:Family_Management.WPF.Services.Navigation"
    Title="{Binding Title}"
    Height="800"
    Width="1280"
    MinHeight="650"
    MinWidth="950"
    WindowStartupLocation="CenterScreen"
    Background="#F5F7FB"
    FontFamily="Segoe UI">

    <Window.Resources>

        <!-- BOTÃO DE NAVEGAÇÃO -->

        <Style x:Key="ModernNavButton"
               TargetType="Button">

            <Setter Property="Background"
                    Value="Transparent" />

            <Setter Property="Foreground"
                    Value="#475569" />

            <Setter Property="BorderThickness"
                    Value="0" />

            <Setter Property="Height"
                    Value="42" />

            <Setter Property="Padding"
                    Value="15,0" />

            <Setter Property="HorizontalContentAlignment"
                    Value="Left" />

            <Setter Property="FontSize"
                    Value="13" />

            <Setter Property="FontWeight"
                    Value="Medium" />

            <Setter Property="Cursor"
                    Value="Hand" />

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border
                            x:Name="NavBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="9"
                            Padding="{TemplateBinding Padding}">

                            <ContentPresenter
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center" />

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter
                                    TargetName="NavBorder"
                                    Property="Background"
                                    Value="#EFF6FF" />

                                <Setter
                                    Property="Foreground"
                                    Value="#2563EB" />

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter
                                    TargetName="NavBorder"
                                    Property="Background"
                                    Value="#DBEAFE" />

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

        <!-- BOTÃO DESTAQUE -->

        <Style x:Key="ModernPrimaryButton"
               TargetType="Button">

            <Setter Property="Background"
                    Value="#2563EB" />

            <Setter Property="Foreground"
                    Value="White" />

            <Setter Property="BorderThickness"
                    Value="0" />

            <Setter Property="Height"
                    Value="44" />

            <Setter Property="FontSize"
                    Value="13" />

            <Setter Property="FontWeight"
                    Value="SemiBold" />

            <Setter Property="Cursor"
                    Value="Hand" />

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border
                            x:Name="PrimaryBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="9">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter
                                    TargetName="PrimaryBorder"
                                    Property="Background"
                                    Value="#1D4ED8" />

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

    </Window.Resources>

    <Grid>

        <Grid.ColumnDefinitions>

            <!-- MENU LATERAL -->

            <ColumnDefinition>

                <ColumnDefinition.Style>

                    <Style TargetType="ColumnDefinition">

                        <Setter Property="Width"
                                Value="0" />

                        <Style.Triggers>

                            <DataTrigger
                                Binding="{Binding IsLoggedIn}"
                                Value="True">

                                <Setter
                                    Property="Width"
                                    Value="245" />

                            </DataTrigger>

                        </Style.Triggers>

                    </Style>

                </ColumnDefinition.Style>

            </ColumnDefinition>

            <!-- CONTEÚDO -->

            <ColumnDefinition Width="*" />

        </Grid.ColumnDefinitions>

        <!-- MENU LATERAL -->

        <Border
            Grid.Column="0"
            Background="White"
            BorderBrush="#E5EAF2"
            BorderThickness="0,0,1,0">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- IDENTIFICAÇÃO -->

                <Border
                    Grid.Row="0"
                    Padding="20,24,20,20"
                    BorderBrush="#E5EAF2"
                    BorderThickness="0,0,0,1">

                    <StackPanel>

                        <TextBlock
                            Text="GESTÃO FAMILIAR"
                            FontSize="16"
                            FontWeight="Bold"
                            Foreground="#2563EB" />

                        <TextBlock
                            Text="{Binding CurrentUserName}"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="#172033"
                            Margin="0,14,0,0"
                            TextTrimming="CharacterEllipsis" />

                        <TextBlock
                            Text="Sessão iniciada"
                            FontSize="11"
                            Foreground="#94A3B8"
                            Margin="0,4,0,0" />

                    </StackPanel>

                </Border>

                <!-- NAVEGAÇÃO -->

                <ScrollViewer
                    Grid.Row="1"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">

                    <StackPanel Margin="14,18,14,18">

                        <TextBlock
                            Text="PRINCIPAL"
                            FontSize="10"
                            FontWeight="Bold"
                            Foreground="#94A3B8"
                            Margin="12,0,0,12" />

                        <Button
                            Content="⌂   Dashboard"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="{x:Static navigation:AppScreen.Dashboard}"
                            Style="{StaticResource ModernNavButton}"
                            Margin="0,0,0,5" />

                        <Button
                            Content="▦   Gestão Financeira"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="{x:Static navigation:AppScreen.UniversalFinance}"
                            Style="{StaticResource ModernNavButton}"
                            Margin="0,0,0,5" />

                        <TextBlock
                            Text="FINANÇAS"
                            FontSize="10"
                            FontWeight="Bold"
                            Foreground="#94A3B8"
                            Margin="12,20,0,12" />

                        <Button
                            Content="▣   Contas Bancárias"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="{x:Static navigation:AppScreen.Accounts}"
                            Style="{StaticResource ModernNavButton}"
                            Margin="0,0,0,5" />

                        <Button
                            Content="⇄   Movimentos"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="{x:Static navigation:AppScreen.Transactions}"
                            Style="{StaticResource ModernNavButton}"
                            Margin="0,0,0,5" />

                        <Button
                            Content="◷   Despesas Fixas"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="{x:Static navigation:AppScreen.RecurringTransaction}"
                            Style="{StaticResource ModernNavButton}"
                            Margin="0,0,0,5" />

                        <Button
                            Content="▤   Categorias"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="{x:Static navigation:AppScreen.Category}"
                            Style="{StaticResource ModernNavButton}"
                            Margin="0,0,0,5" />

                        <Button
                            Content="◕   Orçamentos"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="{x:Static navigation:AppScreen.Budget}"
                            Style="{StaticResource ModernNavButton}"
                            Margin="0,0,0,5" />

                        <Button
                            Content="◎   Objetivos"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="{x:Static navigation:AppScreen.Goal}"
                            Style="{StaticResource ModernNavButton}"
                            Margin="0,0,0,5" />

                        <Button
                            Content="▥   Investimentos"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="{x:Static navigation:AppScreen.Investment}"
                            Style="{StaticResource ModernNavButton}"
                            Margin="0,0,0,5" />

                        <TextBlock
                            Text="FAMÍLIA"
                            FontSize="10"
                            FontWeight="Bold"
                            Foreground="#94A3B8"
                            Margin="12,20,0,12" />

                        <Button
                            Content="♙   Agregado Familiar"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="{x:Static navigation:AppScreen.Family}"
                            Style="{StaticResource ModernNavButton}"
                            Margin="0,0,0,5" />

                        <Border
                            Height="1"
                            Background="#E5EAF2"
                            Margin="0,20,0,18" />

                        <Button
                            Content="+  Adicionar Novo"
                            Command="{Binding OpenAddMenuCommand}"
                            Style="{StaticResource ModernPrimaryButton}" />

                    </StackPanel>

                </ScrollViewer>

                <!-- RODAPÉ -->

                <Border
                    Grid.Row="2"
                    BorderBrush="#E5EAF2"
                    BorderThickness="0,1,0,0"
                    Padding="14,12,14,16">

                    <StackPanel>

                        <Button
                            Content="Terminar Sessão"
                            Command="{Binding LogoutCommand}"
                            Style="{StaticResource ModernNavButton}"
                            Foreground="#DC2626"
                            Margin="0,0,0,4" />

                        <Button
                            Content="Sair da Aplicação"
                            Command="{Binding ExitCommand}"
                            Style="{StaticResource ModernNavButton}" />

                    </StackPanel>

                </Border>

            </Grid>

        </Border>

        <!-- CONTEÚDO PRINCIPAL -->

        <ContentPresenter
            Grid.Column="1"
            Content="{Binding CurrentChildViewModel}" />

    </Grid>

</Window>
