
<Window
    x:Class="Family_Management.WPF.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:navigation="clr-namespace:Family_Management.WPF.Services.Navigation"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    Title="{Binding Title}"
    Width="1360"
    Height="840"
    MinWidth="950"
    MinHeight="650"
    WindowStartupLocation="CenterScreen"
    Background="{DynamicResource FM.Background.Brush}"
    FontFamily="Segoe UI"
    FontSize="14"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True">

    <Window.Resources>

        <!-- ==========================================
             BOTÕES DE NAVEGAÇÃO
             ========================================== -->

        <Style
            x:Key="FM.Shell.NavButton"
            TargetType="{x:Type Button}">

            <Setter Property="Height" Value="46" />
            <Setter Property="Margin" Value="0,3" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Background" Value="Transparent" />

            <Setter
                Property="Foreground"
                Value="{StaticResource FM.SidebarText.Brush}" />

            <Setter Property="BorderThickness" Value="0" />

            <Setter
                Property="HorizontalContentAlignment"
                Value="Stretch" />

            <Setter
                Property="VerticalContentAlignment"
                Value="Center" />

            <Setter Property="Cursor" Value="Hand" />

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="{x:Type Button}">

                        <Border
                            x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="10"
                            BorderBrush="Transparent"
                            BorderThickness="2"
                            Padding="{TemplateBinding Padding}">

                            <ContentPresenter
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                RecognizesAccessKey="True" />

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger
                                Property="IsMouseOver"
                                Value="True">

                                <Setter
                                    TargetName="ButtonBorder"
                                    Property="Background"
                                    Value="{StaticResource FM.SidebarHover.Brush}" />

                            </Trigger>

                            <Trigger
                                Property="IsKeyboardFocused"
                                Value="True">

                                <Setter
                                    TargetName="ButtonBorder"
                                    Property="BorderBrush"
                                    Value="#93C5FD" />

                            </Trigger>

                            <Trigger
                                Property="IsEnabled"
                                Value="False">

                                <Setter
                                    Property="Opacity"
                                    Value="0.45" />

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>

            <!-- Página selecionada -->
            <Style.Triggers>

                <DataTrigger Value="True">

                    <DataTrigger.Binding>

                        <MultiBinding
                            Converter="{StaticResource SelectedScreenConverter}">

                            <Binding
                                Path="DataContext.SelectedScreen"
                                RelativeSource="{RelativeSource AncestorType=Window}" />

                            <Binding
                                Path="CommandParameter"
                                RelativeSource="{RelativeSource Self}" />

                        </MultiBinding>

                    </DataTrigger.Binding>

                    <Setter
                        Property="Background"
                        Value="#365A8D" />

                    <Setter
                        Property="Foreground"
                        Value="White" />

                    <Setter
                        Property="FontWeight"
                        Value="SemiBold" />

                </DataTrigger>

            </Style.Triggers>

        </Style>

        <!-- ==========================================
             TEXTO NO MODO EXPANDIDO
             ========================================== -->

        <Style
            x:Key="FM.Shell.NavText"
            TargetType="{x:Type TextBlock}">

            <Setter Property="Margin" Value="14,0,0,0" />

            <Setter
                Property="VerticalAlignment"
                Value="Center" />

            <Setter
                Property="TextTrimming"
                Value="CharacterEllipsis" />

            <Style.Triggers>

                <DataTrigger
                    Binding="{Binding IsSidebarExpanded}"
                    Value="False">

                    <Setter
                        Property="Visibility"
                        Value="Collapsed" />

                </DataTrigger>

            </Style.Triggers>

        </Style>

        <!-- ==========================================
             TÍTULOS DAS SECÇÕES
             ========================================== -->

        <Style
            x:Key="FM.Shell.SectionLabel"
            TargetType="{x:Type TextBlock}">

            <Setter
                Property="Foreground"
                Value="#AFC4E2" />

            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="12,20,0,8" />

            <Style.Triggers>

                <DataTrigger
                    Binding="{Binding IsSidebarExpanded}"
                    Value="False">

                    <Setter
                        Property="Visibility"
                        Value="Collapsed" />

                </DataTrigger>

            </Style.Triggers>

        </Style>

        <!-- ==========================================
             ELEMENTOS VISÍVEIS APENAS EXPANDIDOS
             ========================================== -->

        <Style
            x:Key="FM.Shell.ExpandedOnly"
            TargetType="{x:Type StackPanel}">

            <Style.Triggers>

                <DataTrigger
                    Binding="{Binding IsSidebarExpanded}"
                    Value="False">

                    <Setter
                        Property="Visibility"
                        Value="Collapsed" />

                </DataTrigger>

            </Style.Triggers>

        </Style>

        <!-- ==========================================
             NOVO: BOTÃO DO PERFIL NO CABEÇALHO
             ========================================== -->

        <Style
            x:Key="FM.Shell.ProfileButton"
            TargetType="{x:Type Button}">

            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="{x:Type Button}">

                        <Border
                            x:Name="ProfileBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="12"
                            Padding="{TemplateBinding Padding}">

                            <ContentPresenter
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center" />

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger
                                Property="IsMouseOver"
                                Value="True">

                                <Setter
                                    TargetName="ProfileBorder"
                                    Property="Background"
                                    Value="{StaticResource FM.SurfaceAlt.Brush}" />

                            </Trigger>

                            <Trigger
                                Property="IsKeyboardFocused"
                                Value="True">

                                <Setter
                                    TargetName="ProfileBorder"
                                    Property="Background"
                                    Value="{StaticResource FM.SurfaceAlt.Brush}" />

                            </Trigger>

                            <Trigger
                                Property="IsEnabled"
                                Value="False">

                                <Setter
                                    Property="Opacity"
                                    Value="0.5" />

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>

        </Style>

    </Window.Resources>

    <!-- ==========================================
         ESTRUTURA PRINCIPAL
         ========================================== -->

    <Grid>

        <Grid.ColumnDefinitions>

            <!-- Sidebar dinâmica -->
            <ColumnDefinition>

                <ColumnDefinition.Style>

                    <Style
                        TargetType="{x:Type ColumnDefinition}">

                        <Setter Property="Width" Value="0" />

                        <Style.Triggers>

                            <!-- Expandida -->
                            <MultiDataTrigger>

                                <MultiDataTrigger.Conditions>

                                    <Condition
                                        Binding="{Binding IsLoggedIn}"
                                        Value="True" />

                                    <Condition
                                        Binding="{Binding IsSidebarExpanded}"
                                        Value="True" />

                                </MultiDataTrigger.Conditions>

                                <Setter
                                    Property="Width"
                                    Value="232" />

                            </MultiDataTrigger>

                            <!-- Recolhida -->
                            <MultiDataTrigger>

                                <MultiDataTrigger.Conditions>

                                    <Condition
                                        Binding="{Binding IsLoggedIn}"
                                        Value="True" />

                                    <Condition
                                        Binding="{Binding IsSidebarExpanded}"
                                        Value="False" />

                                </MultiDataTrigger.Conditions>

                                <Setter
                                    Property="Width"
                                    Value="68" />

                            </MultiDataTrigger>

                        </Style.Triggers>

                    </Style>

                </ColumnDefinition.Style>

            </ColumnDefinition>

            <ColumnDefinition Width="*" />

        </Grid.ColumnDefinitions>

        <!-- ==========================================
             SIDEBAR
             ========================================== -->

        <Border
            Grid.Column="0"
            Background="{StaticResource FM.Sidebar.Brush}">

            <Border.Style>

                <Style TargetType="{x:Type Border}">

                    <Setter
                        Property="Visibility"
                        Value="Collapsed" />

                    <Style.Triggers>

                        <DataTrigger
                            Binding="{Binding IsLoggedIn}"
                            Value="True">

                            <Setter
                                Property="Visibility"
                                Value="Visible" />

                        </DataTrigger>

                    </Style.Triggers>

                </Style>

            </Border.Style>

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- =====================================
                     IDENTIDADE
                     ===================================== -->

                <Border
                    Grid.Row="0"
                    Padding="12,20"
                    BorderBrush="#355071"
                    BorderThickness="0,0,0,1">

                    <StackPanel
                        Orientation="Horizontal"
                        VerticalAlignment="Center">

                        <Border
                            Width="44"
                            Height="44"
                            Background="{StaticResource FM.Accent.Brush}"
                            CornerRadius="12">

                            <materialDesign:PackIcon
                                Kind="HomeOutline"
                                Width="25"
                                Height="25"
                                Foreground="White"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />

                        </Border>

                        <StackPanel
                            Style="{StaticResource FM.Shell.ExpandedOnly}"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center">

                            <TextBlock
                                Text="FAMILY"
                                Foreground="White"
                                FontSize="15"
                                FontWeight="Bold" />

                            <TextBlock
                                Text="MANAGEMENT"
                                Foreground="#B6CAE4"
                                FontSize="10" />

                        </StackPanel>

                    </StackPanel>

                </Border>

                <!-- =====================================
                     NAVEGAÇÃO PRINCIPAL
                     ===================================== -->

                <ScrollViewer
                    Grid.Row="1"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled"
                    Focusable="False">

                    <StackPanel Margin="8,8,8,16">

                        <TextBlock
                            Text="PRINCIPAL"
                            Style="{StaticResource FM.Shell.SectionLabel}" />

                        <!-- VISÃO GERAL -->
                        <Button
                            Command="{Binding NavigateCommand}"
                            CommandParameter="{x:Static navigation:AppScreen.Dashboard}"
                            Style="{StaticResource FM.Shell.NavButton}"
                            ToolTip="Visão Geral">

                            <StackPanel Orientation="Horizontal">

                                <materialDesign:PackIcon
                                    Kind="ViewDashboardOutline"
                                    Width="20"
                                    Height="20" />

                                <TextBlock
                                    Text="Visão Geral"
                                    Style="{StaticResource FM.Shell.NavText}" />

                            </StackPanel>

                        </Button>

                        <!-- GESTÃO FINANCEIRA -->
                        <Button
                            Command="{Binding NavigateCommand}"
                            CommandParameter="{x:Static navigation:AppScreen.UniversalFinance}"
                            Style="{StaticResource FM.Shell.NavButton}"
                            ToolTip="Gestão Financeira">

                            <StackPanel Orientation="Horizontal">

                                <materialDesign:PackIcon
                                    Kind="Finance"
                                    Width="20"
                                    Height="20" />

                                <TextBlock
                                    Text="Gestão Financeira"
                                    Style="{StaticResource FM.Shell.NavText}" />

                            </StackPanel>

                        </Button>

                        <!-- TRANSAÇÕES -->
                        <Button
                            Command="{Binding NavigateCommand}"
                            CommandParameter="{x:Static navigation:AppScreen.Transactions}"
                            Style="{StaticResource FM.Shell.NavButton}"
                            ToolTip="Transações">

                            <StackPanel Orientation="Horizontal">

                                <materialDesign:PackIcon
                                    Kind="SwapHorizontal"
                                    Width="20"
                                    Height="20" />

                                <TextBlock
                                    Text="Transações"
                                    Style="{StaticResource FM.Shell.NavText}" />

                            </StackPanel>

                        </Button>

                        <!-- RECORRÊNCIAS -->
                        <Button
                            Command="{Binding NavigateCommand}"
                            CommandParameter="{x:Static navigation:AppScreen.RecurringTransaction}"
                            Style="{StaticResource FM.Shell.NavButton}"
                            ToolTip="Receitas e Despesas Recorrentes">

                            <StackPanel Orientation="Horizontal">

                                <materialDesign:PackIcon
                                    Kind="CalendarSync"
                                    Width="20"
                                    Height="20" />

                                <TextBlock
                                    Text="Recorrências"
                                    Style="{StaticResource FM.Shell.NavText}" />

                            </StackPanel>

                        </Button>

                        <!-- INVESTIMENTOS -->
                        <Button
                            Command="{Binding NavigateCommand}"
                            CommandParameter="{x:Static navigation:AppScreen.Investment}"
                            Style="{StaticResource FM.Shell.NavButton}"
                            ToolTip="Investimentos">

                            <StackPanel Orientation="Horizontal">

                                <materialDesign:PackIcon
                                    Kind="ChartLine"
                                    Width="20"
                                    Height="20" />

                                <TextBlock
                                    Text="Investimentos"
                                    Style="{StaticResource FM.Shell.NavText}" />

                            </StackPanel>

                        </Button>

                        <!-- =====================================
                             AÇÕES RÁPIDAS
                             ===================================== -->

                        <Button
                            Command="{Binding OpenAddMenuCommand}"
                            Style="{StaticResource FM.Shell.NavButton}"
                            Background="#2563EB"
                            Margin="0,24,0,8"
                            ToolTip="Adicionar novo registo">

                            <StackPanel Orientation="Horizontal">

                                <materialDesign:PackIcon
                                    Kind="Plus"
                                    Width="20"
                                    Height="20" />

                                <TextBlock
                                    Text="Adicionar Novo"
                                    Style="{StaticResource FM.Shell.NavText}" />

                            </StackPanel>

                        </Button>

                    </StackPanel>

                </ScrollViewer>

                <!-- =====================================
                     UTILIZADOR E SESSÃO
                     ===================================== -->

                <Border
                    Grid.Row="2"
                    Padding="8,12"
                    BorderBrush="#355071"
                    BorderThickness="0,1,0,0">

                    <StackPanel>

                        <!-- =====================================
                             NOVO: PERFIL CLICÁVEL NA SIDEBAR
                             ===================================== -->

                        <Button
                            Command="{Binding OpenUserManagementCommand}"
                            Style="{StaticResource FM.Shell.NavButton}"
                            Height="58"
                            Margin="0,0,0,8"
                            Padding="6,0"
                            ToolTip="Gerir utilizadores e agregado familiar">

                            <StackPanel
                                Orientation="Horizontal"
                                VerticalAlignment="Center">

                                <Border
                                    Width="40"
                                    Height="40"
                                    CornerRadius="20"
                                    Background="#30476A">

                                    <materialDesign:PackIcon
                                        Kind="AccountOutline"
                                        Width="22"
                                        Height="22"
                                        Foreground="White"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center" />

                                </Border>

                                <StackPanel
                                    Style="{StaticResource FM.Shell.ExpandedOnly}"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center">

                                    <TextBlock
                                        Text="{Binding CurrentUserName}"
                                        Foreground="White"
                                        FontWeight="SemiBold"
                                        FontSize="12"
                                        MaxWidth="145"
                                        TextTrimming="CharacterEllipsis" />

                                    <TextBlock
                                        Text="Gerir utilizadores"
                                        Foreground="#B6CAE4"
                                        FontSize="10" />

                                </StackPanel>

                            </StackPanel>

                        </Button>

                        <!-- Terminar sessão -->
                        <Button
                            Command="{Binding LogoutCommand}"
                            Style="{StaticResource FM.Shell.NavButton}"
                            ToolTip="Terminar sessão">

                            <StackPanel Orientation="Horizontal">

                                <materialDesign:PackIcon
                                    Kind="Logout"
                                    Width="20"
                                    Height="20" />

                                <TextBlock
                                    Text="Terminar Sessão"
                                    Style="{StaticResource FM.Shell.NavText}" />

                            </StackPanel>

                        </Button>

                        <!-- Sair -->
                        <Button
                            Command="{Binding ExitCommand}"
                            Style="{StaticResource FM.Shell.NavButton}"
                            ToolTip="Sair da aplicação">

                            <StackPanel Orientation="Horizontal">

                                <materialDesign:PackIcon
                                    Kind="Power"
                                    Width="20"
                                    Height="20" />

                                <TextBlock
                                    Text="Sair da Aplicação"
                                    Style="{StaticResource FM.Shell.NavText}" />

                            </StackPanel>

                        </Button>

                    </StackPanel>

                </Border>

            </Grid>

        </Border>

        <!-- ==========================================
             CONTEÚDO PRINCIPAL
             ========================================== -->

        <Grid Grid.Column="1">

            <Grid.RowDefinitions>

                <!-- Cabeçalho -->
                <RowDefinition>

                    <RowDefinition.Style>

                        <Style
                            TargetType="{x:Type RowDefinition}">

                            <Setter
                                Property="Height"
                                Value="0" />

                            <Style.Triggers>

                                <DataTrigger
                                    Binding="{Binding IsLoggedIn}"
                                    Value="True">

                                    <Setter
                                        Property="Height"
                                        Value="76" />

                                </DataTrigger>

                            </Style.Triggers>

                        </Style>

                    </RowDefinition.Style>

                </RowDefinition>

                <!-- Conteúdo -->
                <RowDefinition Height="*" />

            </Grid.RowDefinitions>

            <!-- =====================================
                 CABEÇALHO
                 ===================================== -->

            <Border
                Grid.Row="0"
                Background="{StaticResource FM.Surface.Brush}"
                BorderBrush="{StaticResource FM.Border.Brush}"
                BorderThickness="0,0,0,1">

                <Border.Style>

                    <Style TargetType="{x:Type Border}">

                        <Setter
                            Property="Visibility"
                            Value="Collapsed" />

                        <Style.Triggers>

                            <DataTrigger
                                Binding="{Binding IsLoggedIn}"
                                Value="True">

                                <Setter
                                    Property="Visibility"
                                    Value="Visible" />

                            </DataTrigger>

                        </Style.Triggers>

                    </Style>

                </Border.Style>

                <Grid Margin="18,0,26,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Expandir / recolher sidebar -->
                    <Button
                        Grid.Column="0"
                        Command="{Binding ToggleSidebarCommand}"
                        Width="42"
                        Height="42"
                        Margin="0,0,18,0"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        ToolTip="Expandir ou recolher o menu"
                        VerticalAlignment="Center">

                        <materialDesign:PackIcon
                            Kind="Menu"
                            Width="24"
                            Height="24"
                            Foreground="{StaticResource FM.TextPrimary.Brush}" />

                    </Button>

                    <!-- Título -->
                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center">

                        <TextBlock
                            Text="FAMILY MANAGEMENT"
                            FontSize="10"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource FM.TextMuted.Brush}" />

                        <TextBlock
                            Text="{Binding CurrentPageTitle}"
                            FontSize="22"
                            FontWeight="SemiBold"
                            TextTrimming="CharacterEllipsis"
                            Foreground="{StaticResource FM.TextPrimary.Brush}"
                            Margin="0,3,0,0" />

                    </StackPanel>

                    <!-- =====================================
                         NOVO: PERFIL CLICÁVEL NO CABEÇALHO
                         ===================================== -->

                    <Button
                        Grid.Column="2"
                        Command="{Binding OpenUserManagementCommand}"
                        Style="{StaticResource FM.Shell.ProfileButton}"
                        ToolTip="Abrir gestão de utilizadores">

                        <StackPanel
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                            <TextBlock
                                Text="{Binding CurrentUserName}"
                                Foreground="{StaticResource FM.TextSecondary.Brush}"
                                FontSize="13"
                                VerticalAlignment="Center"
                                MaxWidth="180"
                                TextTrimming="CharacterEllipsis" />

                            <Border
                                Width="38"
                                Height="38"
                                Margin="14,0,0,0"
                                CornerRadius="19"
                                Background="{StaticResource FM.SurfaceAlt.Brush}"
                                BorderBrush="{StaticResource FM.Border.Brush}"
                                BorderThickness="1">

                                <materialDesign:PackIcon
                                    Kind="AccountCircleOutline"
                                    Width="24"
                                    Height="24"
                                    Foreground="{StaticResource FM.TextSecondary.Brush}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />

                            </Border>

                            <materialDesign:PackIcon
                                Kind="ChevronDown"
                                Width="18"
                                Height="18"
                                Margin="8,0,0,0"
                                Foreground="{StaticResource FM.TextSecondary.Brush}"
                                VerticalAlignment="Center" />

                        </StackPanel>

                    </Button>

                </Grid>

            </Border>

            <!-- =====================================
                 VIEW ATUAL
                 ===================================== -->

            <ContentControl
                Grid.Row="1"
                Content="{Binding CurrentChildViewModel}"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch" />

        </Grid>

    </Grid>

</Window>
