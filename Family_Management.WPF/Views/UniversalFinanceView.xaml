
<UserControl
    x:Class="Family_Management.WPF.Views.UniversalFinanceView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#F5F7FB"
    FontFamily="Segoe UI">

    <UserControl.Resources>

        <!-- PALETA -->

        <SolidColorBrush
            x:Key="FinancePrimary"
            Color="#2563EB" />

        <SolidColorBrush
            x:Key="FinanceDark"
            Color="#172033" />

        <SolidColorBrush
            x:Key="FinanceMuted"
            Color="#64748B" />

        <SolidColorBrush
            x:Key="FinanceBorder"
            Color="#E5EAF2" />

        <!-- BOTÃO PRINCIPAL -->

        <Style
            x:Key="FinancePrimaryButton"
            TargetType="Button">

            <Setter Property="Foreground"
                    Value="White" />
            <Setter Property="Background"
                    Value="{StaticResource FinancePrimary}" />
            <Setter Property="BorderThickness"
                    Value="0" />
            <Setter Property="Padding"
                    Value="18,11" />
            <Setter Property="FontSize"
                    Value="13" />
            <Setter Property="FontWeight"
                    Value="SemiBold" />
            <Setter Property="Cursor"
                    Value="Hand" />
            <Setter Property="MinHeight"
                    Value="40" />

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">

                        <Border
                            x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                RecognizesAccessKey="True" />

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger
                                Property="IsMouseOver"
                                Value="True">

                                <Setter
                                    TargetName="ButtonBorder"
                                    Property="Background"
                                    Value="#1D4ED8" />

                            </Trigger>

                            <Trigger
                                Property="IsPressed"
                                Value="True">

                                <Setter
                                    TargetName="ButtonBorder"
                                    Property="Background"
                                    Value="#1E40AF" />

                            </Trigger>

                            <Trigger
                                Property="IsEnabled"
                                Value="False">

                                <Setter
                                    TargetName="ButtonBorder"
                                    Property="Opacity"
                                    Value="0.45" />

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>

        </Style>

        <!-- BOTÃO SECUNDÁRIO -->

        <Style
            x:Key="FinanceSecondaryButton"
            TargetType="Button"
            BasedOn="{StaticResource FinancePrimaryButton}">

            <Setter Property="Foreground"
                    Value="#334155" />
            <Setter Property="Background"
                    Value="#F1F5F9" />

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">

                        <Border
                            x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger
                                Property="IsMouseOver"
                                Value="True">

                                <Setter
                                    TargetName="ButtonBorder"
                                    Property="Background"
                                    Value="#E2E8F0" />

                            </Trigger>

                            <Trigger
                                Property="IsPressed"
                                Value="True">

                                <Setter
                                    TargetName="ButtonBorder"
                                    Property="Background"
                                    Value="#CBD5E1" />

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>

        </Style>

        <!-- SELETOR DE CONTEXTO -->

        <Style
            x:Key="FinanceScopeButton"
            TargetType="Button">

            <Setter Property="MinWidth"
                    Value="130" />
            <Setter Property="Height"
                    Value="42" />
            <Setter Property="Padding"
                    Value="20,8" />
            <Setter Property="Margin"
                    Value="0,0,8,0" />
            <Setter Property="Background"
                    Value="#F1F5F9" />
            <Setter Property="Foreground"
                    Value="#475569" />
            <Setter Property="FontSize"
                    Value="13" />
            <Setter Property="FontWeight"
                    Value="SemiBold" />
            <Setter Property="Cursor"
                    Value="Hand" />
            <Setter Property="BorderThickness"
                    Value="0" />

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">

                        <Border
                            x:Name="ScopeBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger
                                Property="IsMouseOver"
                                Value="True">

                                <Setter
                                    TargetName="ScopeBorder"
                                    Property="Opacity"
                                    Value="0.85" />

                            </Trigger>

                            <Trigger
                                Property="IsEnabled"
                                Value="False">

                                <Setter
                                    TargetName="ScopeBorder"
                                    Property="Opacity"
                                    Value="0.4" />

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>

        </Style>

        <!-- CARTÃO DOS MÓDULOS -->

        <Style
            x:Key="FinanceCard"
            TargetType="Border">

            <Setter Property="Background"
                    Value="White" />
            <Setter Property="CornerRadius"
                    Value="14" />
            <Setter Property="Padding"
                    Value="24" />
            <Setter Property="BorderBrush"
                    Value="{StaticResource FinanceBorder}" />
            <Setter Property="BorderThickness"
                    Value="1" />
            <Setter Property="MinHeight"
                    Value="205" />

        </Style>

        <!-- CARTÃO DE INDICADOR FINANCEIRO -->

        <Style
            x:Key="FinanceSummaryCard"
            TargetType="Border">

            <Setter Property="Background"
                    Value="#F8FAFC" />
            <Setter Property="CornerRadius"
                    Value="10" />
            <Setter Property="Padding"
                    Value="18" />
            <Setter Property="BorderBrush"
                    Value="{StaticResource FinanceBorder}" />
            <Setter Property="BorderThickness"
                    Value="1" />

        </Style>

    </UserControl.Resources>

    <ScrollViewer
        VerticalScrollBarVisibility="Auto"
        HorizontalScrollBarVisibility="Disabled">

        <Grid
            Margin="30,28,30,30"
            MaxWidth="1250"
            HorizontalAlignment="Stretch">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- CABEÇALHO -->

            <Grid
                Grid.Row="0"
                Margin="0,0,0,24">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>

                    <TextBlock
                        Text="Gestão Financeira"
                        FontSize="29"
                        FontWeight="Bold"
                        Foreground="{StaticResource FinanceDark}" />

                    <TextBlock
                        Text="As tuas finanças, organizadas num só lugar."
                        FontSize="14"
                        Margin="0,7,0,0"
                        Foreground="{StaticResource FinanceMuted}" />

                </StackPanel>

                <Button
                    Grid.Column="1"
                    Content="↻  Atualizar"
                    Command="{Binding RefreshCommand}"
                    Style="{StaticResource FinanceSecondaryButton}"
                    VerticalAlignment="Center" />

            </Grid>

            <!-- CONTEXTO FINANCEIRO -->

            <Border
                Grid.Row="1"
                Background="White"
                CornerRadius="14"
                BorderBrush="{StaticResource FinanceBorder}"
                BorderThickness="1"
                Padding="24"
                Margin="0,0,0,28">

                <StackPanel>

                    <TextBlock
                        Text="Contexto financeiro"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource FinanceDark}" />

                    <TextBlock
                        Text="Escolhe as finanças que pretendes consultar."
                        Margin="0,6,0,18"
                        FontSize="13"
                        Foreground="{StaticResource FinanceMuted}" />

                    <StackPanel
                        Orientation="Horizontal"
                        Margin="0,0,0,15">

                        <!-- PESSOAL -->

                        <Button
                            Content="Pessoal"
                            Command="{Binding SelectPersonalCommand}">

                            <Button.Style>
                                <Style
                                    TargetType="Button"
                                    BasedOn="{StaticResource FinanceScopeButton}">

                                    <Style.Triggers>

                                        <DataTrigger
                                            Binding="{Binding IsPersonalScope}"
                                            Value="True">

                                            <Setter
                                                Property="Background"
                                                Value="#2563EB" />

                                            <Setter
                                                Property="Foreground"
                                                Value="White" />

                                        </DataTrigger>

                                    </Style.Triggers>

                                </Style>
                            </Button.Style>

                        </Button>

                        <!-- FAMILIAR -->

                        <Button
                            Content="Familiar"
                            Command="{Binding SelectFamilyCommand}"
                            IsEnabled="{Binding CanUseFamilyScope}">

                            <Button.Style>
                                <Style
                                    TargetType="Button"
                                    BasedOn="{StaticResource FinanceScopeButton}">

                                    <Style.Triggers>

                                        <DataTrigger
                                            Binding="{Binding IsFamilyScope}"
                                            Value="True">

                                            <Setter
                                                Property="Background"
                                                Value="#2563EB" />

                                            <Setter
                                                Property="Foreground"
                                                Value="White" />

                                        </DataTrigger>

                                    </Style.Triggers>

                                </Style>
                            </Button.Style>

                        </Button>

                    </StackPanel>

                    <TextBlock
                        Text="{Binding ContextDescription}"
                        TextWrapping="Wrap"
                        Foreground="{StaticResource FinanceMuted}"
                        FontSize="13" />

                    <Border
                        Background="#EFF6FF"
                        CornerRadius="7"
                        Padding="12,8"
                        HorizontalAlignment="Left"
                        Margin="0,16,0,0">

                        <TextBlock
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="#1D4ED8">

                            <TextBlock.Style>
                                <Style TargetType="TextBlock">

                                    <Setter
                                        Property="Text"
                                        Value="●  Contexto ativo: Pessoal" />

                                    <Style.Triggers>

                                        <DataTrigger
                                            Binding="{Binding IsFamilyScope}"
                                            Value="True">

                                            <Setter
                                                Property="Text"
                                                Value="●  Contexto ativo: Familiar" />

                                        </DataTrigger>

                                    </Style.Triggers>

                                </Style>
                            </TextBlock.Style>

                        </TextBlock>

                    </Border>

                </StackPanel>

            </Border>

            <!-- PLANO FINANCEIRO FAMILIAR -->

            <Border
                Grid.Row="2"
                Background="White"
                CornerRadius="14"
                BorderBrush="{StaticResource FinanceBorder}"
                BorderThickness="1"
                Padding="24"
                Margin="0,0,0,28">

                <Border.Style>
                    <Style TargetType="Border">

                        <Setter
                            Property="Visibility"
                            Value="Collapsed" />

                        <Style.Triggers>

                            <DataTrigger
                                Binding="{Binding IsFamilyScope}"
                                Value="True">

                                <Setter
                                    Property="Visibility"
                                    Value="Visible" />

                            </DataTrigger>

                        </Style.Triggers>

                    </Style>
                </Border.Style>

                <StackPanel>

                    <TextBlock
                        Text="Plano financeiro familiar"
                        FontSize="20"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource FinanceDark}" />

                    <TextBlock
                        Text="Resumo das receitas e despesas confirmadas da família."
                        FontSize="13"
                        Margin="0,7,0,0"
                        Foreground="{StaticResource FinanceMuted}"
                        TextWrapping="Wrap" />

                    <!-- ESTADO DE CARREGAMENTO -->

                    <StackPanel
                        Orientation="Horizontal"
                        Margin="0,18,0,0">

                        <StackPanel.Style>
                            <Style TargetType="StackPanel">

                                <Setter
                                    Property="Visibility"
                                    Value="Collapsed" />

                                <Style.Triggers>

                                    <DataTrigger
                                        Binding="{Binding IsFinancialPlanLoading}"
                                        Value="True">

                                        <Setter
                                            Property="Visibility"
                                            Value="Visible" />

                                    </DataTrigger>

                                </Style.Triggers>

                            </Style>
                        </StackPanel.Style>

                        <ProgressBar
                            Width="100"
                            Height="5"
                            IsIndeterminate="True"
                            VerticalAlignment="Center"
                            Margin="0,0,14,0" />

                        <TextBlock
                            Text="A carregar..."
                            FontSize="13"
                            Foreground="{StaticResource FinanceMuted}"
                            VerticalAlignment="Center" />

                    </StackPanel>

                    <!-- MENSAGEM DE ESTADO -->

                    <TextBlock
                        Text="{Binding FinancialPlanStatus}"
                        FontSize="13"
                        Margin="0,14,0,0"
                        Foreground="{StaticResource FinanceMuted}"
                        TextWrapping="Wrap">

                        <TextBlock.Style>
                            <Style TargetType="TextBlock">

                                <Setter
                                    Property="Visibility"
                                    Value="Visible" />

                                <Style.Triggers>

                                    <Trigger
                                        Property="Text"
                                        Value="">

                                        <Setter
                                            Property="Visibility"
                                            Value="Collapsed" />

                                    </Trigger>

                                </Style.Triggers>

                            </Style>
                        </TextBlock.Style>

                    </TextBlock>

                    <!-- RESUMO DISPONÍVEL -->

                    <StackPanel Margin="0,20,0,0">

                        <StackPanel.Style>
                            <Style TargetType="StackPanel">

                                <Setter
                                    Property="Visibility"
                                    Value="Collapsed" />

                                <Style.Triggers>

                                    <DataTrigger
                                        Binding="{Binding HasFinancialPlanSummary}"
                                        Value="True">

                                        <Setter
                                            Property="Visibility"
                                            Value="Visible" />

                                    </DataTrigger>

                                </Style.Triggers>

                            </Style>
                        </StackPanel.Style>

                        <!-- IDENTIFICAÇÃO DO PLANO -->

                        <Grid Margin="0,0,0,18">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                Grid.Column="0"
                                Text="{Binding FinancialPlanName}"
                                FontSize="17"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource FinanceDark}"
                                VerticalAlignment="Center" />

                            <Border
                                Grid.Column="1"
                                Background="#EFF6FF"
                                CornerRadius="7"
                                Padding="12,7">

                                <TextBlock
                                    Text="{Binding FinancialPlanCurrency}"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="#1D4ED8" />

                            </Border>

                        </Grid>

                        <!-- INDICADORES -->

                        <UniformGrid Columns="3">

                            <!-- RECEITAS -->

                            <Border
                                Style="{StaticResource FinanceSummaryCard}"
                                Margin="0,0,10,0">

                                <StackPanel>

                                    <TextBlock
                                        Text="Receitas reais"
                                        FontSize="13"
                                        Foreground="{StaticResource FinanceMuted}" />

                                    <TextBlock
                                        Text="{Binding TotalIncome, StringFormat={}{0:N2}}"
                                        FontSize="23"
                                        FontWeight="Bold"
                                        Foreground="#16A34A"
                                        Margin="0,10,0,0" />

                                    <TextBlock
                                        Text="Receitas confirmadas"
                                        FontSize="12"
                                        Foreground="{StaticResource FinanceMuted}"
                                        Margin="0,8,0,0" />

                                </StackPanel>

                            </Border>

                            <!-- DESPESAS -->

                            <Border
                                Style="{StaticResource FinanceSummaryCard}"
                                Margin="5,0,5,0">

                                <StackPanel>

                                    <TextBlock
                                        Text="Despesas reais"
                                        FontSize="13"
                                        Foreground="{StaticResource FinanceMuted}" />

                                    <TextBlock
                                        Text="{Binding TotalExpenses, StringFormat={}{0:N2}}"
                                        FontSize="23"
                                        FontWeight="Bold"
                                        Foreground="#DC2626"
                                        Margin="0,10,0,0" />

                                    <TextBlock
                                        Text="Despesas confirmadas"
                                        FontSize="12"
                                        Foreground="{StaticResource FinanceMuted}"
                                        Margin="0,8,0,0" />

                                </StackPanel>

                            </Border>

                            <!-- RESULTADO -->

                            <Border
                                Style="{StaticResource FinanceSummaryCard}"
                                Margin="10,0,0,0">

                                <StackPanel>

                                    <TextBlock
                                        Text="Resultado financeiro"
                                        FontSize="13"
                                        Foreground="{StaticResource FinanceMuted}" />

                                    <TextBlock
                                        Text="{Binding FinancialResult, StringFormat={}{0:N2}}"
                                        FontSize="23"
                                        FontWeight="Bold"
                                        Foreground="{StaticResource FinanceDark}"
                                        Margin="0,10,0,0" />

                                    <TextBlock
                                        Text="Receitas − despesas"
                                        FontSize="12"
                                        Foreground="{StaticResource FinanceMuted}"
                                        Margin="0,8,0,0" />

                                </StackPanel>

                            </Border>

                        </UniformGrid>

                        <!-- NOTA INFORMATIVA -->

                        <TextBlock
                            Text="O resultado financeiro representa o valor agregado do plano e não o saldo de uma conta bancária."
                            FontSize="12"
                            FontStyle="Italic"
                            Foreground="{StaticResource FinanceMuted}"
                            TextWrapping="Wrap"
                            Margin="0,18,0,0" />

                    </StackPanel>

                </StackPanel>

            </Border>

            <!-- TÍTULO DOS MÓDULOS -->

            <Grid
                Grid.Row="3"
                Margin="0,0,0,16">

                <TextBlock
                    Text="Módulos financeiros"
                    FontSize="20"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource FinanceDark}" />

            </Grid>

            <!-- GRELHA DE MÓDULOS -->

            <UniformGrid
                Grid.Row="4"
                Columns="2">

                <!-- CONTAS -->

                <Border
                    Style="{StaticResource FinanceCard}"
                    Margin="0,0,10,16">

                    <StackPanel>

                        <Border
                            Background="#EFF6FF"
                            CornerRadius="10"
                            Width="48"
                            Height="48"
                            HorizontalAlignment="Left"
                            Margin="0,0,0,16">

                            <TextBlock
                                Text="▣"
                                FontSize="25"
                                Foreground="#2563EB"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />

                        </Border>

                        <TextBlock
                            Text="Contas"
                            FontSize="18"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource FinanceDark}" />

                        <TextBlock
                            Text="Consulta as tuas contas e acompanha os saldos."
                            Foreground="{StaticResource FinanceMuted}"
                            TextWrapping="Wrap"
                            Margin="0,8,0,18"
                            FontSize="13" />

                        <Button
                            Content="Abrir contas  →"
                            Command="{Binding OpenAccountsCommand}"
                            Style="{StaticResource FinancePrimaryButton}"
                            HorizontalAlignment="Left" />

                    </StackPanel>

                </Border>

                <!-- TRANSAÇÕES -->

                <Border
                    Style="{StaticResource FinanceCard}"
                    Margin="10,0,0,16">

                    <StackPanel>

                        <Border
                            Background="#F0FDF4"
                            CornerRadius="10"
                            Width="48"
                            Height="48"
                            HorizontalAlignment="Left"
                            Margin="0,0,0,16">

                            <TextBlock
                                Text="⇄"
                                FontSize="27"
                                Foreground="#16A34A"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />

                        </Border>

                        <TextBlock
                            Text="Transações"
                            FontSize="18"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource FinanceDark}" />

                        <TextBlock
                            Text="Gere receitas, despesas e transferências."
                            Foreground="{StaticResource FinanceMuted}"
                            TextWrapping="Wrap"
                            Margin="0,8,0,18"
                            FontSize="13" />

                        <Button
                            Content="Abrir transações  →"
                            Command="{Binding OpenTransactionsCommand}"
                            Style="{StaticResource FinancePrimaryButton}"
                            HorizontalAlignment="Left" />

                    </StackPanel>

                </Border>

                <!-- ORÇAMENTOS -->

                <Border
                    Style="{StaticResource FinanceCard}"
                    Margin="0,0,10,16">

                    <StackPanel>

                        <Border
                            Background="#FFF7ED"
                            CornerRadius="10"
                            Width="48"
                            Height="48"
                            HorizontalAlignment="Left"
                            Margin="0,0,0,16">

                            <TextBlock
                                Text="◕"
                                FontSize="27"
                                Foreground="#EA580C"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />

                        </Border>

                        <TextBlock
                            Text="Orçamentos"
                            FontSize="18"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource FinanceDark}" />

                        <TextBlock
                            Text="Controla os limites e acompanha as despesas."
                            Foreground="{StaticResource FinanceMuted}"
                            TextWrapping="Wrap"
                            Margin="0,8,0,18"
                            FontSize="13" />

                        <Button
                            Content="Abrir orçamentos  →"
                            Command="{Binding OpenBudgetsCommand}"
                            Style="{StaticResource FinancePrimaryButton}"
                            HorizontalAlignment="Left" />

                    </StackPanel>

                </Border>

                <!-- METAS -->

                <Border
                    Style="{StaticResource FinanceCard}"
                    Margin="10,0,0,16">

                    <StackPanel>

                        <Border
                            Background="#FAF5FF"
                            CornerRadius="10"
                            Width="48"
                            Height="48"
                            HorizontalAlignment="Left"
                            Margin="0,0,0,16">

                            <TextBlock
                                Text="◎"
                                FontSize="27"
                                Foreground="#9333EA"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />

                        </Border>

                        <TextBlock
                            Text="Metas financeiras"
                            FontSize="18"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource FinanceDark}" />

                        <TextBlock
                            Text="Define objetivos e acompanha as contribuições."
                            Foreground="{StaticResource FinanceMuted}"
                            TextWrapping="Wrap"
                            Margin="0,8,0,18"
                            FontSize="13" />

                        <Button
                            Content="Abrir metas  →"
                            Command="{Binding OpenGoalsCommand}"
                            Style="{StaticResource FinancePrimaryButton}"
                            HorizontalAlignment="Left" />

                    </StackPanel>

                </Border>

            </UniformGrid>

        </Grid>

    </ScrollViewer>

</UserControl>
