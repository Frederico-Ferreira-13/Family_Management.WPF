<UserControl x:Class="Family_Management.WPF.Views.UserEditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewmodels="clr-namespace:Family_Management.WPF.ViewModel.Users"
             mc:Ignorable="d"
             d:DesignHeight="750"
             d:DesignWidth="1100"
             d:DataContext="{d:DesignInstance Type=viewmodels:UserEditViewModel,
                                             IsDesignTimeCreatable=False}">

    <Grid Background="{StaticResource GrayBackground}"
          Margin="24">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Margin="0,0,0,20">

            <TextBlock Text="{Binding Title}"
                       Style="{StaticResource TitleStyle}"
                       TextWrapping="Wrap" />

            <TextBlock Text="Altere os dados do utilizador e consulte as opções de segurança."
                       Foreground="#666"
                       FontSize="14"
                       TextWrapping="Wrap"
                       Margin="0,6,0,0" />

        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      HorizontalContentAlignment="Stretch">

            <Border Style="{StaticResource CardBorderStyle}"
                    Padding="28"
                    MaxWidth="720"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Top">

                <StackPanel>

                    <TextBlock Text="Dados do utilizador"
                               Style="{StaticResource TitleStyle}"
                               Margin="0,0,0,20" />

                    <TextBlock Text="Nome de utilizador"
                               Style="{StaticResource FieldTextBlockStyle}" />

                    <TextBox Text="{Binding UserName,
                                            Mode=TwoWay,
                                            UpdateSourceTrigger=PropertyChanged,
                                            ValidatesOnNotifyDataErrors=True,
                                            NotifyOnValidationError=True}"
                             Style="{StaticResource ErrorTextBoxStyle}"
                             Height="Auto"
                             MinHeight="42"
                             Padding="10,8"
                             VerticalContentAlignment="Center" />

                    <TextBlock Text="E-mail"
                               Style="{StaticResource FieldTextBlockStyle}"
                               Margin="0,18,0,5" />

                    <TextBox Text="{Binding Email,
                                            Mode=TwoWay,
                                            UpdateSourceTrigger=PropertyChanged,
                                            ValidatesOnNotifyDataErrors=True,
                                            NotifyOnValidationError=True}"
                             Style="{StaticResource ErrorTextBoxStyle}"
                             Height="Auto"
                             MinHeight="42"
                             Padding="10,8"
                             VerticalContentAlignment="Center" />

                    <TextBlock Text="Família"
                               Style="{StaticResource FieldTextBlockStyle}"
                               Margin="0,18,0,5" />

                    <ComboBox ItemsSource="{Binding AvailableFamilies}"
                              SelectedItem="{Binding SelectedFamily,
                                                     Mode=TwoWay,
                                                     UpdateSourceTrigger=PropertyChanged}"
                              DisplayMemberPath="Name"
                              Style="{StaticResource DefaultComboBoxStyle}"
                              Height="Auto"
                              MinHeight="42" />

                    <TextBlock Text="Deixe sem seleção para remover o utilizador da família."
                               FontSize="12"
                               Foreground="#777"
                               TextWrapping="Wrap"
                               Margin="0,6,0,0" />

                    <Border Background="#F3F6FA"
                            CornerRadius="6"
                            Padding="12"
                            Margin="0,20,0,0">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock Text="Estado:"
                                       FontWeight="SemiBold"
                                       Margin="0,0,8,0" />

                            <TextBlock Text="Ativo"
                                       Visibility="{Binding IsActive,
                                                            Converter={StaticResource BoolToVis}}" />

                            <TextBlock Text="Inativo"
                                       Visibility="{Binding IsActive,
                                                            Converter={StaticResource InverseBoolToVis}}" />

                        </StackPanel>

                    </Border>

                    <WrapPanel HorizontalAlignment="Right"
                               Margin="0,20,0,0">

                        <Button Content="Cancelar"
                                Command="{Binding CancelCommand}"
                                Style="{StaticResource SecondaryButton}"
                                Margin="0,0,10,8" />

                        <Button Content="Guardar alterações"
                                Command="{Binding SaveCommand}"
                                Style="{StaticResource PrimaryButton}"
                                Margin="0,0,0,8" />

                    </WrapPanel>

                    <StackPanel Visibility="{Binding CanChangeOwnPassword,
                                                     Converter={StaticResource BoolToVis}}">

                        <Separator Margin="0,20,0,24" />

                        <TextBlock Text="Segurança"
                                   Style="{StaticResource TitleStyle}"
                                   Margin="0,0,0,8" />

                        <TextBlock Text="Para alterar a sua palavra-passe, introduza a palavra-passe atual e confirme a nova."
                                   Foreground="#666"
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,16" />

                        <Button Content="Alterar palavra-passe"
                                Command="{Binding OpenChangePasswordCommand}"
                                Style="{StaticResource SecondaryButton}"
                                HorizontalAlignment="Left" />

                    </StackPanel>

                </StackPanel>

            </Border>

        </ScrollViewer>

    </Grid>

</UserControl>