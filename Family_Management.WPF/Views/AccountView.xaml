<UserControl x:Class="Family_Management.WPF.Views.AccountView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewmodels="clr-namespace:Family_Management.WPF.ViewModel.Accounts"
             x:Name="AccountViewRoot"
             mc:Ignorable="d"
             d:DesignHeight="650"
             d:DesignWidth="1100"
             d:DataContext="{d:DesignInstance Type=viewmodels:AccountViewModel,
                                             IsDesignTimeCreatable=False}">

    <Grid Margin="15">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- =====================================================
             CABEÇALHO
             ===================================================== -->

        <Grid Grid.Row="0"
              Margin="0,0,0,15">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="Gestão de Contas"
                       Style="{StaticResource TitleStyle}"
                       VerticalAlignment="Center" />

            <Button Grid.Column="1"
                    Content="Atualizar"
                    Command="{Binding RefreshCommand}"
                    Style="{StaticResource DefaultButton}"
                    Padding="15,5" />

        </Grid>

        <!-- =====================================================
             CONTEÚDO
             ===================================================== -->

        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="370" />
            </Grid.ColumnDefinitions>

            <!-- =================================================
                 LISTA DE CONTAS
                 ================================================= -->

            <DataGrid Grid.Column="0"
                      ItemsSource="{Binding Accounts}"
                      SelectedItem="{Binding SelectedAccount,
                                             Mode=TwoWay}"
                      Style="{StaticResource CustomDataGridStyle}"
                      IsReadOnly="True"
                      AutoGenerateColumns="False"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      Margin="0,0,15,0">

                <DataGrid.Columns>

                    <DataGridTextColumn Header="Nome"
                                        Binding="{Binding Name}"
                                        Width="2*" />

                    <DataGridTextColumn Header="Saldo"
                                        Binding="{Binding Balance,
                                                          StringFormat=N2}"
                                        Width="*" />

                    <DataGridTextColumn Header="Tipo"
                                        Binding="{Binding Type}"
                                        Width="Auto" />

                    <DataGridTextColumn Header="Moeda"
                                        Binding="{Binding Currency}"
                                        Width="Auto" />

                    <DataGridCheckBoxColumn Header="Ativa"
                                            Binding="{Binding IsActive}"
                                            Width="Auto" />

                    <DataGridTemplateColumn Header="Ações"
                                            Width="Auto">

                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>

                                <Button Content="Editar"
                                        Style="{StaticResource HyperlinkLikeButton}"
                                        Command="{Binding DataContext.SelectAccountCommand,
                                                          ElementName=AccountViewRoot}"
                                        CommandParameter="{Binding}" />

                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>

                    </DataGridTemplateColumn>

                </DataGrid.Columns>

            </DataGrid>

            <!-- =================================================
                 FORMULÁRIO
                 ================================================= -->

            <Border Grid.Column="1"
                    Style="{StaticResource CardBorderStyle}"
                    Padding="15"
                    VerticalAlignment="Top">

                <StackPanel>

                    <!-- Título -->

                    <TextBlock Margin="0,0,0,15">

                        <TextBlock.Style>
                            <Style TargetType="TextBlock"
                                   BasedOn="{StaticResource TitleStyle}">

                                <Setter Property="Text"
                                        Value="Criar Conta" />

                                <Setter Property="FontSize"
                                        Value="18" />

                                <Style.Triggers>

                                    <DataTrigger Binding="{Binding IsEditing}"
                                                 Value="True">

                                        <Setter Property="Text"
                                                Value="Editar Conta" />

                                    </DataTrigger>

                                </Style.Triggers>

                            </Style>
                        </TextBlock.Style>

                    </TextBlock>

                    <!-- Nome -->

                    <TextBlock Text="Nome da Conta:"
                               Style="{StaticResource LabelStyle}" />

                    <TextBox Text="{Binding Form.Name,
                                           Mode=TwoWay,
                                           UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ErrorTextBoxStyle}"
                             Margin="0,0,0,10" />

                    <!-- Tipo -->

                    <TextBlock Text="Tipo:"
                               Style="{StaticResource LabelStyle}" />

                    <ComboBox ItemsSource="{Binding AccountTypes}"
                              SelectedItem="{Binding Form.Type,
                                                    Mode=TwoWay,
                                                    UpdateSourceTrigger=PropertyChanged}"
                              Style="{StaticResource DefaultComboBoxStyle}"
                              Margin="0,0,0,10" />

                    <!-- Saldo Inicial -->

                    <TextBlock Text="Saldo Inicial:"
                               Style="{StaticResource LabelStyle}" />

                    <TextBox Text="{Binding Form.InitialBalance,
                                           Mode=TwoWay,
                                           UpdateSourceTrigger=PropertyChanged,
                                           StringFormat=N2}"
                             Margin="0,0,0,10">

                        <TextBox.Style>
                            <Style TargetType="TextBox"
                                   BasedOn="{StaticResource DefaultTextBoxStyle}">

                                <Setter Property="IsEnabled"
                                        Value="True" />

                                <Style.Triggers>

                                    <DataTrigger Binding="{Binding IsEditing}"
                                                 Value="True">

                                        <Setter Property="IsEnabled"
                                                Value="False" />

                                    </DataTrigger>

                                </Style.Triggers>

                            </Style>
                        </TextBox.Style>

                    </TextBox>

                    <!-- Moeda -->

                    <TextBlock Text="Moeda:"
                               Style="{StaticResource LabelStyle}" />

                    <ComboBox ItemsSource="{Binding AvailableCurrencies}"
                              DisplayMemberPath="Code"
                              SelectedValuePath="Code"
                              SelectedValue="{Binding Form.Currency,
                                                      Mode=TwoWay,
                                                      UpdateSourceTrigger=PropertyChanged}"
                              Margin="0,0,0,10">

                        <ComboBox.Style>
                            <Style TargetType="ComboBox"
                                   BasedOn="{StaticResource DefaultComboBoxStyle}">

                                <Setter Property="IsEnabled"
                                        Value="True" />

                                <Style.Triggers>

                                    <DataTrigger Binding="{Binding IsEditing}"
                                                 Value="True">

                                        <Setter Property="IsEnabled"
                                                Value="False" />

                                    </DataTrigger>

                                </Style.Triggers>

                            </Style>
                        </ComboBox.Style>

                    </ComboBox>

                    <!-- Descrição -->

                    <TextBlock Text="Descrição / Notas:"
                               Style="{StaticResource LabelStyle}" />

                    <TextBox Text="{Binding Form.Description,
                                           Mode=TwoWay,
                                           UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource DefaultTextBoxStyle}"
                             Height="70"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             Margin="0,0,0,20" />

                    <!-- Guardar / cancelar -->

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Command="{Binding SaveCommand}"
                                Margin="0,0,5,0">

                            <Button.Style>
                                <Style TargetType="Button"
                                       BasedOn="{StaticResource PrimaryButton}">

                                    <Setter Property="Content"
                                            Value="Criar Conta" />

                                    <Style.Triggers>

                                        <DataTrigger Binding="{Binding IsEditing}"
                                                     Value="True">

                                            <Setter Property="Content"
                                                    Value="Guardar Alterações" />

                                        </DataTrigger>

                                    </Style.Triggers>

                                </Style>
                            </Button.Style>

                        </Button>

                        <Button Grid.Column="1"
                                Content="Cancelar"
                                Command="{Binding CancelEditCommand}"
                                Style="{StaticResource DefaultButton}"
                                Padding="15,0" />

                    </Grid>

                    <!-- Desativar -->

                    <Button Content="Desativar Conta"
                            Command="{Binding DeactivateAccountCommand}"
                            Margin="0,15,0,0">

                        <Button.Style>
                            <Style TargetType="Button"
                                   BasedOn="{StaticResource DangerButton}">

                                <Setter Property="Visibility"
                                        Value="Collapsed" />

                                <Style.Triggers>

                                    <DataTrigger Binding="{Binding IsEditing}"
                                                 Value="True">

                                        <Setter Property="Visibility"
                                                Value="Visible" />

                                    </DataTrigger>

                                </Style.Triggers>

                            </Style>
                        </Button.Style>

                    </Button>

                </StackPanel>

            </Border>

        </Grid>

    </Grid>

</UserControl>