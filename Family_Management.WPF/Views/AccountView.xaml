<UserControl
    x:Class="Family_Management.WPF.Views.AccountView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:viewmodels="clr-namespace:Family_Management.WPF.ViewModel.Accounts"
    x:Name="AccountViewRoot"
    mc:Ignorable="d"
    d:DesignHeight="750"
    d:DesignWidth="1150"
    d:DataContext="{d:DesignInstance Type=viewmodels:AccountViewModel,
                                    IsDesignTimeCreatable=False}">

    <UserControl.Resources>

        <!-- ETIQUETAS -->

        <Style
            x:Key="AccountFieldLabel"
            TargetType="TextBlock"
            BasedOn="{StaticResource LabelStyle}">

            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>

        </Style>

        <!-- CAMPOS DE TEXTO -->

        <Style
            x:Key="AccountInput"
            TargetType="TextBox"
            BasedOn="{StaticResource DefaultTextBoxStyle}">

            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="13"/>

        </Style>

        <!-- COMBOBOX -->

        <Style
            x:Key="AccountCombo"
            TargetType="ComboBox"
            BasedOn="{StaticResource DefaultComboBoxStyle}">

            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="FontSize" Value="13"/>

        </Style>

        <!-- TÍTULO DO FORMULÁRIO -->

        <Style
            x:Key="AccountFormTitle"
            TargetType="TextBlock"
            BasedOn="{StaticResource TitleStyle}">

            <Setter Property="Text" Value="Criação de Conta"/>
            <Setter Property="FontSize" Value="18"/>

            <Style.Triggers>

                <DataTrigger
                    Binding="{Binding IsEditing}"
                    Value="True">

                    <Setter
                        Property="Text"
                        Value="Editar Conta"/>

                </DataTrigger>

            </Style.Triggers>

        </Style>

        <!-- BOTÃO GUARDAR -->

        <Style
            x:Key="AccountSaveButton"
            TargetType="Button"
            BasedOn="{StaticResource PrimaryButton}">

            <Setter Property="Content" Value="Criar Conta"/>

            <Style.Triggers>

                <DataTrigger
                    Binding="{Binding IsEditing}"
                    Value="True">

                    <Setter
                        Property="Content"
                        Value="Guardar alterações"/>

                </DataTrigger>

            </Style.Triggers>

        </Style>

        <!-- BOTÃO DESATIVAR -->

        <Style
            x:Key="AccountDeactivateButton"
            TargetType="Button"
            BasedOn="{StaticResource DangerButton}">

            <Setter Property="Visibility" Value="Collapsed"/>

            <Style.Triggers>

                <DataTrigger
                    Binding="{Binding IsEditing}"
                    Value="True">

                    <Setter
                        Property="Visibility"
                        Value="Visible"/>

                </DataTrigger>

            </Style.Triggers>

        </Style>

        <!-- SALDO BLOQUEADO DURANTE EDIÇÃO -->

        <Style
            x:Key="AccountBalanceInput"
            TargetType="TextBox"
            BasedOn="{StaticResource AccountInput}">

            <Style.Triggers>

                <DataTrigger
                    Binding="{Binding IsEditing}"
                    Value="True">

                    <Setter
                        Property="IsEnabled"
                        Value="False"/>

                </DataTrigger>

            </Style.Triggers>

        </Style>

        <!-- MOEDA BLOQUEADA DURANTE EDIÇÃO -->

        <Style
            x:Key="AccountCurrencyCombo"
            TargetType="ComboBox"
            BasedOn="{StaticResource AccountCombo}">

            <Style.Triggers>

                <DataTrigger
                    Binding="{Binding IsEditing}"
                    Value="True">

                    <Setter
                        Property="IsEnabled"
                        Value="False"/>

                </DataTrigger>

            </Style.Triggers>

        </Style>

    </UserControl.Resources>

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- CABEÇALHO -->

        <Grid
            Grid.Row="0"
            Margin="0,0,0,18">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">

                <TextBlock
                    Text="Contas bancárias"
                    Style="{StaticResource TitleStyle}"/>

                <TextBlock
                    Text="Organiza as tuas contas e acompanha os saldos."
                    Margin="0,6,0,0"
                    Foreground="Gray"
                    FontSize="13"/>

                <TextBlock
                    Text="{Binding ActiveContextDescription}"
                    Margin="0,7,0,0"
                    Foreground="#2563EB"
                    FontSize="12"
                    FontWeight="SemiBold"/>

            </StackPanel>

            <Button
                Grid.Column="1"
                Content="Atualizar"
                Command="{Binding RefreshCommand}"
                Style="{StaticResource DefaultButton}"
                Padding="16,8"
                VerticalAlignment="Center"/>

        </Grid>

        <!-- PLANEAMENTO FINANCEIRO -->

        <Border
            Grid.Row="1"
            Background="#EFF6FF"
            BorderBrush="#BFDBFE"
            BorderThickness="1"
            CornerRadius="10"
            Padding="16"
            Margin="0,0,0,18">

            <StackPanel>

                <TextBlock
                    Text="Planeamento financeiro independente"
                    FontWeight="SemiBold"
                    FontSize="13"
                    Foreground="#1E40AF"/>

                <TextBlock
                    Text="Podes planear receitas e despesas sem criar contas bancárias. As contas destinam-se ao acompanhamento dos saldos e dos movimentos efetivos."
                    TextWrapping="Wrap"
                    FontSize="12"
                    Foreground="#334155"
                    Margin="0,5,0,0"/>

            </StackPanel>

        </Border>

        <!-- ÁREA PRINCIPAL -->

        <Grid Grid.Row="2">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="320"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="370"/>
            </Grid.ColumnDefinitions>

            <!-- CONTAS REGISTADAS -->

            <Border
                Grid.Column="0"
                Style="{StaticResource CardBorderStyle}"
                Padding="15">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- CABEÇALHO DA LISTA -->

                    <Grid
                        Grid.Row="0"
                        Margin="0,0,0,15">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">

                            <TextBlock
                                Text="Contas registadas"
                                Style="{StaticResource TitleStyle}"
                                FontSize="18"/>

                            <TextBlock
                                Text="Seleciona uma conta para consultar ou editar."
                                Foreground="Gray"
                                FontSize="12"
                                Margin="0,5,0,0"/>

                        </StackPanel>

                        <Border
                            Grid.Column="1"
                            Background="#EFF6FF"
                            CornerRadius="8"
                            Padding="12,7"
                            VerticalAlignment="Center">

                            <TextBlock
                                Foreground="#1D4ED8"
                                FontSize="12"
                                FontWeight="SemiBold">

                                <Run
                                    Text="{Binding Accounts.Count, Mode=OneWay}"/>

                                <Run Text=" contas"/>

                            </TextBlock>

                        </Border>

                    </Grid>

                    <!-- TABELA -->

                    <Grid Grid.Row="1">

                        <DataGrid
                            ItemsSource="{Binding Accounts}"
                            SelectedItem="{Binding SelectedAccount, Mode=TwoWay}"
                            Style="{StaticResource CustomDataGridStyle}"
                            AutoGenerateColumns="False"
                            IsReadOnly="True"
                            SelectionMode="Single"
                            SelectionUnit="FullRow"
                            CanUserAddRows="False"
                            CanUserDeleteRows="False"
                            MinHeight="350"
                            HorizontalScrollBarVisibility="Auto">

                            <DataGrid.Columns>

                                <!-- NOME -->

                                <DataGridTextColumn
                                    Header="Nome"
                                    Binding="{Binding Name}"
                                    Width="2*"
                                    MinWidth="130"/>

                                <!-- BANCO -->

                                <DataGridTextColumn
                                    Header="Banco"
                                    Binding="{Binding BankName}"
                                    Width="1.5*"
                                    MinWidth="130"/>

                                <!-- SALDO -->

                                <DataGridTextColumn
                                    Header="Saldo"
                                    Binding="{Binding Balance, StringFormat=N2}"
                                    Width="*"
                                    MinWidth="90"/>

                                <!-- MOEDA -->

                                <DataGridTextColumn
                                    Header="Moeda"
                                    Binding="{Binding Currency}"
                                    Width="Auto"
                                    MinWidth="65"/>

                                <!-- ESTADO -->

                                <DataGridCheckBoxColumn
                                    Header="Ativa"
                                    Binding="{Binding IsActive}"
                                    Width="Auto"/>

                                <!-- AÇÕES -->

                                <DataGridTemplateColumn
                                    Header="Ações"
                                    Width="Auto">

                                    <DataGridTemplateColumn.CellTemplate>

                                        <DataTemplate>

                                            <Button
                                                Content="Editar"
                                                Style="{StaticResource HyperlinkLikeButton}"
                                                Command="{Binding DataContext.SelectAccountCommand, ElementName=AccountViewRoot}"
                                                CommandParameter="{Binding}"/>

                                        </DataTemplate>

                                    </DataGridTemplateColumn.CellTemplate>

                                </DataGridTemplateColumn>

                            </DataGrid.Columns>

                        </DataGrid>

                        <!-- ESTADO VAZIO -->

                        <StackPanel
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            MaxWidth="260"
                            IsHitTestVisible="False">

                            <StackPanel.Style>

                                <Style TargetType="StackPanel">

                                    <Setter
                                        Property="Visibility"
                                        Value="Collapsed"/>

                                    <Style.Triggers>

                                        <DataTrigger
                                            Binding="{Binding Accounts.Count}"
                                            Value="0">

                                            <Setter
                                                Property="Visibility"
                                                Value="Visible"/>

                                        </DataTrigger>

                                    </Style.Triggers>

                                </Style>

                            </StackPanel.Style>

                            <TextBlock
                                Text="Ainda não existem contas"
                                FontWeight="SemiBold"
                                FontSize="15"
                                TextAlignment="Center"/>

                            <TextBlock
                                Text="Cria uma conta ou começa pelo planeamento das receitas e despesas."
                                TextWrapping="Wrap"
                                TextAlignment="Center"
                                Foreground="Gray"
                                FontSize="12"
                                Margin="0,8,0,0"/>

                        </StackPanel>

                    </Grid>

                </Grid>

            </Border>

            <!-- FORMULÁRIO -->

            <Border
                Grid.Column="2"
                Style="{StaticResource CardBorderStyle}"
                Padding="20"
                VerticalAlignment="Top">

                <StackPanel>

                    <!-- TÍTULO -->

                    <TextBlock
                        Style="{StaticResource AccountFormTitle}"
                        Margin="0,0,0,5"/>

                    <TextBlock
                        Text="Preenche os dados essenciais da conta."
                        Foreground="Gray"
                        FontSize="12"
                        Margin="0,0,0,20"/>

                    <!-- NOME DA CONTA -->

                    <TextBlock
                        Text="Nome da Conta"
                        Style="{StaticResource AccountFieldLabel}"/>

                    <TextBox
                        Text="{Binding Form.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        Style="{StaticResource AccountInput}"
                        ToolTip="Exemplo: Família Ferreira"
                        Margin="0,0,0,15"/>

                    <!-- BANCO ASSOCIADO -->

                    <TextBlock
                        Text="Banco Associado"
                        Style="{StaticResource AccountFieldLabel}"/>

                    <ComboBox
                        ItemsSource="{Binding AvailableBanks}"
                        SelectedItem="{Binding Form.BankName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        Style="{StaticResource AccountCombo}"
                        Margin="0,0,0,15"
                        ToolTip="Seleciona a instituição bancária associada à conta."/>

                    <!-- MOEDA -->

                    <TextBlock
                        Text="Moeda"
                        Style="{StaticResource AccountFieldLabel}"/>

                    <ComboBox
                        ItemsSource="{Binding AvailableCurrencies}"
                        DisplayMemberPath="Code"
                        SelectedValuePath="Code"
                        SelectedValue="{Binding Form.Currency, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        Style="{StaticResource AccountCurrencyCombo}"
                        Margin="0,0,0,15"/>

                    <!-- SALDO DE REFERÊNCIA -->

                    <TextBlock
                        Text="Saldo de Referência"
                        Style="{StaticResource AccountFieldLabel}"/>

                    <TextBox
                        Text="{Binding Form.InitialBalance, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=N2}"
                        Style="{StaticResource AccountBalanceInput}"
                        Margin="0,0,0,7"
                        ToolTip="Saldo existente quando começas a acompanhar a conta."/>

                    <TextBlock
                        Text="Este valor representa o saldo de partida da conta e não o orçamento mensal previsto."
                        Foreground="Gray"
                        FontSize="11"
                        TextWrapping="Wrap"
                        Margin="0,0,0,20"/>

                    <!-- AÇÕES -->

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button
                            Grid.Column="0"
                            Command="{Binding SaveCommand}"
                            Style="{StaticResource AccountSaveButton}"
                            Margin="0,0,8,0"
                            Padding="12,9"/>

                        <Button
                            Grid.Column="1"
                            Content="Cancelar"
                            Command="{Binding CancelEditCommand}"
                            Style="{StaticResource DefaultButton}"
                            Padding="12,9"/>

                    </Grid>

                    <!-- DESATIVAR CONTA -->

                    <Button
                        Content="Desativar conta"
                        Command="{Binding DeactivateAccountCommand}"
                        Style="{StaticResource AccountDeactivateButton}"
                        Margin="0,15,0,0"/>

                </StackPanel>

            </Border>

        </Grid>

    </Grid>

</UserControl>