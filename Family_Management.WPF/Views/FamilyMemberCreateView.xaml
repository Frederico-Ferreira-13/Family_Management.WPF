<UserControl
    x:Class="Family_Management.WPF.Views.Families.FamilyMemberCreateView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="clr-namespace:Family_Management.WPF.ViewModel.Families"
    xmlns:helpers="clr-namespace:Family_Management.WPF.Utilities"
    mc:Ignorable="d"
    d:DesignHeight="700"
    d:DesignWidth="1000"
    d:DataContext="{d:DesignInstance Type=viewmodels:FamilyMemberCreateViewModel}"
    Background="{DynamicResource FM.Background.Brush}">

    <Grid Margin="24">

        <Border
            Background="{StaticResource FM.Surface.Brush}"
            CornerRadius="20"
            Padding="36"
            Width="500"
            MaxHeight="720"
            BorderBrush="{StaticResource FM.Border.Brush}"
            BorderThickness="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">

            <ScrollViewer
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled">

                <StackPanel>

                    <!-- =====================================
                         CABEÇALHO
                         ===================================== -->

                    <TextBlock
                        Text="Adicionar membro"
                        HorizontalAlignment="Center"
                        FontSize="27"
                        FontWeight="Bold"
                        Foreground="{StaticResource FM.TextPrimary.Brush}"
                        Margin="0,0,0,8" />

                    <TextBlock
                        Text="Crie uma conta para um membro do agregado familiar."
                        HorizontalAlignment="Center"
                        TextAlignment="Center"
                        TextWrapping="Wrap"
                        FontSize="13"
                        Foreground="{StaticResource FM.TextSecondary.Brush}"
                        Margin="0,0,0,24" />

                    <!-- =====================================
                         INFORMAÇÃO
                         ===================================== -->

                    <Border
                        Background="{StaticResource FM.SurfaceAlt.Brush}"
                        CornerRadius="10"
                        Padding="14"
                        Margin="0,0,0,20">

                        <StackPanel>

                            <TextBlock
                                Text="Novo membro da família"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource FM.TextPrimary.Brush}" />

                            <TextBlock
                                Text="O novo utilizador será associado ao seu agregado familiar após a criação da conta."
                                TextWrapping="Wrap"
                                FontSize="12"
                                Foreground="{StaticResource FM.TextSecondary.Brush}"
                                Margin="0,5,0,0" />

                        </StackPanel>

                    </Border>

                    <!-- =====================================
                         NOME DE UTILIZADOR
                         ===================================== -->

                    <TextBlock
                        Text="Nome de utilizador"
                        Style="{StaticResource LabelStyle}"
                        Margin="0,5,0,5" />

                    <TextBox
                        Text="{Binding UserName,
                                       Mode=TwoWay,
                                       UpdateSourceTrigger=PropertyChanged,
                                       ValidatesOnNotifyDataErrors=True,
                                       NotifyOnValidationError=True}"
                        Style="{StaticResource ErrorTextBoxStyle}" />

                    <!-- =====================================
                         EMAIL
                         ===================================== -->

                    <TextBlock
                        Text="Email"
                        Style="{StaticResource LabelStyle}"
                        Margin="0,15,0,5" />

                    <TextBox
                        Text="{Binding Email,
                                       Mode=TwoWay,
                                       UpdateSourceTrigger=PropertyChanged,
                                       ValidatesOnNotifyDataErrors=True,
                                       NotifyOnValidationError=True}"
                        Style="{StaticResource ErrorTextBoxStyle}" />

                    <!-- =====================================
                         PALAVRA-PASSE
                         ===================================== -->

                    <TextBlock
                        Text="Palavra-passe"
                        Style="{StaticResource LabelStyle}"
                        Margin="0,15,0,5" />

                    <PasswordBox
                        helpers:PasswordBoxHelper.Attach="True"
                        helpers:PasswordBoxHelper.Password="{Binding Password,
                                                                     Mode=TwoWay,
                                                                     UpdateSourceTrigger=PropertyChanged,
                                                                     ValidatesOnNotifyDataErrors=True,
                                                                     NotifyOnValidationError=True}"
                        Style="{StaticResource ErrorPasswordBoxStyle}" />

                    <TextBlock
                        Text="Utilize pelo menos 8 caracteres."
                        FontSize="11"
                        Foreground="{StaticResource FM.TextMuted.Brush}"
                        Margin="2,5,0,0" />

                    <!-- =====================================
                         CONFIRMAR PALAVRA-PASSE
                         ===================================== -->

                    <TextBlock
                        Text="Confirmar palavra-passe"
                        Style="{StaticResource LabelStyle}"
                        Margin="0,15,0,5" />

                    <PasswordBox
                        helpers:PasswordBoxHelper.Attach="True"
                        helpers:PasswordBoxHelper.Password="{Binding ConfirmPassword,
                                                                     Mode=TwoWay,
                                                                     UpdateSourceTrigger=PropertyChanged,
                                                                     ValidatesOnNotifyDataErrors=True,
                                                                     NotifyOnValidationError=True}"
                        Style="{StaticResource ErrorPasswordBoxStyle}" />

                    <!-- =====================================
                         PROCESSAMENTO
                         ===================================== -->

                    <ProgressBar
                        IsIndeterminate="True"
                        Height="4"
                        Margin="0,22,0,0"
                        Visibility="{Binding IsBusy,
                                             Converter={StaticResource BoolToVis}}" />

                    <!-- =====================================
                         GUARDAR
                         ===================================== -->

                    <Button
                        Content="Adicionar membro à família"
                        Command="{Binding SaveCommand}"
                        Style="{StaticResource PrimaryButton}"
                        Height="44"
                        Margin="0,25,0,0" />

                    <!-- =====================================
                         CANCELAR
                         ===================================== -->

                    <Button
                        Content="Cancelar"
                        Command="{Binding CancelCommand}"
                        Style="{StaticResource HyperlinkLikeButton}"
                        HorizontalAlignment="Center"
                        Margin="0,16,0,0" />

                </StackPanel>

            </ScrollViewer>

        </Border>

    </Grid>

</UserControl>
