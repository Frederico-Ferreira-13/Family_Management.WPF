<UserControl x:Class="Family_Management.WPF.Views.CurrencyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewmodels="clr-namespace:Family_Management.WPF.ViewModel.Currencies"
             mc:Ignorable="d"
             d:DesignHeight="700"
             d:DesignWidth="1100"
             d:DataContext="{d:DesignInstance Type=viewmodels:CurrencyViewModel,
                                             IsDesignTimeCreatable=False}">

    <Grid Margin="15">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- =====================================================
             FORMULÁRIO
             ===================================================== -->

        <Border Grid.Row="0"
                Style="{StaticResource CardBorderStyle}"
                Margin="0,0,0,20"
                Padding="25">

            <StackPanel>

                <!-- Cabeçalho -->

                <Grid Margin="0,0,0,20">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0">

                        <TextBlock.Style>
                            <Style TargetType="TextBlock"
                                   BasedOn="{StaticResource TitleStyle}">

                                <Setter Property="Text"
                                        Value="Nova Moeda" />

                                <Style.Triggers>

                                    <DataTrigger Binding="{Binding IsEditMode}"
                                                 Value="True">

                                        <Setter Property="Text"
                                                Value="Editar Moeda" />

                                    </DataTrigger>

                                </Style.Triggers>

                            </Style>
                        </TextBlock.Style>

                    </TextBlock>

                    <Button Grid.Column="1"
                            Content="Atualizar"
                            Command="{Binding RefreshCommand}"
                            Style="{StaticResource DefaultButton}"
                            Padding="15,5" />

                </Grid>

                <!-- =================================================
                     CAMPOS
                     ================================================= -->

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Coluna esquerda -->

                    <StackPanel Grid.Column="0">

                        <!-- Código -->

                        <TextBlock Text="Código (ex.: EUR, USD):"
                                   Style="{StaticResource LabelStyle}"
                                   Margin="0,0,0,5" />

                        <TextBox Text="{Binding Form.Code,
                                               Mode=TwoWay,
                                               UpdateSourceTrigger=PropertyChanged}"
                                 MaxLength="3"
                                 CharacterCasing="Upper">

                            <TextBox.Style>
                                <Style TargetType="TextBox"
                                       BasedOn="{StaticResource DefaultTextBoxStyle}">

                                    <Setter Property="IsReadOnly"
                                            Value="False" />

                                    <Style.Triggers>

                                        <DataTrigger Binding="{Binding IsEditMode}"
                                                     Value="True">

                                            <Setter Property="IsReadOnly"
                                                    Value="True" />

                                        </DataTrigger>

                                    </Style.Triggers>

                                </Style>
                            </TextBox.Style>

                        </TextBox>

                        <TextBlock Text="O código ISO deve ter 3 caracteres."
                                   FontSize="11"
                                   Foreground="Gray"
                                   Margin="2,4,0,15" />

                        <!-- Nome -->

                        <TextBlock Text="Nome da Moeda:"
                                   Style="{StaticResource LabelStyle}"
                                   Margin="0,0,0,5" />

                        <TextBox Text="{Binding Form.Name,
                                               Mode=TwoWay,
                                               UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource DefaultTextBoxStyle}" />

                        <!-- Símbolo -->

                        <TextBlock Text="Símbolo (ex.: €):"
                                   Style="{StaticResource LabelStyle}"
                                   Margin="0,15,0,5" />

                        <TextBox Text="{Binding Form.Symbol,
                                               Mode=TwoWay,
                                               UpdateSourceTrigger=PropertyChanged}"
                                 MaxLength="5"
                                 Style="{StaticResource DefaultTextBoxStyle}" />

                    </StackPanel>

                    <!-- Coluna direita -->

                    <StackPanel Grid.Column="2">

                        <!-- Casas decimais -->

                        <TextBlock Text="Casas Decimais:"
                                   Style="{StaticResource LabelStyle}"
                                   Margin="0,0,0,5" />

                        <TextBox Text="{Binding Form.DecimalPlaces,
                                               Mode=TwoWay,
                                               UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource DefaultTextBoxStyle}" />

                        <TextBlock Text="Valor permitido: 0 a 8."
                                   FontSize="11"
                                   Foreground="Gray"
                                   Margin="2,4,0,15" />

                        <!-- Moeda padrão durante criação -->

                        <CheckBox Content="Definir como moeda padrão"
                                  IsChecked="{Binding Form.IsDefault,
                                                      Mode=TwoWay}"
                                  Margin="0,5,0,0">

                            <CheckBox.Style>
                                <Style TargetType="CheckBox">

                                    <Setter Property="Visibility"
                                            Value="Visible" />

                                    <Style.Triggers>

                                        <DataTrigger Binding="{Binding IsEditMode}"
                                                     Value="True">

                                            <Setter Property="Visibility"
                                                    Value="Collapsed" />

                                        </DataTrigger>

                                    </Style.Triggers>

                                </Style>
                            </CheckBox.Style>

                        </CheckBox>

                        <!-- Estado da moeda selecionada -->

                        <Border Margin="0,20,0,0"
                                Padding="15"
                                BorderBrush="{StaticResource BorderLightBrush}"
                                BorderThickness="1"
                                CornerRadius="4">

                            <Border.Style>
                                <Style TargetType="Border">

                                    <Setter Property="Visibility"
                                            Value="Collapsed" />

                                    <Style.Triggers>

                                        <DataTrigger Binding="{Binding IsEditMode}"
                                                     Value="True">

                                            <Setter Property="Visibility"
                                                    Value="Visible" />

                                        </DataTrigger>

                                    </Style.Triggers>

                                </Style>
                            </Border.Style>

                            <StackPanel>

                                <TextBlock Text="Estado da moeda"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,8" />

                                <StackPanel Orientation="Horizontal">

                                    <TextBlock Text="Estado:"
                                               Margin="0,0,5,0" />

                                    <TextBlock>

                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">

                                                <Setter Property="Text"
                                                        Value="Inativa" />

                                                <Setter Property="Foreground"
                                                        Value="{StaticResource DangerColorBrush}" />

                                                <Style.Triggers>

                                                    <DataTrigger Binding="{Binding SelectedCurrency.IsActive}"
                                                                 Value="True">

                                                        <Setter Property="Text"
                                                                Value="Ativa" />

                                                        <Setter Property="Foreground"
                                                                Value="{StaticResource SecondaryColorBrush}" />

                                                    </DataTrigger>

                                                </Style.Triggers>

                                            </Style>
                                        </TextBlock.Style>

                                    </TextBlock>

                                </StackPanel>

                                <StackPanel Orientation="Horizontal"
                                            Margin="0,5,0,0">

                                    <TextBlock Text="Padrão:"
                                               Margin="0,0,5,0" />

                                    <TextBlock>

                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">

                                                <Setter Property="Text"
                                                        Value="Não" />

                                                <Style.Triggers>

                                                    <DataTrigger Binding="{Binding SelectedCurrency.IsDefault}"
                                                                 Value="True">

                                                        <Setter Property="Text"
                                                                Value="Sim" />

                                                        <Setter Property="FontWeight"
                                                                Value="SemiBold" />

                                                    </DataTrigger>

                                                </Style.Triggers>

                                            </Style>
                                        </TextBlock.Style>

                                    </TextBlock>

                                </StackPanel>

                            </StackPanel>

                        </Border>

                    </StackPanel>

                </Grid>

                <!-- =================================================
                     AÇÕES
                     ================================================= -->

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,25,0,0">

                    <!-- Guardar -->

                    <Button Command="{Binding SaveCommand}"
                            Margin="5,0">

                        <Button.Style>
                            <Style TargetType="Button"
                                   BasedOn="{StaticResource PrimaryButton}">

                                <Setter Property="Content"
                                        Value="Adicionar" />

                                <Style.Triggers>

                                    <DataTrigger Binding="{Binding IsEditMode}"
                                                 Value="True">

                                        <Setter Property="Content"
                                                Value="Guardar Alterações" />

                                    </DataTrigger>

                                </Style.Triggers>

                            </Style>
                        </Button.Style>

                    </Button>

                    <!-- Limpar / cancelar -->

                    <Button Content="Limpar / Cancelar"
                            Command="{Binding ClearFormCommand}"
                            Style="{StaticResource DefaultButton}"
                            Margin="5,0" />

                    <!-- Ativar / desativar -->

                    <Button Command="{Binding ToggleStatusCommand}"
                            Margin="5,0">

                        <Button.Style>
                            <Style TargetType="Button"
                                   BasedOn="{StaticResource DangerButton}">

                                <Setter Property="Visibility"
                                        Value="Collapsed" />

                                <Setter Property="Content"
                                        Value="Desativar" />

                                <Style.Triggers>

                                    <DataTrigger Binding="{Binding IsEditMode}"
                                                 Value="True">

                                        <Setter Property="Visibility"
                                                Value="Visible" />

                                    </DataTrigger>

                                    <DataTrigger Binding="{Binding SelectedCurrency.IsActive}"
                                                 Value="False">

                                        <Setter Property="Content"
                                                Value="Ativar" />

                                    </DataTrigger>

                                </Style.Triggers>

                            </Style>
                        </Button.Style>

                    </Button>

                    <!-- Definir como padrão -->

                    <Button Command="{Binding SetDefaultCommand}"
                            Margin="5,0">

                        <Button.Style>
                            <Style TargetType="Button"
                                   BasedOn="{StaticResource SecondaryButton}">

                                <Setter Property="Content"
                                        Value="Definir Padrão" />

                                <Setter Property="Visibility"
                                        Value="Collapsed" />

                                <Style.Triggers>

                                    <MultiDataTrigger>

                                        <MultiDataTrigger.Conditions>

                                            <Condition Binding="{Binding IsEditMode}"
                                                       Value="True" />

                                            <Condition Binding="{Binding SelectedCurrency.IsActive}"
                                                       Value="True" />

                                            <Condition Binding="{Binding SelectedCurrency.IsDefault}"
                                                       Value="False" />

                                        </MultiDataTrigger.Conditions>

                                        <Setter Property="Visibility"
                                                Value="Visible" />

                                    </MultiDataTrigger>

                                </Style.Triggers>

                            </Style>
                        </Button.Style>

                    </Button>

                </StackPanel>

            </StackPanel>

        </Border>

        <!-- =====================================================
             LISTA DE MOEDAS
             ===================================================== -->

        <Grid Grid.Row="1">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="Moedas Registadas"
                       Style="{StaticResource TitleStyle}"
                       Margin="0,0,0,10" />

            <DataGrid Grid.Row="1"
                      ItemsSource="{Binding Currencies}"
                      SelectedItem="{Binding SelectedCurrency,
                                             Mode=TwoWay}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      HeadersVisibility="Column"
                      Style="{StaticResource CustomDataGridStyle}">

                <DataGrid.Columns>

                    <DataGridTextColumn Header="Código"
                                        Binding="{Binding Code}"
                                        Width="Auto" />

                    <DataGridTextColumn Header="Nome"
                                        Binding="{Binding Name}"
                                        Width="*" />

                    <DataGridTextColumn Header="Símbolo"
                                        Binding="{Binding Symbol}"
                                        Width="Auto" />

                    <DataGridTextColumn Header="Casas Dec."
                                        Binding="{Binding DecimalPlaces}"
                                        Width="Auto" />

                    <!-- Padrão -->

                    <DataGridTemplateColumn Header="Padrão"
                                            Width="Auto">

                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>

                                <TextBlock HorizontalAlignment="Center">

                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">

                                            <Setter Property="Text"
                                                    Value="Não" />

                                            <Style.Triggers>

                                                <DataTrigger Binding="{Binding IsDefault}"
                                                             Value="True">

                                                    <Setter Property="Text"
                                                            Value="Sim" />

                                                    <Setter Property="FontWeight"
                                                            Value="SemiBold" />

                                                </DataTrigger>

                                            </Style.Triggers>

                                        </Style>
                                    </TextBlock.Style>

                                </TextBlock>

                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>

                    </DataGridTemplateColumn>

                    <!-- Estado -->

                    <DataGridTemplateColumn Header="Estado"
                                            Width="Auto">

                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>

                                <TextBlock HorizontalAlignment="Center">

                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">

                                            <Setter Property="Text"
                                                    Value="Inativa" />

                                            <Setter Property="Foreground"
                                                    Value="{StaticResource DangerColorBrush}" />

                                            <Style.Triggers>

                                                <DataTrigger Binding="{Binding IsActive}"
                                                             Value="True">

                                                    <Setter Property="Text"
                                                            Value="Ativa" />

                                                    <Setter Property="Foreground"
                                                            Value="{StaticResource SecondaryColorBrush}" />

                                                </DataTrigger>

                                            </Style.Triggers>

                                        </Style>
                                    </TextBlock.Style>

                                </TextBlock>

                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>

                    </DataGridTemplateColumn>

                </DataGrid.Columns>

            </DataGrid>

        </Grid>

    </Grid>

</UserControl>