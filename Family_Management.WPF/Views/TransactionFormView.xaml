<UserControl x:Class="Family_Management.WPF.Views.TransactionFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewmodels="clr-namespace:Family_Management.WPF.ViewModel.Transactions"
             mc:Ignorable="d"
             d:DesignHeight="900"
             d:DesignWidth="1100"
             d:DataContext="{d:DesignInstance Type=viewmodels:TransactionFormViewModel,
                                              IsDesignTimeCreatable=False}">

    <UserControl.Resources>

        <!-- ====================================================== -->
        <!-- CORES DA INTERFACE                                     -->
        <!-- ====================================================== -->

        <SolidColorBrush x:Key="TransactionAccentBrush"
                         Color="#2563EB" />

        <SolidColorBrush x:Key="TransactionMutedBrush"
                         Color="#64748B" />

        <!-- ====================================================== -->
        <!-- SECÇÕES CONDICIONAIS                                   -->
        <!-- ====================================================== -->

        <Style x:Key="OneTimeSectionStyle"
               TargetType="StackPanel">

            <Setter Property="Visibility"
                    Value="Visible" />

            <Style.Triggers>
                <DataTrigger Binding="{Binding IsRecurring}"
                             Value="True">
                    <Setter Property="Visibility"
                            Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>

        </Style>

        <Style x:Key="RecurringSectionStyle"
               TargetType="StackPanel">

            <Setter Property="Visibility"
                    Value="Collapsed" />

            <Style.Triggers>
                <DataTrigger Binding="{Binding IsRecurring}"
                             Value="True">
                    <Setter Property="Visibility"
                            Value="Visible" />
                </DataTrigger>
            </Style.Triggers>

        </Style>

        <Style x:Key="TransactionModeSectionStyle"
               TargetType="StackPanel">

            <Setter Property="Visibility"
                    Value="Visible" />

            <Style.Triggers>
                <DataTrigger Binding="{Binding IsEditMode}"
                             Value="True">
                    <Setter Property="Visibility"
                            Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>

        </Style>

        <Style x:Key="FinancialPlanSectionStyle"
               TargetType="Border">

            <Setter Property="Visibility"
                    Value="Collapsed" />

            <Style.Triggers>
                <DataTrigger Binding="{Binding HasActiveFinancialPlan}"
                             Value="True">
                    <Setter Property="Visibility"
                            Value="Visible" />
                </DataTrigger>
            </Style.Triggers>

        </Style>

        <!-- ====================================================== -->
        <!-- NOVO: SECÇÃO DO BENEFICIÁRIO                           -->
        <!-- ====================================================== -->

        <Style x:Key="BeneficiarySectionStyle"
               TargetType="StackPanel">

            <Setter Property="Visibility"
                    Value="Collapsed" />

            <Style.Triggers>

                <DataTrigger Binding="{Binding CanSelectBeneficiary}"
                             Value="True">

                    <Setter Property="Visibility"
                            Value="Visible" />

                </DataTrigger>

            </Style.Triggers>

        </Style>

        <!-- ====================================================== -->
        <!-- TÍTULOS E TEXTOS                                       -->
        <!-- ====================================================== -->

        <Style x:Key="TransactionSectionTitleStyle"
               TargetType="TextBlock">

            <Setter Property="FontSize"
                    Value="12" />

            <Setter Property="FontWeight"
                    Value="SemiBold" />

            <Setter Property="Foreground"
                    Value="#64748B" />

            <Setter Property="Margin"
                    Value="0,0,0,16" />

        </Style>

        <Style x:Key="TransactionHelpTextStyle"
               TargetType="TextBlock">

            <Setter Property="FontSize"
                    Value="12" />

            <Setter Property="Foreground"
                    Value="#64748B" />

            <Setter Property="TextWrapping"
                    Value="Wrap" />

            <Setter Property="Margin"
                    Value="0,8,0,0" />

        </Style>

        <!-- ====================================================== -->
        <!-- CARTÃO PONTUAL                                         -->
        <!-- ====================================================== -->

        <Style x:Key="OneTimeCardStyle"
               TargetType="Border">

            <Setter Property="Background"
                    Value="White" />

            <Setter Property="BorderBrush"
                    Value="#CBD5E1" />

            <Setter Property="BorderThickness"
                    Value="1" />

            <Setter Property="CornerRadius"
                    Value="10" />

            <Setter Property="Padding"
                    Value="16" />

            <Style.Triggers>

                <DataTrigger Binding="{Binding IsOneTime}"
                             Value="True">

                    <Setter Property="Background"
                            Value="#EFF6FF" />

                    <Setter Property="BorderBrush"
                            Value="#2563EB" />

                    <Setter Property="BorderThickness"
                            Value="2" />

                </DataTrigger>

            </Style.Triggers>

        </Style>

        <!-- ====================================================== -->
        <!-- CARTÃO RECORRENTE                                      -->
        <!-- ====================================================== -->

        <Style x:Key="RecurringCardStyle"
               TargetType="Border">

            <Setter Property="Background"
                    Value="White" />

            <Setter Property="BorderBrush"
                    Value="#CBD5E1" />

            <Setter Property="BorderThickness"
                    Value="1" />

            <Setter Property="CornerRadius"
                    Value="10" />

            <Setter Property="Padding"
                    Value="16" />

            <Style.Triggers>

                <DataTrigger Binding="{Binding IsRecurring}"
                             Value="True">

                    <Setter Property="Background"
                            Value="#EFF6FF" />

                    <Setter Property="BorderBrush"
                            Value="#2563EB" />

                    <Setter Property="BorderThickness"
                            Value="2" />

                </DataTrigger>

            </Style.Triggers>

        </Style>

        <!-- ====================================================== -->
        <!-- INDICADOR PONTUAL                                      -->
        <!-- ====================================================== -->

        <Style x:Key="OneTimeSelectionIndicatorStyle"
               TargetType="Ellipse">

            <Setter Property="Width"
                    Value="16" />

            <Setter Property="Height"
                    Value="16" />

            <Setter Property="Stroke"
                    Value="#94A3B8" />

            <Setter Property="StrokeThickness"
                    Value="2" />

            <Setter Property="Fill"
                    Value="Transparent" />

            <Style.Triggers>

                <DataTrigger Binding="{Binding IsOneTime}"
                             Value="True">

                    <Setter Property="Stroke"
                            Value="#2563EB" />

                    <Setter Property="Fill"
                            Value="#2563EB" />

                </DataTrigger>

            </Style.Triggers>

        </Style>

        <!-- ====================================================== -->
        <!-- INDICADOR RECORRENTE                                   -->
        <!-- ====================================================== -->

        <Style x:Key="RecurringSelectionIndicatorStyle"
               TargetType="Ellipse">

            <Setter Property="Width"
                    Value="16" />

            <Setter Property="Height"
                    Value="16" />

            <Setter Property="Stroke"
                    Value="#94A3B8" />

            <Setter Property="StrokeThickness"
                    Value="2" />

            <Setter Property="Fill"
                    Value="Transparent" />

            <Style.Triggers>

                <DataTrigger Binding="{Binding IsRecurring}"
                             Value="True">

                    <Setter Property="Stroke"
                            Value="#2563EB" />

                    <Setter Property="Fill"
                            Value="#2563EB" />

                </DataTrigger>

            </Style.Triggers>

        </Style>

        <!-- ====================================================== -->
        <!-- BOTÕES DE SELEÇÃO DO MODO                              -->
        <!-- ====================================================== -->

        <Style x:Key="TransactionModeToggleStyle"
               TargetType="ToggleButton">

            <Setter Property="Background"
                    Value="Transparent" />

            <Setter Property="BorderThickness"
                    Value="0" />

            <Setter Property="HorizontalContentAlignment"
                    Value="Stretch" />

            <Setter Property="VerticalContentAlignment"
                    Value="Center" />

            <Setter Property="Cursor"
                    Value="Hand" />

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="ToggleButton">

                        <ContentPresenter
                            Content="{TemplateBinding Content}"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center" />

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

    </UserControl.Resources>

    <!-- ========================================================== -->
    <!-- CONTEÚDO PRINCIPAL                                         -->
    <!-- ========================================================== -->

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">

        <Grid MaxWidth="1050"
              Margin="32,28,32,40"
              HorizontalAlignment="Center">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ================================================== -->
            <!-- CABEÇALHO                                          -->
            <!-- ================================================== -->

            <StackPanel Grid.Row="0"
                        Margin="0,0,0,24">

                <TextBlock
                    Text="{Binding Title}"
                    Style="{StaticResource TitleStyle}" />

                <TextBlock
                    Text="Regista movimentos realizados ou planeia receitas e despesas futuras."
                    Style="{StaticResource TransactionHelpTextStyle}" />

            </StackPanel>

            <!-- ================================================== -->
            <!-- FORMULÁRIO                                         -->
            <!-- ================================================== -->

            <Border Grid.Row="1"
                    Style="{StaticResource CardBorderStyle}">

                <StackPanel>

                    <!-- ========================================== -->
                    <!-- TIPO DE MOVIMENTO                          -->
                    <!-- ========================================== -->

                    <TextBlock
                        Text="TIPO DE MOVIMENTO"
                        Style="{StaticResource TransactionSectionTitleStyle}" />

                    <ComboBox
                        ItemsSource="{Binding TransactionTypeOptions}"
                        DisplayMemberPath="DisplayName"
                        SelectedValuePath="Value"
                        SelectedValue="{Binding Type,
                                                Mode=TwoWay,
                                                UpdateSourceTrigger=PropertyChanged}"
                        IsEnabled="{Binding CanEditTransactionStructure}"
                        Style="{StaticResource DefaultComboBoxStyle}" />

                    <TextBlock
                        Text="Escolhe entre receita, despesa ou transferência."
                        Style="{StaticResource TransactionHelpTextStyle}" />

                    <Separator Margin="0,24,0,24" />

                    <!-- ========================================== -->
                    <!-- PONTUAL / RECORRENTE                       -->
                    <!-- ========================================== -->

                    <StackPanel
                        Style="{StaticResource TransactionModeSectionStyle}">

                        <TextBlock
                            Text="COMO ACONTECE ESTE MOVIMENTO?"
                            Style="{StaticResource TransactionSectionTitleStyle}" />

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- PONTUAL -->

                            <Border Grid.Column="0"
                                    Style="{StaticResource OneTimeCardStyle}">

                                <ToggleButton
                                    IsChecked="{Binding IsOneTime,
                                                        Mode=TwoWay,
                                                        UpdateSourceTrigger=PropertyChanged}"
                                    IsEnabled="{Binding CanEditTransactionStructure}"
                                    Style="{StaticResource TransactionModeToggleStyle}">

                                    <StackPanel
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">

                                        <Ellipse
                                            Style="{StaticResource OneTimeSelectionIndicatorStyle}"
                                            Margin="0,0,12,0" />

                                        <TextBlock
                                            Text="Pontual"
                                            FontWeight="SemiBold"
                                            VerticalAlignment="Center" />

                                    </StackPanel>

                                </ToggleButton>

                            </Border>

                            <!-- RECORRENTE -->

                            <Border Grid.Column="2"
                                    Style="{StaticResource RecurringCardStyle}">

                                <ToggleButton
                                    IsChecked="{Binding IsRecurring,
                                                        Mode=TwoWay,
                                                        UpdateSourceTrigger=PropertyChanged}"
                                    IsEnabled="{Binding CanEditTransactionStructure}"
                                    Style="{StaticResource TransactionModeToggleStyle}">

                                    <StackPanel
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">

                                        <Ellipse
                                            Style="{StaticResource RecurringSelectionIndicatorStyle}"
                                            Margin="0,0,12,0" />

                                        <TextBlock
                                            Text="Recorrente"
                                            FontWeight="SemiBold"
                                            VerticalAlignment="Center" />

                                    </StackPanel>

                                </ToggleButton>

                            </Border>

                        </Grid>

                        <TextBlock
                            Text="{Binding TransactionModeDescription}"
                            Style="{StaticResource TransactionHelpTextStyle}"
                            Margin="0,12,0,0" />

                        <Separator Margin="0,24,0,24" />

                    </StackPanel>

                    <!-- ========================================== -->
                    <!-- DADOS DO MOVIMENTO                         -->
                    <!-- ========================================== -->

                    <TextBlock
                        Text="DADOS DO MOVIMENTO"
                        Style="{StaticResource TransactionSectionTitleStyle}" />

                    <TextBlock
                        Text="Descrição"
                        Style="{StaticResource FieldTextBlockStyle}" />

                    <TextBox
                        Text="{Binding Description,
                                       Mode=TwoWay,
                                       UpdateSourceTrigger=PropertyChanged,
                                       ValidatesOnNotifyDataErrors=True,
                                       NotifyOnValidationError=True}"
                        Style="{StaticResource ErrorTextBoxStyle}"
                        Margin="0,0,0,18" />

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- VALOR -->

                        <StackPanel Grid.Column="0">

                            <TextBlock
                                Text="Valor"
                                Style="{StaticResource FieldTextBlockStyle}" />

                            <TextBox
                                Text="{Binding Amount,
                                               Mode=TwoWay,
                                               UpdateSourceTrigger=PropertyChanged,
                                               ValidatesOnNotifyDataErrors=True,
                                               NotifyOnValidationError=True}"
                                Style="{StaticResource ErrorTextBoxStyle}" />

                        </StackPanel>

                        <!-- CONTA BANCÁRIA -->

                        <StackPanel Grid.Column="2">

                            <TextBlock
                                Text="Conta bancária"
                                Style="{StaticResource FieldTextBlockStyle}" />

                            <ComboBox
                                ItemsSource="{Binding Accounts}"
                                SelectedItem="{Binding SelectedAccount,
                                                       Mode=TwoWay,
                                                       ValidatesOnNotifyDataErrors=True}"
                                DisplayMemberPath="Name"
                                Style="{StaticResource ErrorComboBoxStyle}" />

                            <TextBlock
                                Text="Opcional com um plano financeiro familiar ativo."
                                Style="{StaticResource TransactionHelpTextStyle}"
                                Visibility="{Binding CanCreateWithoutAccount,
                                                     Converter={StaticResource BoolToVis}}" />

                        </StackPanel>

                    </Grid>

                    <Separator Margin="0,24,0,24" />

                    <!-- ========================================== -->
                    <!-- DATA PONTUAL                               -->
                    <!-- ========================================== -->

                    <StackPanel
                        Style="{StaticResource OneTimeSectionStyle}">

                        <TextBlock
                            Text="DATA DO MOVIMENTO"
                            Style="{StaticResource TransactionSectionTitleStyle}" />

                        <TextBlock
                            Text="Data"
                            Style="{StaticResource FieldTextBlockStyle}" />

                        <DatePicker
                            SelectedDate="{Binding Date,
                                                   Mode=TwoWay,
                                                   UpdateSourceTrigger=PropertyChanged,
                                                   ValidatesOnNotifyDataErrors=True}"
                            IsEnabled="{Binding CanEditTransactionStructure}"
                            Style="{StaticResource ErrorDatePickerStyle}"
                            Language="pt-PT" />

                        <CheckBox
                            Content="Movimento confirmado"
                            IsChecked="{Binding IsConfirmed, Mode=TwoWay}"
                            IsEnabled="{Binding CanEditTransactionStructure}"
                            Margin="0,18,0,0" />

                        <TextBlock
                            Text="Uma previsão futura deve permanecer por confirmar."
                            Style="{StaticResource TransactionHelpTextStyle}" />

                        <Separator Margin="0,24,0,24" />

                    </StackPanel>

                    <!-- ========================================== -->
                    <!-- RECORRÊNCIA                                -->
                    <!-- ========================================== -->

                    <StackPanel
                        Style="{StaticResource RecurringSectionStyle}">

                        <TextBlock
                            Text="CONFIGURAÇÃO DA RECORRÊNCIA"
                            Style="{StaticResource TransactionSectionTitleStyle}" />

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- FREQUÊNCIA -->

                            <StackPanel Grid.Column="0">

                                <TextBlock
                                    Text="Periodicidade"
                                    Style="{StaticResource FieldTextBlockStyle}" />

                                <ComboBox
                                    ItemsSource="{Binding Frequencies}"
                                    SelectedValuePath="Value"
                                    DisplayMemberPath="DisplayName"
                                    SelectedValue="{Binding Frequency,
                                                            Mode=TwoWay,
                                                            UpdateSourceTrigger=PropertyChanged}"
                                    Style="{StaticResource DefaultComboBoxStyle}" />

                            </StackPanel>

                            <!-- DATA DE INÍCIO -->

                            <StackPanel Grid.Column="2">

                                <TextBlock
                                    Text="Data de início"
                                    Style="{StaticResource FieldTextBlockStyle}" />

                                <DatePicker
                                    SelectedDate="{Binding StartDate,
                                                           Mode=TwoWay,
                                                           UpdateSourceTrigger=PropertyChanged,
                                                           ValidatesOnNotifyDataErrors=True}"
                                    Style="{StaticResource ErrorDatePickerStyle}"
                                    Language="pt-PT" />

                            </StackPanel>

                        </Grid>

                        <!-- DATA DE FIM -->

                        <StackPanel Margin="0,18,0,0">

                            <TextBlock
                                Text="Data de fim (opcional)"
                                Style="{StaticResource FieldTextBlockStyle}" />

                            <DatePicker
                                SelectedDate="{Binding EndDate,
                                                       Mode=TwoWay,
                                                       UpdateSourceTrigger=PropertyChanged,
                                                       ValidatesOnNotifyDataErrors=True}"
                                Style="{StaticResource ErrorDatePickerStyle}"
                                Language="pt-PT" />

                        </StackPanel>

                        <!-- ====================================== -->
                        <!-- NOVO: BENEFICIÁRIO DA RECEITA          -->
                        <!-- ====================================== -->

                        <StackPanel
                            Style="{StaticResource BeneficiarySectionStyle}"
                            Margin="0,24,0,0">

                            <Separator Margin="0,0,0,24" />

                            <TextBlock
                                Text="BENEFICIÁRIO DO RENDIMENTO"
                                Style="{StaticResource TransactionSectionTitleStyle}" />

                            <TextBlock
                                Text="Membro da família"
                                Style="{StaticResource FieldTextBlockStyle}" />

                            <ComboBox
                                ItemsSource="{Binding FamilyMembers}"
                                SelectedItem="{Binding SelectedBeneficiary,
                                                       Mode=TwoWay,
                                                       UpdateSourceTrigger=PropertyChanged}"
                                DisplayMemberPath="UserName"
                                Style="{StaticResource DefaultComboBoxStyle}" />

                            <TextBlock
                                Text="Seleciona o membro da família que recebe este rendimento."
                                Style="{StaticResource TransactionHelpTextStyle}" />

                            <!-- INFORMAÇÃO SOBRE A ASSOCIAÇÃO -->

                            <Border
                                Background="#F0FDF4"
                                CornerRadius="8"
                                Padding="14"
                                Margin="0,16,0,0">

                                <StackPanel>

                                    <TextBlock
                                        Text="Rendimento individual"
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Foreground="#166534" />

                                    <TextBlock
                                        Text="Esta receita ficará associada ao membro selecionado e poderá ser apresentada individualmente no Dashboard familiar."
                                        Foreground="#166534"
                                        FontSize="12"
                                        TextWrapping="Wrap"
                                        Margin="0,6,0,0" />

                                </StackPanel>

                            </Border>

                        </StackPanel>

                        <!-- ====================================== -->
                        <!-- INFORMAÇÃO SOBRE A RECORRÊNCIA         -->
                        <!-- ====================================== -->

                        <Border
                            Background="#EFF6FF"
                            CornerRadius="8"
                            Padding="14"
                            Margin="0,18,0,0">

                            <TextBlock
                                Text="Esta regra define movimentos recorrentes previstos. Não confirma automaticamente receitas ou despesas."
                                Foreground="#1E40AF"
                                FontSize="12"
                                TextWrapping="Wrap" />

                        </Border>

                        <Separator Margin="0,24,0,24" />

                    </StackPanel>

                    <!-- ========================================== -->
                    <!-- CLASSIFICAÇÃO                              -->
                    <!-- ========================================== -->

                    <StackPanel
                        Visibility="{Binding UsesCategory,
                                             Converter={StaticResource BoolToVis}}">

                        <TextBlock
                            Text="CLASSIFICAÇÃO"
                            Style="{StaticResource TransactionSectionTitleStyle}" />

                        <TextBlock
                            Text="Categoria"
                            Style="{StaticResource FieldTextBlockStyle}" />

                        <ComboBox
                            ItemsSource="{Binding FilteredCategories}"
                            SelectedItem="{Binding SelectedCategory,
                                                   Mode=TwoWay,
                                                   ValidatesOnNotifyDataErrors=True}"
                            DisplayMemberPath="Name"
                            Style="{StaticResource ErrorComboBoxStyle}" />

                        <TextBlock
                            Text="Apenas são apresentadas categorias compatíveis com o movimento."
                            Style="{StaticResource TransactionHelpTextStyle}" />

                        <!-- DIAGNÓSTICO TEMPORÁRIO -->

                        <Border
                            Background="#F1F5F9"
                            CornerRadius="6"
                            Padding="10"
                            Margin="0,12,0,0">

                            <StackPanel Orientation="Horizontal">

                                <TextBlock
                                    Text="Carregadas: "
                                    Foreground="#475569" />

                                <TextBlock
                                    Text="{Binding Categories.Count}"
                                    FontWeight="Bold" />

                                <TextBlock
                                    Text="   |   Filtradas: "
                                    Foreground="#475569" />

                                <TextBlock
                                    Text="{Binding FilteredCategories.Count}"
                                    FontWeight="Bold" />

                            </StackPanel>

                        </Border>

                        <Separator Margin="0,24,0,24" />

                    </StackPanel>

                    <!-- ========================================== -->
                    <!-- TRANSFERÊNCIA                              -->
                    <!-- ========================================== -->

                    <StackPanel
                        Visibility="{Binding IsTransfer,
                                             Converter={StaticResource BoolToVis}}">

                        <TextBlock
                            Text="CONTA DE DESTINO"
                            Style="{StaticResource TransactionSectionTitleStyle}" />

                        <TextBlock
                            Text="Transferir para"
                            Style="{StaticResource FieldTextBlockStyle}" />

                        <ComboBox
                            ItemsSource="{Binding Accounts}"
                            SelectedItem="{Binding SelectedTargetAccount,
                                                   Mode=TwoWay,
                                                   ValidatesOnNotifyDataErrors=True}"
                            DisplayMemberPath="Name"
                            IsEnabled="{Binding CanEditTransactionStructure}"
                            Style="{StaticResource ErrorComboBoxStyle}" />

                        <Separator Margin="0,24,0,24" />

                    </StackPanel>

                    <!-- ========================================== -->
                    <!-- ASSOCIAÇÕES OPCIONAIS                      -->
                    <!-- ========================================== -->

                    <TextBlock
                        Text="ASSOCIAÇÕES OPCIONAIS"
                        Style="{StaticResource TransactionSectionTitleStyle}" />

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- ORÇAMENTO -->

                        <StackPanel
                            Grid.Column="0"
                            IsEnabled="{Binding CanSelectBudget}">

                            <TextBlock
                                Text="Orçamento"
                                Style="{StaticResource FieldTextBlockStyle}" />

                            <ComboBox
                                ItemsSource="{Binding Budgets}"
                                SelectedItem="{Binding SelectedBudget,
                                                       Mode=TwoWay}"
                                DisplayMemberPath="Name"
                                Style="{StaticResource DefaultComboBoxStyle}" />

                        </StackPanel>

                        <!-- OBJETIVO -->

                        <StackPanel
                            Grid.Column="2"
                            IsEnabled="{Binding CanSelectGoal}">

                            <TextBlock
                                Text="Objetivo"
                                Style="{StaticResource FieldTextBlockStyle}" />

                            <ComboBox
                                ItemsSource="{Binding Goals}"
                                SelectedItem="{Binding SelectedGoal,
                                                       Mode=TwoWay}"
                                DisplayMemberPath="Name"
                                Style="{StaticResource DefaultComboBoxStyle}" />

                        </StackPanel>

                    </Grid>

                    <Separator Margin="0,24,0,24" />

                    <!-- ========================================== -->
                    <!-- PLANO FINANCEIRO FAMILIAR                  -->
                    <!-- ========================================== -->

                    <Border
                        Style="{StaticResource FinancialPlanSectionStyle}"
                        Background="#F0FDFA"
                        CornerRadius="8"
                        Padding="16"
                        Margin="0,0,0,22">

                        <StackPanel>

                            <TextBlock
                                Text="PLANO FINANCEIRO FAMILIAR"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="#0F766E" />

                            <TextBlock
                                Text="{Binding FinancialPlanDisplay}"
                                FontWeight="SemiBold"
                                Foreground="#134E4A"
                                Margin="0,8,0,0" />

                            <TextBlock
                                Text="O movimento será associado ao plano financeiro familiar ativo."
                                Foreground="#0F766E"
                                FontSize="12"
                                TextWrapping="Wrap"
                                Margin="0,8,0,0" />

                        </StackPanel>

                    </Border>

                    <!-- ========================================== -->
                    <!-- NOTAS ADICIONAIS                           -->
                    <!-- ========================================== -->

                    <TextBlock
                        Text="NOTAS ADICIONAIS"
                        Style="{StaticResource TransactionSectionTitleStyle}" />

                    <TextBox
                        Text="{Binding Notes,
                                       Mode=TwoWay,
                                       UpdateSourceTrigger=PropertyChanged}"
                        Style="{StaticResource DefaultTextBoxStyle}"
                        AcceptsReturn="True"
                        TextWrapping="Wrap"
                        MinHeight="90"
                        VerticalScrollBarVisibility="Auto" />

                </StackPanel>

            </Border>

            <!-- ================================================== -->
            <!-- AÇÕES                                              -->
            <!-- ================================================== -->

            <Grid Grid.Row="2"
                  Margin="0,24,0,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- PROGRESSO -->

                <ProgressBar
                    Grid.Column="0"
                    IsIndeterminate="True"
                    Width="120"
                    Height="4"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Visibility="{Binding IsBusy,
                                         Converter={StaticResource BoolToVis}}" />

                <!-- CANCELAR -->

                <Button
                    Grid.Column="1"
                    Content="Cancelar"
                    Command="{Binding CancelCommand}"
                    Style="{StaticResource DefaultButton}"
                    Margin="0,0,12,0" />

                <!-- GUARDAR -->

                <Button
                    Grid.Column="2"
                    Content="Guardar"
                    Command="{Binding SaveCommand}"
                    Style="{StaticResource PrimaryButton}"
                    MinWidth="140" />

            </Grid>

        </Grid>

    </ScrollViewer>

</UserControl>