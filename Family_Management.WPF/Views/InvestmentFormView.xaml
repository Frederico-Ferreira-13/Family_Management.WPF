<UserControl x:Class="Family_Management.WPF.Views.InvestmentFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewmodels="clr-namespace:Family_Management.WPF.ViewModel.Investments"
             mc:Ignorable="d"
             d:DesignHeight="700"
             d:DesignWidth="900"
             d:DataContext="{d:DesignInstance Type=viewmodels:InvestmentFormViewModel}">

    <UserControl.Resources>

        <ResourceDictionary>

            <ResourceDictionary.MergedDictionaries>

                <ResourceDictionary Source="/Family_Management.WPF;component/Styles/DesignResources.xaml" />

                <ResourceDictionary Source="/Family_Management.WPF;component/Styles/Styles.ButtonsAndValidation.xaml" />

                <ResourceDictionary Source="/Family_Management.WPF;component/Styles/Styles.TextAndValidation.xaml" />

                <ResourceDictionary Source="/Family_Management.WPF;component/Styles/Styles.InteractiveControls.xaml" />

            </ResourceDictionary.MergedDictionaries>

        </ResourceDictionary>

    </UserControl.Resources>

    <Grid Background="{StaticResource GrayBackground}">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- CABEÇALHO -->

        <StackPanel Grid.Row="0"
                    Margin="30,25,30,20">

            <TextBlock Text="{Binding Title}"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="{StaticResource TextDarkBrush}" />

            <TextBlock Text="Registe um novo investimento e associe-o opcionalmente a uma conta."
                       Foreground="#7F8C8D"
                       Margin="0,5,0,0"
                       TextWrapping="Wrap" />

        </StackPanel>

        <!-- FORMULÁRIO -->

        <Border Grid.Row="1"
                Style="{StaticResource CardBorderStyle}"
                MaxWidth="650"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="30,0,30,30"
                Padding="30">

            <StackPanel>

                <!-- NOME -->

                <TextBlock Text="Nome do Investimento"
                           Style="{StaticResource FieldLabelStyle}" />

                <TextBox Text="{Binding Name,
                                       Mode=TwoWay,
                                       UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource DefaultTextBoxStyle}"
                         MaxLength="100" />

                <TextBlock Text="Introduza um nome que permita identificar facilmente o investimento."
                           Foreground="#7F8C8D"
                           FontSize="11"
                           Margin="2,5,0,0"
                           TextWrapping="Wrap" />

                <!-- TIPO -->

                <TextBlock Text="Tipo de Investimento"
                           Style="{StaticResource FieldLabelStyle}"
                           Margin="0,18,0,5" />

                <ComboBox ItemsSource="{Binding InvestmentTypes}"
                          SelectedItem="{Binding Type,
                                                 Mode=TwoWay}"
                          Style="{StaticResource DefaultComboBoxStyle}" />

                <!-- VALOR INICIAL -->

                <TextBlock Text="Valor Inicial"
                           Style="{StaticResource FieldLabelStyle}"
                           Margin="0,18,0,5" />

                <TextBox Text="{Binding InitialAmount,
                                       Mode=TwoWay,
                                       UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource DefaultTextBoxStyle}" />

                <!-- MOEDA -->

                <TextBlock Text="Moeda"
                           Style="{StaticResource FieldLabelStyle}"
                           Margin="0,18,0,5" />

                <ComboBox ItemsSource="{Binding Currencies}"
                          SelectedItem="{Binding SelectedCurrency,
                                                 Mode=TwoWay}"
                          DisplayMemberPath="Code"
                          Style="{StaticResource DefaultComboBoxStyle}" />

                <!-- CONTA -->

                <TextBlock Text="Conta Associada"
                           Style="{StaticResource FieldLabelStyle}"
                           Margin="0,18,0,5" />

                <ComboBox ItemsSource="{Binding Accounts}"
                          SelectedItem="{Binding SelectedAccount,
                                                 Mode=TwoWay}"
                          DisplayMemberPath="Name"
                          Style="{StaticResource DefaultComboBoxStyle}"
                          IsEditable="False" />

                <TextBlock Text="Opcional. São apresentadas apenas contas ativas com a mesma moeda do investimento."
                           Foreground="#7F8C8D"
                           FontSize="11"
                           Margin="2,5,0,0"
                           TextWrapping="Wrap" />

                <!-- DATA -->

                <TextBlock Text="Data de Compra"
                           Style="{StaticResource FieldLabelStyle}"
                           Margin="0,18,0,5" />

                <DatePicker SelectedDate="{Binding PurchaseDate,
                                                  Mode=TwoWay,
                                                  UpdateSourceTrigger=PropertyChanged}"
                            Style="{StaticResource DefaultDatePickerStyle}" />

                <TextBlock Text="A data de compra não pode estar no futuro."
                           Foreground="#7F8C8D"
                           FontSize="11"
                           Margin="2,5,0,0" />

                <!-- BOTÕES -->

                <Grid Margin="0,25,0,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Content="Cancelar"
                            Command="{Binding CancelCommand}"
                            Style="{StaticResource SecondaryButton}"
                            Padding="15,8" />

                    <Button Grid.Column="2"
                            Content="Criar Investimento"
                            Command="{Binding SaveCommand}"
                            Style="{StaticResource PrimaryButton}"
                            Padding="15,8" />

                </Grid>

            </StackPanel>

        </Border>

    </Grid>

</UserControl>