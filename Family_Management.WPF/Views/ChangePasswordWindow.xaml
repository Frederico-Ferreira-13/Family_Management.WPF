<Window x:Class="Family_Management.WPF.Views.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:Family_Management.WPF.ViewModel.Authentication"
        xmlns:helpers="clr-namespace:Family_Management.WPF.Utilities"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=viewmodels:ChangePasswordViewModel}"
        Title="{Binding Title}"
        Height="430"
        Width="440"
        MinHeight="430"
        MinWidth="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Margin="25">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Título -->
        <TextBlock Grid.Row="0"
                   Text="Alterar Palavra-Passe"
                   Style="{StaticResource TitleStyle}"
                   Margin="0,0,0,20" />

        <!-- Palavra-passe atual -->
        <StackPanel Grid.Row="1"
                    Margin="0,0,0,15">

            <TextBlock Text="Palavra-passe atual:"
                       Style="{StaticResource LabelStyle}"
                       Margin="0,0,0,5" />

            <PasswordBox x:Name="CurrentPasswordBox"
                         helpers:PasswordBoxHelper.Password="{Binding CurrentPassword,
                                                                      Mode=TwoWay,
                                                                      UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource DefaultPasswordBoxStyle}" />

        </StackPanel>

        <!-- Nova palavra-passe -->
        <StackPanel Grid.Row="2"
                    Margin="0,0,0,15">

            <TextBlock Text="Nova palavra-passe:"
                       Style="{StaticResource LabelStyle}"
                       Margin="0,0,0,5" />

            <PasswordBox x:Name="NewPasswordBox"
                         helpers:PasswordBoxHelper.Password="{Binding NewPassword,
                                                                      Mode=TwoWay,
                                                                      UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource DefaultPasswordBoxStyle}" />

            <TextBlock Text="A palavra-passe deve ter pelo menos 8 caracteres."
                       FontSize="11"
                       Margin="2,5,0,0">

                <TextBlock.Style>
                    <Style TargetType="TextBlock">

                        <Setter Property="Foreground"
                                Value="Gray" />

                        <Style.Triggers>

                            <DataTrigger Binding="{Binding NewPassword}"
                                         Value="">
                                <Setter Property="Foreground"
                                        Value="Gray" />
                            </DataTrigger>

                            <DataTrigger Binding="{Binding IsNewPasswordLongEnough}"
                                         Value="True">
                                <Setter Property="Foreground"
                                        Value="{StaticResource SecondaryColorBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>

        <!-- Confirmação -->
        <StackPanel Grid.Row="3">

            <TextBlock Text="Confirmar nova palavra-passe:"
                       Style="{StaticResource LabelStyle}"
                       Margin="0,0,0,5" />

            <PasswordBox x:Name="ConfirmNewPasswordBox"
                         helpers:PasswordBoxHelper.Password="{Binding ConfirmNewPassword,
                                                                      Mode=TwoWay,
                                                                      UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource DefaultPasswordBoxStyle}" />

            <TextBlock Margin="2,5,0,0"
                       FontSize="11">

                <TextBlock.Style>
                    <Style TargetType="TextBlock">

                        <Setter Property="Text"
                                Value="As palavras-passe não coincidem." />

                        <Setter Property="Foreground"
                                Value="{StaticResource DangerColorBrush}" />

                        <Setter Property="Visibility"
                                Value="Visible" />

                        <Style.Triggers>

                            <DataTrigger Binding="{Binding ConfirmNewPassword}"
                                         Value="">
                                <Setter Property="Visibility"
                                        Value="Collapsed" />
                            </DataTrigger>

                            <DataTrigger Binding="{Binding PasswordsMatch}"
                                         Value="True">

                                <Setter Property="Text"
                                        Value="As palavras-passe coincidem." />

                                <Setter Property="Foreground"
                                        Value="{StaticResource SecondaryColorBrush}" />

                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>

        <!-- Ações -->
        <StackPanel Grid.Row="5"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,25,0,0">

            <Button Content="Alterar Palavra-Passe"
                    Command="{Binding ChangePasswordCommand}"
                    Style="{StaticResource PrimaryButton}"
                    Padding="15,5"
                    Margin="0,0,10,0" />

            <Button Content="Cancelar"
                    Command="{Binding CancelCommand}"
                    Style="{StaticResource DefaultButton}"
                    Padding="15,5" />

        </StackPanel>
    </Grid>
</Window>