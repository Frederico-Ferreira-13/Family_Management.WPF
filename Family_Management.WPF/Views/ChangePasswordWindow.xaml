<Window x:Class="Family_Management.WPF.Views.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:Family_Management.WPF.Utilities"
        Title="Alterar palavra-passe"
        Width="540"
        Height="580"
        MinWidth="440"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="CanResize"
        Background="{StaticResource GrayBackground}">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">

        <StackPanel Margin="28">

            <TextBlock Text="Alterar palavra-passe"
                       Style="{StaticResource TitleStyle}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,8" />

            <TextBlock Text="Esta alteração aplica-se ao utilizador com sessão iniciada."
                       Foreground="#666"
                       TextWrapping="Wrap"
                       Margin="0,0,0,24" />

            <TextBlock Text="Palavra-passe atual"
                       Style="{StaticResource FieldTextBlockStyle}" />

            <PasswordBox x:Name="CurrentPasswordBox"
                         helpers:PasswordBoxHelper.Attach="True"
                         helpers:PasswordBoxHelper.Password="{Binding CurrentPassword,
                                                                      Mode=TwoWay,
                                                                      UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource DefaultPasswordBoxStyle}"
                         Height="Auto"
                         MinHeight="42"
                         Padding="10,8"
                         VerticalContentAlignment="Center" />

            <TextBlock Text="Nova palavra-passe"
                       Style="{StaticResource FieldTextBlockStyle}"
                       Margin="0,18,0,5" />

            <PasswordBox x:Name="NewPasswordBox"
                         helpers:PasswordBoxHelper.Attach="True"
                         helpers:PasswordBoxHelper.Password="{Binding NewPassword,
                                                                      Mode=TwoWay,
                                                                      UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource DefaultPasswordBoxStyle}"
                         Height="Auto"
                         MinHeight="42"
                         Padding="10,8"
                         VerticalContentAlignment="Center" />

            <TextBlock Text="Use pelo menos 8 caracteres e uma palavra-passe diferente da atual."
                       Foreground="#666"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Margin="0,6,0,0" />

            <TextBlock Text="Confirmar nova palavra-passe"
                       Style="{StaticResource FieldTextBlockStyle}"
                       Margin="0,18,0,5" />

            <PasswordBox x:Name="ConfirmNewPasswordBox"
                         helpers:PasswordBoxHelper.Attach="True"
                         helpers:PasswordBoxHelper.Password="{Binding ConfirmNewPassword,
                                                                      Mode=TwoWay,
                                                                      UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource DefaultPasswordBoxStyle}"
                         Height="Auto"
                         MinHeight="42"
                         Padding="10,8"
                         VerticalContentAlignment="Center" />

            <TextBlock Text="As palavras-passe não coincidem."
                       FontSize="12"
                       TextWrapping="Wrap"
                       Margin="0,6,0,0">

                <TextBlock.Style>
                    <Style TargetType="TextBlock">

                        <Setter Property="Foreground"
                                Value="{StaticResource DangerColorBrush}" />

                        <Setter Property="Visibility"
                                Value="Visible" />

                        <Style.Triggers>

                            <DataTrigger Binding="{Binding ConfirmNewPassword}"
                                         Value="">
                                <Setter Property="Visibility"
                                        Value="Collapsed" />
                            </DataTrigger>

                            <DataTrigger Binding="{Binding PasswordsMatch}"
                                         Value="True">
                                <Setter Property="Visibility"
                                        Value="Collapsed" />
                            </DataTrigger>

                        </Style.Triggers>

                    </Style>
                </TextBlock.Style>

            </TextBlock>

            <WrapPanel HorizontalAlignment="Right"
                       Margin="0,28,0,0">

                <Button Content="Cancelar"
                        Command="{Binding CancelCommand}"
                        Style="{StaticResource SecondaryButton}"
                        Margin="0,0,10,8" />

                <Button Content="Guardar palavra-passe"
                        Command="{Binding ChangePasswordCommand}"
                        Style="{StaticResource PrimaryButton}"
                        Margin="0,0,0,8" />

            </WrapPanel>

        </StackPanel>

    </ScrollViewer>

</Window>