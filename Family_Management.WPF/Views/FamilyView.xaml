<UserControl x:Class="Family_Management.WPF.Views.FamilyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewmodels="clr-namespace:Family_Management.WPF.ViewModel.Families"
             mc:Ignorable="d"
             d:DesignHeight="700"
             d:DesignWidth="1100"
             d:DataContext="{d:DesignInstance Type=viewmodels:FamilyViewModel}">

    <UserControl.Resources>

        <ResourceDictionary>

            <ResourceDictionary.MergedDictionaries>

                <ResourceDictionary Source="/Family_Management.WPF;component/Styles/DesignResources.xaml" />

                <ResourceDictionary Source="/Family_Management.WPF;component/Styles/Styles.ButtonsAndValidation.xaml" />

                <ResourceDictionary Source="/Family_Management.WPF;component/Styles/Styles.TextAndValidation.xaml" />

                <ResourceDictionary Source="/Family_Management.WPF;component/Styles/Styles.InteractiveControls.xaml" />

                <ResourceDictionary Source="/Family_Management.WPF;component/Styles/converters.xaml" />

            </ResourceDictionary.MergedDictionaries>

        </ResourceDictionary>

    </UserControl.Resources>

    <Grid Background="{StaticResource GrayBackground}">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto" />

            <RowDefinition Height="*" />

        </Grid.RowDefinitions>

        <!-- CABEÇALHO -->

        <Grid Grid.Row="0"
              Margin="30,25,30,20">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="*" />

                <ColumnDefinition Width="Auto" />

            </Grid.ColumnDefinitions>

            <StackPanel>

                <TextBlock Text="{Binding Title}"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextDarkBrush}" />

                <TextBlock Text="Crie e administre famílias, membros e códigos de convite."
                           Foreground="#7F8C8D"
                           Margin="0,5,0,0" />

            </StackPanel>

            <Button Grid.Column="1"
                    Content="Nova Família"
                    Command="{Binding NewFamilyCommand}"
                    Style="{StaticResource PrimaryButton}"
                    VerticalAlignment="Center"
                    Padding="18,8" />

        </Grid>

        <!-- CONTEÚDO -->

        <Grid Grid.Row="1"
              Margin="30,0,30,30">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="1.1*" />

                <ColumnDefinition Width="20" />

                <ColumnDefinition Width="1.4*" />

            </Grid.ColumnDefinitions>

            <!-- LISTA DE FAMÍLIAS -->

            <Border Grid.Column="0"
                    Style="{StaticResource CardBorderStyle}"
                    Padding="20">

                <DockPanel>

                    <TextBlock DockPanel.Dock="Top"
                               Text="Famílias"
                               Style="{StaticResource TitleStyle}"
                               Margin="0,0,0,15" />

                    <DataGrid ItemsSource="{Binding Families}"
                              SelectedItem="{Binding SelectedFamily,
                                                     Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              Style="{StaticResource CustomDataGridStyle}">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="Nome"
                                                Binding="{Binding Name}"
                                                Width="*" />

                            <DataGridTextColumn Header="Membros"
                                                Binding="{Binding MemberCount}"
                                                Width="80" />

                            <DataGridTextColumn Header="Estado"
                                                Binding="{Binding IsActive,
                                                                  Converter={StaticResource BoolToText},
                                                                  ConverterParameter='Ativa|Inativa'}"
                                                Width="90" />

                        </DataGrid.Columns>

                    </DataGrid>

                </DockPanel>

            </Border>

            <!-- DETALHES / FORMULÁRIO -->

            <Border Grid.Column="2"
                    Style="{StaticResource CardBorderStyle}"
                    Padding="25">

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">

                    <StackPanel>

                        <TextBlock Text="{Binding FormTitle}"
                                   Style="{StaticResource TitleStyle}"
                                   Foreground="{StaticResource PrimaryColorBrush}"
                                   Margin="0,0,0,20" />

                        <!-- CRIAÇÃO -->

                        <StackPanel Visibility="{Binding HasSelectedFamily,
                                                        Converter={StaticResource InverseBoolToVis}}">

                            <TextBlock Text="Nome da Família"
                                       Style="{StaticResource FieldLabelStyle}" />

                            <TextBox Text="{Binding NewFamilyName,
                                                   Mode=TwoWay,
                                                   UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource DefaultTextBoxStyle}"
                                     MaxLength="100" />

                            <TextBlock Text="O nome deve ter pelo menos 3 caracteres."
                                       Foreground="#7F8C8D"
                                       FontSize="11"
                                       Margin="2,5,0,0" />

                            <Button Content="Criar Família"
                                    Command="{Binding AddFamilyCommand}"
                                    Style="{StaticResource PrimaryButton}"
                                    Margin="0,15,0,0"
                                    HorizontalAlignment="Stretch" />

                        </StackPanel>

                        <!-- EDIÇÃO -->

                        <StackPanel Visibility="{Binding HasSelectedFamily,
                                                        Converter={StaticResource BoolToVis}}">

                            <TextBlock Text="Nome da Família"
                                       Style="{StaticResource FieldLabelStyle}" />

                            <TextBox Text="{Binding EditFamilyName,
                                                   Mode=TwoWay,
                                                   UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource DefaultTextBoxStyle}"
                                     MaxLength="100" />

                            <Button Content="Atualizar Nome"
                                    Command="{Binding UpdateFamilyCommand}"
                                    Style="{StaticResource PrimaryButton}"
                                    Margin="0,15,0,0"
                                    HorizontalAlignment="Stretch" />

                            <!-- INFORMAÇÃO DA FAMÍLIA -->

                            <Separator Margin="0,25,0,20" />

                            <TextBlock Text="Informação"
                                       Style="{StaticResource TitleStyle}"
                                       Margin="0,0,0,12" />

                            <Grid>

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="Auto" />

                                    <ColumnDefinition Width="*" />

                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>

                                    <RowDefinition Height="Auto" />

                                    <RowDefinition Height="Auto" />

                                    <RowDefinition Height="Auto" />

                                    <RowDefinition Height="Auto" />

                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                                           Text="Criador:"
                                           FontWeight="SemiBold"
                                           Margin="0,3,15,3" />

                                <TextBlock Grid.Row="0"
                                           Grid.Column="1"
                                           Text="{Binding SelectedFamily.CreatorUserName,
                                                          TargetNullValue='—'}"
                                           Margin="0,3" />

                                <TextBlock Grid.Row="1"
                                           Text="Membros:"
                                           FontWeight="SemiBold"
                                           Margin="0,3,15,3" />

                                <TextBlock Grid.Row="1"
                                           Grid.Column="1"
                                           Text="{Binding SelectedFamily.MemberCount}"
                                           Margin="0,3" />

                                <TextBlock Grid.Row="2"
                                           Text="Estado:"
                                           FontWeight="SemiBold"
                                           Margin="0,3,15,3" />

                                <TextBlock Grid.Row="2"
                                           Grid.Column="1"
                                           Text="{Binding SelectedFamily.IsActive,
                                                          Converter={StaticResource BoolToText},
                                                          ConverterParameter='Ativa|Inativa'}"
                                           Margin="0,3" />

                                <TextBlock Grid.Row="3"
                                           Text="Criada em:"
                                           FontWeight="SemiBold"
                                           Margin="0,3,15,3" />

                                <TextBlock Grid.Row="3"
                                           Grid.Column="1"
                                           Text="{Binding SelectedFamily.CreatedAt,
                                                          StringFormat={}{0:dd/MM/yyyy}}"
                                           Margin="0,3" />

                            </Grid>

                            <!-- CÓDIGO DE CONVITE -->

                            <Separator Margin="0,20" />

                            <TextBlock Text="Código de Convite"
                                       Style="{StaticResource TitleStyle}"
                                       Margin="0,0,0,8" />

                            <TextBlock Text="Partilhe este código apenas com pessoas que pretende adicionar à família."
                                       Foreground="#7F8C8D"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,10" />

                            <Border Background="#F5F7F8"
                                    BorderBrush="{StaticResource BorderLightBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="12">

                                <TextBlock Text="{Binding SelectedFamily.InvitationCode}"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           Foreground="{StaticResource PrimaryColorBrush}" />

                            </Border>

                            <Button Content="Gerar Novo Código"
                                    Command="{Binding RegenerateInvitationCodeCommand}"
                                    Style="{StaticResource SecondaryButton}"
                                    Margin="0,10,0,0"
                                    HorizontalAlignment="Stretch" />

                            <!-- MEMBROS -->

                            <Separator Margin="0,25,0,20" />

                            <TextBlock Text="Gestão de Membros"
                                       Style="{StaticResource TitleStyle}"
                                       Margin="0,0,0,15" />

                            <TextBlock Text="Adicionar Utilizador"
                                       Style="{StaticResource FieldLabelStyle}" />

                            <ComboBox ItemsSource="{Binding AllAvailableUsers}"
                                      SelectedItem="{Binding SelectedUserToAdd,
                                                             Mode=TwoWay}"
                                      DisplayMemberPath="UserName"
                                      Style="{StaticResource DefaultComboBoxStyle}"
                                      Margin="0,0,0,10" />

                            <Button Content="Adicionar à Família"
                                    Command="{Binding AddUserToFamilyCommand}"
                                    Style="{StaticResource SecondaryButton}"
                                    HorizontalAlignment="Stretch" />

                            <TextBlock Text="Membros Atuais"
                                       Style="{StaticResource FieldLabelStyle}"
                                       Margin="0,20,0,8" />

                            <DataGrid ItemsSource="{Binding SelectedFamilyMembers}"
                                      SelectedItem="{Binding SelectedUserToRemove,
                                                             Mode=TwoWay}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      SelectionMode="Single"
                                      SelectionUnit="FullRow"
                                      MinHeight="160"
                                      MaxHeight="260"
                                      Style="{StaticResource CustomDataGridStyle}">

                                <DataGrid.Columns>

                                    <DataGridTextColumn Header="Nome"
                                                        Binding="{Binding UserName}"
                                                        Width="*" />

                                    <DataGridTextColumn Header="Email"
                                                        Binding="{Binding Email}"
                                                        Width="1.3*" />

                                    <DataGridTextColumn Header="Perfil"
                                                        Binding="{Binding IsAdmin,
                                                                          Converter={StaticResource BoolToText},
                                                                          ConverterParameter='Admin|Membro'}"
                                                        Width="90" />

                                    <DataGridTextColumn Header="Estado"
                                                        Binding="{Binding IsActive,
                                                                          Converter={StaticResource BoolToText},
                                                                          ConverterParameter='Ativo|Inativo'}"
                                                        Width="80" />

                                </DataGrid.Columns>

                            </DataGrid>

                            <Button Content="Remover Membro Selecionado"
                                    Command="{Binding RemoveUserFromFamilyCommand}"
                                    Style="{StaticResource DangerButton}"
                                    Margin="0,10,0,0"
                                    HorizontalAlignment="Stretch" />

                            <!-- ZONA DE PERIGO -->

                            <Separator Margin="0,30,0,20" />

                            <Border Background="#FFF5F5"
                                    BorderBrush="{StaticResource DangerColorBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="15">

                                <StackPanel>

                                    <TextBlock Text="Zona de Perigo"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource DangerColorBrush}"
                                               FontSize="15" />

                                    <TextBlock Text="Ao desativar a família, todos os membros serão removidos da mesma."
                                               TextWrapping="Wrap"
                                               Foreground="#7F8C8D"
                                               Margin="0,5,0,12" />

                                    <Button Content="Desativar Família"
                                            Command="{Binding DeactivateFamilyCommand}"
                                            Style="{StaticResource DangerButton}"
                                            HorizontalAlignment="Stretch" />

                                </StackPanel>

                            </Border>

                        </StackPanel>

                    </StackPanel>

                </ScrollViewer>

            </Border>

        </Grid>

    </Grid>

</UserControl>