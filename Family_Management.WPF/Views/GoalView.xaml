<UserControl x:Class="Family_Management.WPF.Views.GoalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewmodels="clr-namespace:Family_Management.WPF.ViewModel.Goals"
             mc:Ignorable="d"
             d:DesignHeight="750"
             d:DesignWidth="1200"
             d:DataContext="{d:DesignInstance Type=viewmodels:GoalViewModel}">

    <UserControl.Resources>

        <ResourceDictionary>

            <ResourceDictionary.MergedDictionaries>

                <ResourceDictionary Source="/Family_Management.WPF;component/Styles/DesignResources.xaml" />

                <ResourceDictionary Source="/Family_Management.WPF;component/Styles/Styles.ButtonsAndValidation.xaml" />

                <ResourceDictionary Source="/Family_Management.WPF;component/Styles/Styles.TextAndValidation.xaml" />

                <ResourceDictionary Source="/Family_Management.WPF;component/Styles/Styles.InteractiveControls.xaml" />

                <ResourceDictionary Source="/Family_Management.WPF;component/Styles/converters.xaml" />

            </ResourceDictionary.MergedDictionaries>

        </ResourceDictionary>

    </UserControl.Resources>

    <Grid Background="{StaticResource GrayBackground}">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- CABEÇALHO -->

        <Grid Grid.Row="0"
              Margin="30,25,30,20">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>

                <TextBlock Text="{Binding Title}"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextDarkBrush}" />

                <TextBlock Text="Defina objetivos financeiros e acompanhe o progresso das suas poupanças."
                           Foreground="#7F8C8D"
                           Margin="0,5,0,0" />

            </StackPanel>

            <Button Grid.Column="1"
                    Content="Nova Meta"
                    Command="{Binding NewGoalCommand}"
                    Style="{StaticResource PrimaryButton}"
                    VerticalAlignment="Center"
                    Padding="18,8" />

        </Grid>

        <!-- CONTEÚDO -->

        <Grid Grid.Row="1"
              Margin="30,0,30,30">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.6*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <!-- LISTA DE METAS -->

            <Border Grid.Column="0"
                    Style="{StaticResource CardBorderStyle}"
                    Padding="20">

                <DockPanel>

                    <TextBlock DockPanel.Dock="Top"
                               Text="Metas Ativas"
                               Style="{StaticResource TitleStyle}"
                               Margin="0,0,0,15" />

                    <DataGrid ItemsSource="{Binding Goals}"
                              SelectedItem="{Binding SelectedGoal,
                                                     Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              Style="{StaticResource CustomDataGridStyle}">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="Nome"
                                                Binding="{Binding Name}"
                                                Width="*" />

                            <DataGridTextColumn Header="Alvo"
                                                Binding="{Binding TargetAmount,
                                                                  StringFormat={}{0:N2}}"
                                                Width="90" />

                            <DataGridTextColumn Header="Atual"
                                                Binding="{Binding CurrentAmount,
                                                                  StringFormat={}{0:N2}}"
                                                Width="90" />

                            <DataGridTextColumn Header="Moeda"
                                                Binding="{Binding Currency}"
                                                Width="65" />

                            <DataGridTemplateColumn Header="Progresso"
                                                    Width="150">

                                <DataGridTemplateColumn.CellTemplate>

                                    <DataTemplate>

                                        <Grid Margin="5">

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="45" />
                                            </Grid.ColumnDefinitions>

                                            <ProgressBar Value="{Binding ProgressPercentage}"
                                                         Minimum="0"
                                                         Maximum="100"
                                                         Height="14"
                                                         VerticalAlignment="Center"
                                                         Background="#EAECEE"
                                                         Foreground="{StaticResource SecondaryColorBrush}" />

                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding ProgressPercentage,
                                                                      StringFormat={}{0:F0}%}"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Center"
                                                       FontSize="11" />

                                        </Grid>

                                    </DataTemplate>

                                </DataGridTemplateColumn.CellTemplate>

                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Data Alvo"
                                                Binding="{Binding TargetDate,
                                                                  StringFormat={}{0:dd/MM/yyyy}}"
                                                Width="95" />

                        </DataGrid.Columns>

                    </DataGrid>

                </DockPanel>

            </Border>

            <!-- FORMULÁRIO / DETALHES -->

            <Border Grid.Column="2"
                    Style="{StaticResource CardBorderStyle}"
                    Padding="25">

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">

                    <StackPanel>

                        <TextBlock Text="{Binding FormTitle}"
                                   Style="{StaticResource TitleStyle}"
                                   Foreground="{StaticResource PrimaryColorBrush}"
                                   Margin="0,0,0,20" />

                        <!-- NOME -->

                        <TextBlock Text="Nome da Meta"
                                   Style="{StaticResource FieldLabelStyle}" />

                        <TextBox Text="{Binding GoalForm.GoalName,
                                               Mode=TwoWay,
                                               UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource DefaultTextBoxStyle}"
                                 MaxLength="100" />

                        <!-- VALOR -->

                        <TextBlock Text="Valor Alvo"
                                   Style="{StaticResource FieldLabelStyle}"
                                   Margin="0,15,0,5" />

                        <TextBox Text="{Binding GoalForm.GoalTargetAmount,
                                               Mode=TwoWay,
                                               UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource DefaultTextBoxStyle}" />

                        <!-- DATA -->

                        <TextBlock Text="Data Alvo"
                                   Style="{StaticResource FieldLabelStyle}"
                                   Margin="0,15,0,5" />

                        <DatePicker SelectedDate="{Binding GoalForm.GoalTargetDate,
                                                          Mode=TwoWay,
                                                          UpdateSourceTrigger=PropertyChanged}"
                                    Style="{StaticResource DefaultDatePickerStyle}" />

                        <TextBlock Text="Opcional. A data alvo não pode estar no passado."
                                   Foreground="#7F8C8D"
                                   FontSize="11"
                                   Margin="2,5,0,0" />

                        <!-- MOEDA -->

                        <TextBlock Text="Moeda"
                                   Style="{StaticResource FieldLabelStyle}"
                                   Margin="0,15,0,5" />

                        <ComboBox ItemsSource="{Binding GoalForm.Currencies}"
                                  SelectedItem="{Binding GoalForm.GoalSelectedCurrency,
                                                         Mode=TwoWay}"
                                  DisplayMemberPath="Code"
                                  IsEnabled="{Binding GoalForm.CanChangeCurrency}"
                                  Style="{StaticResource DefaultComboBoxStyle}" />

                        <TextBlock Text="A moeda não pode ser alterada depois de a meta ser criada."
                                   Foreground="#7F8C8D"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Margin="2,5,0,0" />

                        <!-- GUARDAR -->

                        <Button Content="{Binding GoalForm.SaveButtonText}"
                                Command="{Binding GoalForm.SaveGoalCommand}"
                                Style="{StaticResource PrimaryButton}"
                                HorizontalAlignment="Stretch"
                                Margin="0,20,0,0"
                                Padding="15,8" />

                        <!-- DETALHES DA META -->

                        <StackPanel Visibility="{Binding CanEditOrAddProgress,
                                                        Converter={StaticResource BoolToVis}}">

                            <Separator Margin="0,25,0,20" />

                            <TextBlock Text="Resumo da Meta"
                                       Style="{StaticResource TitleStyle}"
                                       Margin="0,0,0,12" />

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                                           Text="Poupado:"
                                           FontWeight="SemiBold"
                                           Margin="0,3,15,3" />

                                <TextBlock Grid.Row="0"
                                           Grid.Column="1"
                                           Margin="0,3">

                                    <Run Text="{Binding SelectedGoal.CurrentAmount,
                                                        StringFormat={}{0:N2}}" />

                                    <Run Text=" " />

                                    <Run Text="{Binding SelectedGoal.Currency}" />

                                </TextBlock>

                                <TextBlock Grid.Row="1"
                                           Text="Em falta:"
                                           FontWeight="SemiBold"
                                           Margin="0,3,15,3" />

                                <TextBlock Grid.Row="1"
                                           Grid.Column="1"
                                           Margin="0,3">

                                    <Run Text="{Binding SelectedGoal.RemainingAmount,
                                                        StringFormat={}{0:N2}}" />

                                    <Run Text=" " />

                                    <Run Text="{Binding SelectedGoal.Currency}" />

                                </TextBlock>

                                <TextBlock Grid.Row="2"
                                           Text="Progresso:"
                                           FontWeight="SemiBold"
                                           Margin="0,3,15,3" />

                                <TextBlock Grid.Row="2"
                                           Grid.Column="1"
                                           Text="{Binding SelectedGoal.ProgressPercentage,
                                                          StringFormat={}{0:F1}%}"
                                           Margin="0,3" />

                                <TextBlock Grid.Row="3"
                                           Text="Início:"
                                           FontWeight="SemiBold"
                                           Margin="0,3,15,3" />

                                <TextBlock Grid.Row="3"
                                           Grid.Column="1"
                                           Text="{Binding SelectedGoal.StartDate,
                                                          StringFormat={}{0:dd/MM/yyyy}}"
                                           Margin="0,3" />

                            </Grid>

                            <!-- PROGRESSO -->

                            <Separator Margin="0,20" />

                            <TextBlock Text="Gerir Progresso"
                                       Style="{StaticResource TitleStyle}"
                                       Margin="0,0,0,10" />

                            <TextBlock Text="Valor"
                                       Style="{StaticResource FieldLabelStyle}" />

                            <TextBox Text="{Binding ProgressAmount,
                                                   Mode=TwoWay,
                                                   UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource DefaultTextBoxStyle}" />

                            <Grid Margin="0,12,0,0">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0"
                                        Content="Adicionar"
                                        Command="{Binding AddProgressCommand}"
                                        Style="{StaticResource SecondaryButton}"
                                        Padding="10,7" />

                                <Button Grid.Column="2"
                                        Content="Retirar"
                                        Command="{Binding SubtractProgressCommand}"
                                        Style="{StaticResource DangerButton}"
                                        Padding="10,7" />

                            </Grid>

                            <!-- DESATIVAR -->

                            <Separator Margin="0,25,0,20" />

                            <Border Background="#FFF5F5"
                                    BorderBrush="{StaticResource DangerColorBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="15">

                                <StackPanel>

                                    <TextBlock Text="Zona de Perigo"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource DangerColorBrush}" />

                                    <TextBlock Text="A meta deixará de aparecer na lista de metas ativas."
                                               Foreground="#7F8C8D"
                                               TextWrapping="Wrap"
                                               Margin="0,5,0,12" />

                                    <Button Content="Desativar Meta"
                                            Command="{Binding DeleteGoalCommand}"
                                            Style="{StaticResource DangerButton}"
                                            HorizontalAlignment="Stretch" />

                                </StackPanel>

                            </Border>

                        </StackPanel>

                    </StackPanel>

                </ScrollViewer>

            </Border>

        </Grid>

    </Grid>

</UserControl>