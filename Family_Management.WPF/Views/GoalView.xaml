<UserControl x:Class="Family_Management.WPF.Views.GoalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewmodels="clr-namespace:Family_Management.WPF.ViewModel.Goals"
             mc:Ignorable="d"
             d:DesignHeight="750"
             d:DesignWidth="1200"
             d:DataContext="{d:DesignInstance Type=viewmodels:GoalViewModel}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Family_Management.WPF;component/Styles/DesignResources.xaml" />
                <ResourceDictionary Source="/Family_Management.WPF;component/Styles/Styles.ButtonsAndValidation.xaml" />
                <ResourceDictionary Source="/Family_Management.WPF;component/Styles/Styles.TextAndValidation.xaml" />
                <ResourceDictionary Source="/Family_Management.WPF;component/Styles/Styles.InteractiveControls.xaml" />
                <ResourceDictionary Source="/Family_Management.WPF;component/Styles/converters.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{StaticResource GrayBackground}">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- CABEÇALHO -->

        <Grid Grid.Row="0"
              Margin="30,25,30,20">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="{Binding Title}"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextDarkBrush}" />

                <TextBlock Text="Defina objetivos financeiros e acompanhe o progresso das suas poupanças."
                           Foreground="#7F8C8D"
                           TextWrapping="Wrap"
                           Margin="0,5,15,0" />
            </StackPanel>

            <Button Grid.Column="1"
                    Content="Novo objetivo"
                    Command="{Binding NewGoalCommand}"
                    Style="{StaticResource PrimaryButton}"
                    VerticalAlignment="Center"
                    Padding="18,8" />

        </Grid>

        <!-- CONTEÚDO -->

        <Grid Grid.Row="1"
              Margin="30,0,30,30">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.6*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <!-- LISTA DE OBJETIVOS -->

            <Border Grid.Column="0"
                    Style="{StaticResource CardBorderStyle}"
                    Padding="20">

                <DockPanel>

                    <TextBlock DockPanel.Dock="Top"
                               Text="Objetivos ativos"
                               Style="{StaticResource TitleStyle}"
                               Margin="0,0,0,15" />

                    <DataGrid ItemsSource="{Binding Goals}"
                              SelectedItem="{Binding SelectedGoal, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              Style="{StaticResource CustomDataGridStyle}">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="Nome"
                                                Binding="{Binding Name}"
                                                Width="*"
                                                MinWidth="150" />

                            <DataGridTextColumn Header="Alvo"
                                                Binding="{Binding TargetAmountDisplay}"
                                                Width="100" />

                            <DataGridTextColumn Header="Atual"
                                                Binding="{Binding CurrentAmount, StringFormat={}{0:N2}}"
                                                Width="100" />

                            <DataGridTextColumn Header="Moeda"
                                                Binding="{Binding Currency}"
                                                Width="65" />

                            <DataGridTextColumn Header="Progresso"
                                                Binding="{Binding ProgressDisplay}"
                                                Width="150" />

                            <DataGridTextColumn Header="Data alvo"
                                                Binding="{Binding TargetDate, StringFormat={}{0:dd/MM/yyyy}}"
                                                Width="100" />

                        </DataGrid.Columns>

                    </DataGrid>

                </DockPanel>

            </Border>

            <!-- FORMULÁRIO / DETALHES -->

            <Border Grid.Column="2"
                    Style="{StaticResource CardBorderStyle}"
                    Padding="25">

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">

                    <StackPanel>

                        <TextBlock Text="{Binding FormTitle}"
                                   Style="{StaticResource TitleStyle}"
                                   Foreground="{StaticResource PrimaryColorBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,20" />

                        <!-- FORMULÁRIO DOS OBJETIVOS NORMAIS -->

                        <StackPanel Visibility="{Binding CanEditSelectedGoal, Converter={StaticResource BoolToVis}}">

                            <!-- NOME -->

                            <TextBlock Text="Nome do objetivo"
                                       Style="{StaticResource FieldTextBlockStyle}" />

                            <TextBox Text="{Binding GoalForm.GoalName,
                                                    Mode=TwoWay,
                                                    UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource DefaultTextBoxStyle}"
                                     MaxLength="100" />

                            <!-- VALOR -->

                            <TextBlock Text="Valor-alvo"
                                       Style="{StaticResource FieldTextBlockStyle}"
                                       Margin="0,15,0,5" />

                            <TextBox Text="{Binding GoalForm.GoalTargetAmount,
                                                    Mode=TwoWay,
                                                    UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource DefaultTextBoxStyle}" />

                            <!-- DATA -->

                            <TextBlock Text="Data alvo"
                                       Style="{StaticResource FieldTextBlockStyle}"
                                       Margin="0,15,0,5" />

                            <DatePicker SelectedDate="{Binding GoalForm.GoalTargetDate,
                                                               Mode=TwoWay,
                                                               UpdateSourceTrigger=PropertyChanged}"
                                        Style="{StaticResource DefaultDatePickerStyle}"
                                        Language="pt-PT"
                                        SelectedDateFormat="Short"
                                        Height="Auto"
                                        MinHeight="40"
                                        Padding="2" />

                            <TextBlock Text="Opcional. A data alvo não pode estar no passado."
                                       Foreground="#7F8C8D"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Margin="2,5,0,0" />

                            <!-- MOEDA -->

                            <TextBlock Text="Moeda"
                                       Style="{StaticResource FieldTextBlockStyle}"
                                       Margin="0,15,0,5" />

                            <ComboBox ItemsSource="{Binding GoalForm.Currencies}"
                                      SelectedItem="{Binding GoalForm.GoalSelectedCurrency, Mode=TwoWay}"
                                      DisplayMemberPath="Code"
                                      IsEnabled="{Binding GoalForm.CanChangeCurrency}"
                                      Style="{StaticResource DefaultComboBoxStyle}" />

                            <TextBlock Text="A moeda não pode ser alterada depois de o objetivo ser criado."
                                       Foreground="#7F8C8D"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Margin="2,5,0,0" />

                            <!-- GUARDAR -->

                            <Button Content="{Binding GoalForm.SaveButtonText}"
                                    Command="{Binding GoalForm.SaveGoalCommand}"
                                    Style="{StaticResource PrimaryButton}"
                                    HorizontalAlignment="Stretch"
                                    Margin="0,20,0,0"
                                    Padding="15,8" />

                        </StackPanel>

                        <!-- AVISO DO FUNDO DE MANEIO -->

                        <Border Visibility="{Binding SelectedGoal.IsWorkingCapitalFund, Converter={StaticResource BoolToVis}}"
                                Background="#EEF5FC"
                                CornerRadius="6"
                                Padding="15"
                                Margin="0,0,0,10">

                            <TextBlock Text="Este fundo recebe automaticamente 10% das receitas familiares confirmadas. É uma reserva contínua, sem valor-alvo nem data de conclusão. O valor reservado mantém-se na conta bancária."
                                       Foreground="{StaticResource TextDarkBrush}"
                                       TextWrapping="Wrap" />

                        </Border>

                        <!-- DETALHES DO OBJETIVO SELECIONADO -->

                        <StackPanel Visibility="{Binding CanEditOrAddProgress, Converter={StaticResource BoolToVis}}">

                            <Separator Margin="0,25,0,20" />

                            <TextBlock Text="Resumo do objetivo"
                                       Style="{StaticResource TitleStyle}"
                                       Margin="0,0,0,12" />

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                                           Grid.Column="0"
                                           Text="Poupado:"
                                           FontWeight="SemiBold"
                                           Margin="0,3,15,3" />

                                <TextBlock Grid.Row="0"
                                           Grid.Column="1"
                                           Margin="0,3">

                                    <Run Text="{Binding SelectedGoal.CurrentAmount, StringFormat={}{0:N2}}" />
                                    <Run Text=" " />
                                    <Run Text="{Binding SelectedGoal.Currency}" />

                                </TextBlock>

                                <TextBlock Grid.Row="1"
                                           Grid.Column="0"
                                           Text="Em falta:"
                                           FontWeight="SemiBold"
                                           Margin="0,3,15,3" />

                                <TextBlock Grid.Row="1"
                                           Grid.Column="1"
                                           Text="{Binding SelectedGoal.RemainingAmountDisplay}"
                                           TextWrapping="Wrap"
                                           Margin="0,3" />

                                <TextBlock Grid.Row="2"
                                           Grid.Column="0"
                                           Text="Progresso:"
                                           FontWeight="SemiBold"
                                           Margin="0,3,15,3" />

                                <TextBlock Grid.Row="2"
                                           Grid.Column="1"
                                           Text="{Binding SelectedGoal.ProgressDisplay}"
                                           TextWrapping="Wrap"
                                           Margin="0,3" />

                                <TextBlock Grid.Row="3"
                                           Grid.Column="0"
                                           Text="Início:"
                                           FontWeight="SemiBold"
                                           Margin="0,3,15,3" />

                                <TextBlock Grid.Row="3"
                                           Grid.Column="1"
                                           Text="{Binding SelectedGoal.StartDate, StringFormat={}{0:dd/MM/yyyy}}"
                                           Margin="0,3" />

                            </Grid>

                            <!-- GERIR PROGRESSO -->

                            <Separator Margin="0,20" />

                            <TextBlock Text="Gerir progresso"
                                       Style="{StaticResource TitleStyle}"
                                       Margin="0,0,0,10" />

                            <TextBlock Text="Valor"
                                       Style="{StaticResource FieldTextBlockStyle}" />

                            <TextBox Text="{Binding ProgressAmount,
                                                    Mode=TwoWay,
                                                    UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource DefaultTextBoxStyle}" />

                            <Grid Margin="0,12,0,0">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0"
                                        Content="Adicionar"
                                        Command="{Binding AddProgressCommand}"
                                        Style="{StaticResource SecondaryButton}"
                                        Padding="10,7" />

                                <Button Grid.Column="2"
                                        Content="Retirar"
                                        Command="{Binding SubtractProgressCommand}"
                                        Style="{StaticResource DangerButton}"
                                        Padding="10,7" />

                            </Grid>

                            <!-- DESATIVAR APENAS OBJETIVOS NORMAIS -->

                            <StackPanel Visibility="{Binding CanEditSelectedGoal, Converter={StaticResource BoolToVis}}">

                                <Separator Margin="0,25,0,20" />

                                <Border Background="#FFF5F5"
                                        BorderBrush="{StaticResource DangerColorBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="15">

                                    <StackPanel>

                                        <TextBlock Text="Desativar objetivo"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource DangerColorBrush}" />

                                        <TextBlock Text="O objetivo deixará de aparecer na lista de objetivos ativos."
                                                   Foreground="#7F8C8D"
                                                   TextWrapping="Wrap"
                                                   Margin="0,5,0,12" />

                                        <Button Content="Desativar objetivo"
                                                Command="{Binding DeleteGoalCommand}"
                                                Style="{StaticResource DangerButton}"
                                                HorizontalAlignment="Stretch" />

                                    </StackPanel>

                                </Border>

                            </StackPanel>

                        </StackPanel>

                    </StackPanel>

                </ScrollViewer>

            </Border>

        </Grid>

    </Grid>

</UserControl>