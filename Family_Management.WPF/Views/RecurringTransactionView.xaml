<UserControl
    x:Class="Family_Management.WPF.Views.RecurringTransactionView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="clr-namespace:Family_Management.WPF.ViewModel.RecurringTransactions"
    xmlns:moneyControls="clr-namespace:Family_Management.WPF.Controls"
    mc:Ignorable="d"
    d:DesignHeight="800"
    d:DesignWidth="1200"
    d:DataContext="{d:DesignInstance Type=viewmodels:RecurringTransactionViewModel}"
    Background="{StaticResource GrayBackground}">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->

        <Grid Grid.Row="0" Margin="0,0,0,20">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock
                    Text="Movimentos recorrentes"
                    Style="{StaticResource TitleStyle}" />

                <TextBlock
                    Text="Gere salários, rendas, subscrições e outros movimentos periódicos."
                    Foreground="#666"
                    FontSize="13"
                    Margin="0,5,0,0" />
            </StackPanel>

            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal"
                VerticalAlignment="Center">

                <Button
                    Content="Atualizar"
                    Command="{Binding LoadDataCommand}"
                    Style="{StaticResource SecondaryButton}"
                    Margin="0,0,10,0"
                    MinWidth="100"
                    Height="38" />

                <Button
                    Content="Gerar Pendentes"
                    Command="{Binding GenerateTransactionsCommand}"
                    Style="{StaticResource PrimaryButton}"
                    MinWidth="150"
                    Height="38" />
            </StackPanel>
        </Grid>

            <!-- Conteúdo -->

        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="390" MaxWidth="520" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>

            <!-- Criar recorrência -->

            <Border
                Grid.Column="0"
                Style="{StaticResource CardBorderStyle}"
                Padding="20">

                <ScrollViewer
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">

                    <StackPanel>

                        <TextBlock
                            Text="Novo movimento recorrente"
                            FontSize="20"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource TextDarkBrush}"
                            Margin="0,0,0,8" />

                        <TextBlock
                            Text="Configura um rendimento ou uma despesa periódica."
                            Foreground="#777"
                            FontSize="12"
                            TextWrapping="Wrap"
                            Margin="0,0,0,20" />

                        <!-- Estado do plano -->

                        <StackPanel Margin="0,5,0,12">

                            <TextBlock
                                Text="{Binding ActiveFamilyFinancialPlanName}"
                                Foreground="#2563EB"
                                FontWeight="SemiBold"
                                TextWrapping="Wrap" />

                            <TextBlock
                                Text="{Binding FamilyPlanStatus}"
                                TextWrapping="Wrap"
                                Margin="0,8,0,0" />

                            <Button
                                Content="Gerir família e plano"
                                Command="{Binding OpenFamilyCommand}"
                                Style="{StaticResource SecondaryButton}"
                                Margin="0,10,0,0" />
                        </StackPanel>

                        <!-- Âmbito -->

                        <TextBlock
                            Text="Âmbito financeiro"
                            Style="{StaticResource FieldTextBlockStyle}"
                            Margin="0,0,0,5" />

                        <Border
                            Background="#F8FAFC"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12"
                            Margin="0,0,0,12">

                            <StackPanel>

                                <CheckBox
                                    Content="Associar ao plano familiar"
                                    IsChecked="{Binding NewIsFamily, Mode=TwoWay}"
                                    IsEnabled="{Binding CanChooseFamilyScope}"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource TextDarkBrush}" />

                                <TextBlock
                                    Text="Quando desmarcado, o movimento é pessoal."
                                    FontSize="11"
                                    Foreground="#777"
                                    TextWrapping="Wrap"
                                    Margin="0,6,0,0" />

                                <StackPanel
                                    Margin="0,12,0,0"
                                    Visibility="{Binding NewIsFamily,
                                                         Converter={StaticResource BoolToVis}}">

                                    <TextBlock
                                        Text="Plano financeiro ativo"
                                        Style="{StaticResource FieldTextBlockStyle}"
                                        Margin="0,0,0,5" />

                                    <TextBlock
                                        Text="{Binding ActiveFamilyFinancialPlanName}"
                                        FontWeight="SemiBold"
                                        Foreground="#2563EB"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Tipo e categoria -->

                        <TextBlock
                            Text="Tipo de movimento"
                            Style="{StaticResource FieldTextBlockStyle}" />

                        <ComboBox
                            ItemsSource="{Binding TransactionTypes}"
                            SelectedItem="{Binding NewType, Mode=TwoWay}"
                            Style="{StaticResource DefaultComboBoxStyle}" />

                        <TextBlock
                            Text="Categoria"
                            Style="{StaticResource FieldTextBlockStyle}"
                            Margin="0,12,0,5" />

                        <ComboBox
                            ItemsSource="{Binding Categories}"
                            SelectedItem="{Binding NewSelectedCategory,
                                                   Mode=TwoWay,
                                                   ValidatesOnNotifyDataErrors=True,
                                                   NotifyOnValidationError=True}"
                            DisplayMemberPath="Name"
                            Style="{StaticResource ErrorComboBoxStyle}" />

                        <!-- Descrição e valor -->

                        <TextBlock
                            Text="Descrição"
                            Style="{StaticResource FieldTextBlockStyle}"
                            Margin="0,12,0,5" />

                        <TextBox
                            Text="{Binding NewDescription,
                                           Mode=TwoWay,
                                           UpdateSourceTrigger=PropertyChanged,
                                           ValidatesOnNotifyDataErrors=True,
                                           NotifyOnValidationError=True}"
                            Style="{StaticResource ErrorTextBoxStyle}" />

                        <TextBlock
                            Text="Identifica o rendimento ou a despesa, por exemplo: Salário."
                            FontSize="11"
                            Foreground="#777"
                            TextWrapping="Wrap"
                            Margin="0,4,0,0" />

                        <TextBlock
                            Text="Valor"
                            Style="{StaticResource FieldTextBlockStyle}"
                            Margin="0,12,0,5" />

                        <moneyControls:MoneyTextBox
                            Value="{Binding NewAmount,
                                            Mode=TwoWay,
                                            UpdateSourceTrigger=PropertyChanged,
                                            ValidatesOnNotifyDataErrors=True,
                                            NotifyOnValidationError=True}"
                            Style="{StaticResource ErrorTextBoxStyle}"
                            ToolTip="Introduz um valor com até duas casas decimais. Exemplo: 27,50." />

                        <TextBlock
                            Text="Frequência"
                            Style="{StaticResource FieldTextBlockStyle}"
                            Margin="0,12,0,5" />

                        <ComboBox
                            ItemsSource="{Binding Frequencies}"
                            SelectedItem="{Binding NewFrequency, Mode=TwoWay}"
                            Style="{StaticResource DefaultComboBoxStyle}" />

                        <!-- Conta opcional no âmbito familiar -->

                        <TextBlock
                            Text="Conta bancária"
                            Style="{StaticResource FieldTextBlockStyle}"
                            Margin="0,12,0,5" />

                        <ComboBox
                            ItemsSource="{Binding Accounts}"
                            SelectedItem="{Binding NewSelectedAccount,
                                                   Mode=TwoWay,
                                                   ValidatesOnNotifyDataErrors=True,
                                                   NotifyOnValidationError=True}"
                            DisplayMemberPath="Name"
                            Style="{StaticResource ErrorComboBoxStyle}" />

                        <Button
                            Content="Sem conta bancária"
                            Command="{Binding ClearNewAccountCommand}"
                            Visibility="{Binding NewIsFamily,
                                                 Converter={StaticResource BoolToVis}}"
                            Style="{StaticResource SecondaryButton}"
                            Margin="0,6,0,0" />

                        <!-- Beneficiário -->

                        <StackPanel
                            Margin="0,12,0,0"
                            Visibility="{Binding ShowNewBeneficiary,
                                                 Converter={StaticResource BoolToVis}}">

                            <TextBlock
                                Text="Beneficiário"
                                Style="{StaticResource FieldTextBlockStyle}"
                                Margin="0,0,0,5" />

                            <ComboBox
                                ItemsSource="{Binding FamilyMembers}"
                                SelectedItem="{Binding NewSelectedBeneficiary,
                                                       Mode=TwoWay,
                                                       UpdateSourceTrigger=PropertyChanged,
                                                       ValidatesOnNotifyDataErrors=True,
                                                       NotifyOnValidationError=True}"
                                DisplayMemberPath="UserName"
                                Style="{StaticResource ErrorComboBoxStyle}" />

                            <TextBlock
                                Text="Seleciona o membro da família que recebe este rendimento."
                                FontSize="11"
                                Foreground="#777"
                                TextWrapping="Wrap"
                                Margin="0,5,0,0" />
                        </StackPanel>

                        <!-- Datas -->

                        <TextBlock
                            Text="Data de início"
                            Style="{StaticResource FieldTextBlockStyle}"
                            Margin="0,12,0,5" />

                        <DatePicker
                            SelectedDate="{Binding NewStartDate, Mode=TwoWay}"
                            Style="{StaticResource DefaultDatePickerStyle}" />

                        <TextBlock
                            Text="Data de fim (opcional)"
                            Style="{StaticResource FieldTextBlockStyle}"
                            Margin="0,12,0,5" />

                        <DatePicker
                            SelectedDate="{Binding NewEndDate,
                                                   Mode=TwoWay,
                                                   ValidatesOnNotifyDataErrors=True,
                                                   NotifyOnValidationError=True}"
                            Style="{StaticResource ErrorDatePickerStyle}" />

                        <Button
                            Content="Adicionar recorrência"
                            Command="{Binding AddRecurringTransactionCommand}"
                            Style="{StaticResource PrimaryButton}"
                            Height="42"
                            Margin="0,25,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Lista e edição -->

            <Grid Grid.Column="2">

                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="15" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Lista -->

                <Border
                    Grid.Row="0"
                    Style="{StaticResource CardBorderStyle}"
                    Padding="20">

                    <Grid>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,15">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">

                                <TextBlock
                                    Text="Movimentos recorrentes"
                                    FontSize="20"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource TextDarkBrush}" />

                                <TextBlock
                                    Text="Seleciona um movimento para consultar ou editar."
                                    Foreground="#777"
                                    FontSize="12"
                                    Margin="0,4,0,0" />

                                <CheckBox
                                    Content="Mostrar recorrências inativas"
                                    IsChecked="{Binding ShowInactiveRecurringTransactions,
                                                        Mode=TwoWay}"
                                    Margin="0,12,0,0"
                                    VerticalAlignment="Center" />
                            </StackPanel>

                            <TextBlock
                                Grid.Column="1"
                                Text="{Binding RecurringTransactions.Count,
                                               StringFormat='{}{0} registo(s)'}"
                                Foreground="#777"
                                VerticalAlignment="Center" />
                        </Grid>

                        <DataGrid
                            Grid.Row="1"
                            ItemsSource="{Binding RecurringTransactions}"
                            SelectedItem="{Binding SelectedRecurringTransaction,
                                                   Mode=TwoWay}"
                            Style="{StaticResource CustomDataGridStyle}"
                            AutoGenerateColumns="False"
                            IsReadOnly="True"
                            SelectionMode="Single"
                            SelectionUnit="FullRow"
                            HorizontalScrollBarVisibility="Auto">

                            <DataGrid.Columns>

                                <DataGridTextColumn
                                    Header="Âmbito"
                                    Binding="{Binding Scope}"
                                    Width="90" />

                                <DataGridTextColumn
                                    Header="Categoria"
                                    Binding="{Binding CategoryName, TargetNullValue='—'}"
                                    Width="140" />

                                <DataGridTextColumn
                                    Header="Beneficiário"
                                    Binding="{Binding BeneficiaryUserName,
                                                      TargetNullValue='Não atribuído'}"
                                    Width="160" />

                                <DataGridTextColumn
                                    Header="Valor"
                                    Binding="{Binding Amount, StringFormat=N2}"
                                    Width="95" />

                                <DataGridTextColumn
                                    Header="Moeda"
                                    Binding="{Binding Currency}"
                                    Width="65" />

                                <DataGridTextColumn
                                    Header="Tipo"
                                    Binding="{Binding TypeDisplay}"
                                    Width="95" />

                                <DataGridTextColumn
                                    Header="Frequência"
                                    Binding="{Binding FrequencyDisplay}"
                                    Width="110" />

                                <DataGridTextColumn
                                    Header="Próxima"
                                    Binding="{Binding NextDueDate, StringFormat=dd/MM/yyyy}"
                                    Width="105" />

                                <DataGridTextColumn
                                    Header="Conta"
                                    Binding="{Binding AccountName, TargetNullValue='Sem conta'}"
                                    Width="140" />

                                <DataGridTextColumn
                                    Header="Descrição"
                                    Binding="{Binding Description}"
                                    Width="160" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <!-- Edição -->

                <Border
                    Grid.Row="2"
                    Style="{StaticResource CardBorderStyle}"
                    Padding="20"
                    MaxHeight="520">

                    <Grid>

                        <StackPanel
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Margin="20"
                            Visibility="{Binding SelectedRecurringTransaction,
                                                 Converter={StaticResource InverseUniversalVis}}">

                            <TextBlock
                                Text="Nenhuma recorrência selecionada"
                                FontSize="18"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource TextDarkBrush}"
                                HorizontalAlignment="Center" />

                            <TextBlock
                                Text="Seleciona um registo na tabela para consultar ou editar."
                                Foreground="#777"
                                TextAlignment="Center"
                                Margin="0,6,0,0" />
                        </StackPanel>

                        <ScrollViewer
                            VerticalScrollBarVisibility="Auto"
                            HorizontalScrollBarVisibility="Disabled"
                            Visibility="{Binding SelectedRecurringTransaction,
                                                 Converter={StaticResource UniversalVis}}">

                            <StackPanel>

                                <Grid Margin="0,0,0,15">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">

                                        <TextBlock
                                            Text="Editar movimento recorrente"
                                            FontSize="20"
                                            FontWeight="SemiBold"
                                            Foreground="{StaticResource TextDarkBrush}" />

                                        <TextBlock
                                            Text="{Binding SelectedRecurringTransaction.CategoryName}"
                                            Foreground="#777"
                                            FontSize="12"
                                            Margin="0,3,0,0" />
                                    </StackPanel>

                                    <StackPanel
                                        Grid.Column="1"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">

                                        <TextBlock
                                            Text="Ativa"
                                            FontWeight="SemiBold"
                                            Foreground="{StaticResource SecondaryColorBrush}"
                                            Visibility="{Binding IsSelectedRecurringTransactionActive,
                                                                 Converter={StaticResource BoolToVis}}" />

                                        <TextBlock
                                            Text="Inativa"
                                            FontWeight="SemiBold"
                                            Foreground="{StaticResource DangerColorBrush}"
                                            Visibility="{Binding IsSelectedRecurringTransactionInactive,
                                                                 Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                </Grid>

                                <!-- Beneficiário atual -->

                                <StackPanel Margin="0,0,0,15">

                                    <TextBlock
                                        Text="Beneficiário atual"
                                        Style="{StaticResource FieldTextBlockStyle}" />

                                    <TextBlock
                                        Text="{Binding SelectedRecurringTransaction.BeneficiaryUserName,
                                                       TargetNullValue='Não atribuído'}"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource TextDarkBrush}"
                                        Margin="0,5,0,0" />
                                </StackPanel>

                                <!-- Alterar beneficiário familiar -->

                                <StackPanel
                                    Margin="0,0,0,15"
                                    Visibility="{Binding ShowEditBeneficiary,
                                                         Converter={StaticResource BoolToVis}}">

                                    <TextBlock
                                        Text="Alterar beneficiário"
                                        Style="{StaticResource FieldTextBlockStyle}"
                                        Margin="0,0,0,5" />

                                    <ComboBox
                                        ItemsSource="{Binding FamilyMembers}"
                                        SelectedItem="{Binding EditSelectedBeneficiary,
                                                               Mode=TwoWay,
                                                               UpdateSourceTrigger=PropertyChanged,
                                                               ValidatesOnNotifyDataErrors=True,
                                                               NotifyOnValidationError=True}"
                                        DisplayMemberPath="UserName"
                                        Style="{StaticResource ErrorComboBoxStyle}" />

                                    <TextBlock
                                        Text="A alteração será aplicada quando guardares a recorrência."
                                        FontSize="11"
                                        Foreground="#777"
                                        TextWrapping="Wrap"
                                        Margin="0,5,0,0" />
                                </StackPanel>

                                <!-- Associar receita pessoal -->

                                <Border
                                    Background="#EFF6FF"
                                    BorderBrush="#BFDBFE"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="15"
                                    Margin="0,0,0,20"
                                    Visibility="{Binding ShowFamilyAssociation,
                                                         Converter={StaticResource BoolToVis}}">

                                    <StackPanel>

                                        <TextBlock
                                            Text="Associar ao plano financeiro familiar"
                                            FontSize="15"
                                            FontWeight="SemiBold"
                                            Foreground="#1D4ED8"
                                            Margin="0,0,0,8" />

                                        <TextBlock
                                            Text="Esta receita é atualmente pessoal. Podes associá-la ao plano familiar sem alterar a conta bancária."
                                            FontSize="12"
                                            Foreground="#475569"
                                            TextWrapping="Wrap"
                                            Margin="0,0,0,15" />

                                        <TextBlock
                                            Text="Plano financeiro ativo"
                                            Style="{StaticResource FieldTextBlockStyle}"
                                            Margin="0,0,0,5" />

                                        <TextBlock
                                            Text="{Binding ActiveFamilyFinancialPlanName}"
                                            FontWeight="SemiBold"
                                            Foreground="{StaticResource TextDarkBrush}"
                                            Margin="0,0,0,15" />

                                        <TextBlock
                                            Text="Beneficiário da receita"
                                            Style="{StaticResource FieldTextBlockStyle}"
                                            Margin="0,0,0,5" />

                                        <ComboBox
                                            ItemsSource="{Binding FamilyMembers}"
                                            SelectedItem="{Binding SelectedFamilyBeneficiary, Mode=TwoWay}"
                                            DisplayMemberPath="UserName"
                                            Style="{StaticResource DefaultComboBoxStyle}"
                                            Margin="0,0,0,15" />

                                        <Button
                                            Content="Associar ao plano familiar"
                                            Command="{Binding AssociateRecurringTransactionWithFamilyCommand}"
                                            Style="{StaticResource PrimaryButton}"
                                            HorizontalAlignment="Left"
                                            MinWidth="200"
                                            Height="38" />
                                    </StackPanel>
                                </Border>

                                <!-- Campos de edição -->

                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="15" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">

                                        <TextBlock
                                            Text="Categoria"
                                            Style="{StaticResource FieldTextBlockStyle}" />

                                        <ComboBox
                                            ItemsSource="{Binding Categories}"
                                            SelectedItem="{Binding EditSelectedCategory,
                                                                   Mode=TwoWay,
                                                                   ValidatesOnNotifyDataErrors=True,
                                                                   NotifyOnValidationError=True}"
                                            DisplayMemberPath="Name"
                                            Style="{StaticResource ErrorComboBoxStyle}" />

                                        <TextBlock
                                            Text="Descrição"
                                            Style="{StaticResource FieldTextBlockStyle}"
                                            Margin="0,10,0,5" />

                                        <TextBox
                                            Text="{Binding EditDescription,
                                                           Mode=TwoWay,
                                                           UpdateSourceTrigger=PropertyChanged,
                                                           ValidatesOnNotifyDataErrors=True,
                                                           NotifyOnValidationError=True}"
                                            Style="{StaticResource ErrorTextBoxStyle}" />

                                        <TextBlock
                                            Text="Valor"
                                            Style="{StaticResource FieldTextBlockStyle}"
                                            Margin="0,10,0,5" />

                                        <moneyControls:MoneyTextBox
                                            Value="{Binding EditAmount,
                                                            Mode=TwoWay,
                                                            UpdateSourceTrigger=PropertyChanged,
                                                            ValidatesOnNotifyDataErrors=True,
                                                            NotifyOnValidationError=True}"
                                            Style="{StaticResource ErrorTextBoxStyle}"
                                            ToolTip="Introduz um valor com até duas casas decimais. Exemplo: 27,50." />

                                        <TextBlock
                                            Text="Tipo"
                                            Style="{StaticResource FieldTextBlockStyle}"
                                            Margin="0,10,0,5" />

                                        <ComboBox
                                            ItemsSource="{Binding TransactionTypes}"
                                            SelectedItem="{Binding EditType, Mode=TwoWay}"
                                            Style="{StaticResource DefaultComboBoxStyle}" />

                                        <TextBlock
                                            Text="Frequência"
                                            Style="{StaticResource FieldTextBlockStyle}"
                                            Margin="0,10,0,5" />

                                        <ComboBox
                                            ItemsSource="{Binding Frequencies}"
                                            SelectedItem="{Binding EditFrequency, Mode=TwoWay}"
                                            Style="{StaticResource DefaultComboBoxStyle}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">

                                        <TextBlock
                                            Text="Conta bancária"
                                            Style="{StaticResource FieldTextBlockStyle}" />

                                        <ComboBox
                                            ItemsSource="{Binding Accounts}"
                                            SelectedItem="{Binding EditSelectedAccount,
                                                                   Mode=TwoWay,
                                                                   ValidatesOnNotifyDataErrors=True,
                                                                   NotifyOnValidationError=True}"
                                            DisplayMemberPath="Name"
                                            Style="{StaticResource ErrorComboBoxStyle}" />

                                        <Button
                                            Content="Remover conta bancária"
                                            Command="{Binding ClearEditAccountCommand}"
                                            Style="{StaticResource SecondaryButton}"
                                            Margin="0,6,0,0" />

                                        <TextBlock
                                            Text="{Binding EditScheduleDateLabel}"
                                            Style="{StaticResource FieldTextBlockStyle}"
                                            Margin="0,10,0,5" />

                                        <DatePicker
                                            SelectedDate="{Binding EditStartDate,
                                                                Mode=TwoWay,
                                                                UpdateSourceTrigger=PropertyChanged,
                                                                ValidatesOnExceptions=True,
                                                                ValidatesOnNotifyDataErrors=True}"
                                            Style="{StaticResource ErrorDatePickerStyle}"
                                            Language="pt-PT" />

                                        <TextBlock
                                            Text="{Binding EditScheduleDateHelp}"
                                            TextWrapping="Wrap"
                                            FontSize="12"
                                            Opacity="0.75"
                                            Margin="0,5,0,8" />

                                        <TextBlock
                                            Text="Data de fim (opcional)"
                                            Style="{StaticResource FieldTextBlockStyle}"
                                            Margin="0,10,0,5" />

                                        <DatePicker
                                            SelectedDate="{Binding EditEndDate,
                                                                   Mode=TwoWay,
                                                                   ValidatesOnNotifyDataErrors=True,
                                                                   NotifyOnValidationError=True}"
                                            Style="{StaticResource ErrorDatePickerStyle}" />
                                    </StackPanel>
                                </Grid>

                                <!-- Ações -->

                                <Grid Margin="0,20,0,0">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel
                                        Grid.Column="0"
                                        Orientation="Horizontal">

                                        <Button
                                            Content="Desativar"
                                            Command="{Binding DeactivateRecurringTransactionCommand}"
                                            Style="{StaticResource DangerButton}"
                                            MinWidth="100"
                                            Margin="0,0,10,0"
                                            Visibility="{Binding IsSelectedRecurringTransactionActive,
                                                                 Converter={StaticResource BoolToVis}}" />

                                        <Button
                                            Content="Reativar"
                                            Command="{Binding ReactivateRecurringTransactionCommand}"
                                            Style="{StaticResource SecondaryButton}"
                                            MinWidth="100"
                                            Visibility="{Binding IsSelectedRecurringTransactionInactive,
                                                                 Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>

                                    <Button
                                        Grid.Column="1"
                                        Content="Guardar alterações"
                                        Command="{Binding UpdateRecurringTransactionCommand}"
                                        Style="{StaticResource PrimaryButton}"
                                        MinWidth="150"
                                        Height="38" />
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>