<UserControl x:Class="Family_Management.WPF.Views.FamilySetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewmodels="clr-namespace:Family_Management.WPF.ViewModel.Families"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="1000"
             d:DataContext="{d:DesignInstance Type=viewmodels:FamilySetupViewModel}">

    <UserControl.Resources>

        <ResourceDictionary>

            <ResourceDictionary.MergedDictionaries>

                <ResourceDictionary Source="/Family_Management.WPF;component/Styles/DesignResources.xaml" />

                <ResourceDictionary Source="/Family_Management.WPF;component/Styles/Styles.ButtonsAndValidation.xaml" />

                <ResourceDictionary Source="/Family_Management.WPF;component/Styles/Styles.TextAndValidation.xaml" />

                <ResourceDictionary Source="/Family_Management.WPF;component/Styles/Styles.InteractiveControls.xaml" />

            </ResourceDictionary.MergedDictionaries>

        </ResourceDictionary>

    </UserControl.Resources>

    <Grid Background="{StaticResource GrayBackground}">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto" />

            <RowDefinition Height="*" />

        </Grid.RowDefinitions>

        <!-- =====================================================
             CABEÇALHO
             ===================================================== -->

        <StackPanel Grid.Row="0"
                    Margin="30,30,30,10"
                    HorizontalAlignment="Center">

            <TextBlock Text="{Binding Title}"
                       Style="{StaticResource HeaderStyle}"
                       HorizontalAlignment="Center"
                       FontSize="28"
                       FontWeight="Bold" />

            <TextBlock Text="Crie uma nova família ou utilize um código de convite para aderir a uma família existente."
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Foreground="#7F8C8D"
                       FontSize="14"
                       Margin="0,8,0,0"
                       MaxWidth="650" />

        </StackPanel>

        <!-- =====================================================
             CONTEÚDO
             ===================================================== -->

        <Border Grid.Row="1"
                Style="{StaticResource CardBorderStyle}"
                MaxWidth="850"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Padding="35"
                Margin="30">

            <Grid>

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="*" />

                    <ColumnDefinition Width="50" />

                    <ColumnDefinition Width="*" />

                </Grid.ColumnDefinitions>

                <!-- =================================================
                     CRIAR FAMÍLIA
                     ================================================= -->

                <StackPanel Grid.Column="0"
                            VerticalAlignment="Top">

                    <TextBlock Text="Criar Nova Família"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextDarkBrush}"
                               Margin="0,0,0,8" />

                    <TextBlock Text="Crie uma família para gerir contas, movimentos e objetivos em conjunto."
                               Foreground="#7F8C8D"
                               TextWrapping="Wrap"
                               Margin="0,0,0,25" />

                    <TextBlock Text="Nome da Família"
                               Style="{StaticResource FieldLabelStyle}"
                               Margin="0,0,0,5" />

                    <TextBox Text="{Binding NewFamilyName,
                                           Mode=TwoWay,
                                           UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource DefaultTextBoxStyle}"
                             MaxLength="100" />

                    <TextBlock Text="O nome deve ter pelo menos 3 caracteres."
                               Foreground="#7F8C8D"
                               FontSize="11"
                               Margin="2,5,0,0" />

                    <Button Content="Criar Família"
                            Command="{Binding CreateFamilyCommand}"
                            Style="{StaticResource PrimaryButton}"
                            HorizontalAlignment="Stretch"
                            Margin="0,25,0,0"
                            Padding="15,8" />

                </StackPanel>

                <!-- =================================================
                     SEPARADOR
                     ================================================= -->

                <Grid Grid.Column="1">

                    <Rectangle Width="1"
                               Fill="{StaticResource BorderLightBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,5" />

                    <Border Background="White"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Padding="6">

                        <TextBlock Text="OU"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#95A5A6" />

                    </Border>

                </Grid>

                <!-- =================================================
                     ADERIR À FAMÍLIA
                     ================================================= -->

                <StackPanel Grid.Column="2"
                            VerticalAlignment="Top">

                    <TextBlock Text="Aderir a Família Existente"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextDarkBrush}"
                               Margin="0,0,0,8" />

                    <TextBlock Text="Introduza o código de convite fornecido pelo administrador da família."
                               Foreground="#7F8C8D"
                               TextWrapping="Wrap"
                               Margin="0,0,0,25" />

                    <TextBlock Text="Código de Convite"
                               Style="{StaticResource FieldLabelStyle}"
                               Margin="0,0,0,5" />

                    <TextBox Text="{Binding InvitationCode,
                                           Mode=TwoWay,
                                           UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource DefaultTextBoxStyle}"
                             CharacterCasing="Upper" />

                    <TextBlock Text="O código não distingue entre letras maiúsculas e minúsculas."
                               Foreground="#7F8C8D"
                               FontSize="11"
                               Margin="2,5,0,0"
                               TextWrapping="Wrap" />

                    <Button Content="Aderir à Família"
                            Command="{Binding JoinFamilyCommand}"
                            Style="{StaticResource SecondaryButton}"
                            HorizontalAlignment="Stretch"
                            Margin="0,25,0,0"
                            Padding="15,8" />

                </StackPanel>

            </Grid>

        </Border>

    </Grid>

</UserControl>