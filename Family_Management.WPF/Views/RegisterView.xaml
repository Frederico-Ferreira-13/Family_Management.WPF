<UserControl x:Class="Family_Management.WPF.Views.RegisterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewmodels="clr-namespace:Family_Management.WPF.ViewModel.Authentication"
             xmlns:helpers="clr-namespace:Family_Management.WPF.Utilities"
             mc:Ignorable="d"
             d:DesignHeight="700"
             d:DesignWidth="1000"
             d:DataContext="{d:DesignInstance Type=viewmodels:RegisterViewModel}"
             Background="{StaticResource GrayBackground}">

    <Grid Margin="20">

        <Border Background="White"
                CornerRadius="20"
                Padding="40"
                Width="460"
                MaxHeight="680"
                Effect="{StaticResource DropShadowEffect}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">

                <StackPanel>

                    <!-- ========================================= -->
                    <!-- CABEÇALHO                                 -->
                    <!-- ========================================= -->

                    <TextBlock Text="Crie a sua conta"
                               HorizontalAlignment="Center"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextDarkBrush}"
                               Margin="0,0,0,5" />

                    <TextBlock Text="Comece a organizar as suas finanças familiares."
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               FontSize="14"
                               Foreground="#666"
                               Margin="0,0,0,30" />

                    <!-- ========================================= -->
                    <!-- USERNAME                                  -->
                    <!-- ========================================= -->

                    <TextBlock Text="Nome de utilizador"
                               Style="{StaticResource FieldLabelStyle}" />

                    <TextBox Text="{Binding UserName,
                                           Mode=TwoWay,
                                           UpdateSourceTrigger=PropertyChanged,
                                           ValidatesOnDataErrors=True,
                                           NotifyOnValidationError=True}"
                             Style="{StaticResource ErrorTextBoxStyle}" />

                    <!-- ========================================= -->
                    <!-- EMAIL                                     -->
                    <!-- ========================================= -->

                    <TextBlock Text="Email"
                               Style="{StaticResource FieldLabelStyle}"
                               Margin="0,15,0,5" />

                    <TextBox Text="{Binding Email,
                                           Mode=TwoWay,
                                           UpdateSourceTrigger=PropertyChanged,
                                           ValidatesOnDataErrors=True,
                                           NotifyOnValidationError=True}"
                             Style="{StaticResource ErrorTextBoxStyle}" />

                    <!-- ========================================= -->
                    <!-- PASSWORD                                  -->
                    <!-- ========================================= -->

                    <TextBlock Text="Palavra-passe"
                               Style="{StaticResource FieldLabelStyle}"
                               Margin="0,15,0,5" />

                    <PasswordBox helpers:PasswordBoxHelper.Attach="True"
                                 helpers:PasswordBoxHelper.Password="{Binding Password,
                                                                             Mode=TwoWay,
                                                                             UpdateSourceTrigger=PropertyChanged,
                                                                             ValidatesOnDataErrors=True,
                                                                             NotifyOnValidationError=True}"
                                 Style="{StaticResource ErrorPasswordBoxStyle}" />

                    <TextBlock Text="Utilize pelo menos 8 caracteres."
                               FontSize="11"
                               Foreground="#777"
                               Margin="2,5,0,0" />

                    <!-- ========================================= -->
                    <!-- CONFIRM PASSWORD                          -->
                    <!-- ========================================= -->

                    <TextBlock Text="Confirmar palavra-passe"
                               Style="{StaticResource FieldLabelStyle}"
                               Margin="0,15,0,5" />

                    <PasswordBox helpers:PasswordBoxHelper.Attach="True"
                                 helpers:PasswordBoxHelper.Password="{Binding ConfirmPassword,
                                                                             Mode=TwoWay,
                                                                             UpdateSourceTrigger=PropertyChanged,
                                                                             ValidatesOnDataErrors=True,
                                                                             NotifyOnValidationError=True}"
                                 Style="{StaticResource ErrorPasswordBoxStyle}" />

                    <!-- ========================================= -->
                    <!-- BUSY                                      -->
                    <!-- ========================================= -->

                    <ProgressBar IsIndeterminate="True"
                                 Height="4"
                                 Margin="0,20,0,0"
                                 Visibility="{Binding IsBusy,
                                                      Converter={StaticResource BoolToVis}}" />

                    <!-- ========================================= -->
                    <!-- REGISTAR                                  -->
                    <!-- ========================================= -->

                    <Button Content="Criar conta"
                            Command="{Binding RegisterCommand}"
                            Style="{StaticResource PrimaryButton}"
                            Height="42"
                            Margin="0,25,0,0" />

                    <!-- ========================================= -->
                    <!-- VOLTAR                                    -->
                    <!-- ========================================= -->

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Margin="0,20,0,0">

                        <TextBlock Text="Já tem uma conta?"
                                   Foreground="#666"
                                   VerticalAlignment="Center" />

                        <Button Content="Iniciar sessão"
                                Command="{Binding NavigateBackCommand}"
                                Style="{StaticResource HyperlinkLikeButton}"
                                Margin="5,0,0,0" />

                    </StackPanel>

                </StackPanel>

            </ScrollViewer>

        </Border>

    </Grid>

</UserControl>