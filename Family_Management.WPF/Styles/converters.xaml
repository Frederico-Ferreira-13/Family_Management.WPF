<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:Family_Management.WPF.Converters">

    <!-- Boolean -> Visibility -->
    <conv:BooleanToVisibilityConverter
        x:Key="BoolToVis" />

    <conv:BooleanToVisibilityConverter
        x:Key="InverseBoolToVis"
        Invert="True" />

    <!-- Qualquer valor/objeto -> Visibility -->
    <conv:UniversalVisibilityConverter
        x:Key="UniversalVis" />

    <conv:UniversalVisibilityConverter
        x:Key="InverseUniversalVis"
        Invert="True" />

    <!-- Formatação -->
    <conv:CurrencyFormatterConverter
        x:Key="CurrencyConverter" />

    <conv:BoolToTextConverter
        x:Key="BoolToText" />

    <conv:EnumDescriptionConverter
        x:Key="EnumToDesc" />

    <!-- Validação -->
    <conv:DictionaryKeyToValueConverter
        x:Key="DictErrorConverter" />

    <!-- Identificadores / seleção -->
    <conv:IdToBooleanConverter
        x:Key="HasIdConverter" />

    <conv:HasSelectionToBooleanConverter
        x:Key="HasSelectionConverter" />

    <!-- Comparação -->
    <conv:EqualityConverter
        x:Key="EqualityConverter" />

    <!-- Gráficos -->
    <conv:ValueToHeightConverter
        x:Key="ValueToHeight" />

</ResourceDictionary>